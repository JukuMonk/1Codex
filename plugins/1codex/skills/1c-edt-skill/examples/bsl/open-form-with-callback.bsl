// Открыть форму выбора с отбором и принять результат оповещением.
//
// Зачем так: ПараметрыВыбора у поля не доезжают до формы, которую открывает
// ТИПОВОЙ обработчик начала выбора (case 036). Открываем форму сами,
// с явным Отбор и ТекущаяСтрока, и продолжаем в экспортной процедуре.
//
// Принимающая форма (ФормаВыбора) читает Параметры.Отбор в
// ПриСозданииНаСервере — см. dynamic-list-filter.bsl.

&НаКлиенте
Процедура ЭлементНачалоВыбора(Элемент, СтандартнаяОбработка)

	Владелец = Объект.Владелец;
	Если НЕ ЗначениеЗаполнено(Владелец) Тогда
		Возврат; // без отбора пусть работает стандартный выбор
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Отбор", Новый Структура("Владелец", Владелец));
	ПараметрыОткрытия.Вставить("ТекущаяСтрока", Объект.Элемент);
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);

	Оповещение = Новый ОписаниеОповещения("ЭлементВыборЗавершение", ЭтотОбъект,
		Новый Структура("ИмяРеквизита", "Элемент"));

	ОткрытьФорму("Справочник.ПримерСправочник.Форма.ФормаВыбора", ПараметрыОткрытия,
		Элемент,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Продолжение обязано быть экспортным и клиентским: платформа зовёт его
// по имени из описания оповещения.
&НаКлиенте
Процедура ЭлементВыборЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект[ДополнительныеПараметры.ИмяРеквизита] = Результат;
	Модифицированность = Истина;

КонецПроцедуры

// Тот же приём для вопроса пользователю: ответ приходит оповещением,
// код после ПоказатьВопрос выполняется НЕ дожидаясь ответа.
&НаКлиенте
Процедура Очистить(Команда)

	Оповещение = Новый ОписаниеОповещения("ОчиститьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Очистить все строки?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьНаСервере()

	Объект.Точки.Очистить();

КонецПроцедуры
