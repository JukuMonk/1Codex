def дубли_процедур():
    """Процедура / функция с тем же именем дважды в одном модуле — CheckModules «уже определена» только после минутной
    загрузки (ДиЗ-05: СледующийНомерВерсии)."""
    import re
    замечания = []
    for корень, _, имена in os.walk(ВЫГРУЗКА):
        for и in имена:
            if not и.endswith('.bsl'):
                continue
            п = os.path.join(корень, и)
            имена_ = re.findall(r'^\s*(?:Процедура|Функция)\s+(\w+)\s*\(', dl.read(п), re.M | re.I)
            for имя in sorted({н for н in имена_ if имена_.count(н) > 1}):
                замечания.append('%s — процедура «%s» определена %d раза' % (os.path.relpath(п, ВЫГРУЗКА), имя,
                                                                           имена_.count(имя)))
    return замечания


def синтаксис_скриптов():
    """Синтаксис своих Python-скриптов (инструменты, тесты) — генератор с ошибкой иначе срывает загрузку (ДиЗ-05)."""
    замечания = []
    for папка in ('инструменты', 'тесты'):
        for и in sorted(os.listdir(os.path.join(КОРЕНЬ, папка))):
            if и.endswith('.py'):
                путь = os.path.join(КОРЕНЬ, папка, и)
                try:
                    compile(io.open(путь, encoding='utf-8-sig').read(), путь, 'exec')
                except SyntaxError as ошибка:
                    замечания.append('%s/%s — синтаксис Python, строка %s: %s' % (папка, и, ошибка.lineno, ошибка.msg))
    return замечания


def _шаг(итоги, имя, функция):
    import time
    т = time.time()
    код = функция()
    итоги.append((имя, код, time.time() - т))
    print('[%s] %s — %.0f с' % ('ОК' if not код else 'ОШИБКА', имя, итоги[-1][2]), flush=True)
    return код


def _сводка(итоги):
    print('\n=== сводка')
    for имя, код, сек in итоги:
        print('  %-7s %-40s %4.0f с' % ('ОК' if not код else 'ОШИБКА', имя, сек))
    print('  всего %.0f с' % sum(с for _, _, с in итоги))
    return max([к or 0 for _, к, _ in итоги] or [0])


def _запуск(аргументы):
    return subprocess.run([sys.executable] + аргументы, cwd=КОРЕНЬ).returncode


def цикл(тесты=(), обзор=False):
    """Песочница одной командой (ускорение 18.10.2026): линт → загрузить → проверить модули → карта → тесты по
    именам (тест_X — COM, ui_X.py / ui_X.txt — нажатия) → [--обзор: UI-обзор изменённых форм]. Останавливается на
    первой ошибке, в конце — сводка со временем шагов."""
    итоги = []
    if (_шаг(итоги, 'линт', линт) or _шаг(итоги, 'загрузить песочница', lambda: загрузить('песочница'))
            or _шаг(итоги, 'проверить модули', lambda: проверить('песочница'))):
        return _сводка(итоги)
    _шаг(итоги, 'карта конфигурации', lambda: _запуск([os.path.join(КОРЕНЬ, 'инструменты', 'карта.py')]))
    for тест in тесты:
        имя = тест if '.' in тест else None
        кандидаты = [имя] if имя else [тест + '.py', тест + '.txt']
        путь = next((os.path.join(КОРЕНЬ, 'тесты', к) for к in кандидаты if os.path.exists(os.path.join(КОРЕНЬ, 'тесты', к))),
                    None)
        if not путь:
            итоги.append(('тест ' + тест, 1, 0))
            print('[ОШИБКА] нет теста', тест)
            break
        if путь.endswith('.txt'):
            команда = [os.path.join(КОРЕНЬ, 'инструменты', 'тест_ui.py'), путь]
        else:
            команда = [путь]
        if _шаг(итоги, 'тест ' + os.path.basename(путь), lambda: _запуск(команда)):
            break
    if обзор and not any(к for _, к, _ in итоги):
        _шаг(итоги, 'UI-обзор изменённых форм', lambda: _запуск([os.path.join(КОРЕНЬ, 'тесты', 'ui_обзор.py'),
                                                                 '--изменённые']))
    return _сводка(итоги)


def _изменённые_файлы():
    """Файлы конфигурации, изменённые относительно HEAD (и новые): их косметику Конфигуратора принимать можно."""
    git = ['git', '-C', КОРЕНЬ, '-c', 'core.quotepath=off']
    файлы = subprocess.run(git + ['diff', '--name-only', 'HEAD', '--', 'конфигурация'], capture_output=True, text=True,
                           encoding='utf-8').stdout.split()
    файлы += subprocess.run(git + ['ls-files', '--others', '--exclude-standard', '--', 'конфигурация'],
                            capture_output=True, text=True, encoding='utf-8').stdout.split()
    return {os.path.normpath(ф)[len('конфигурация') + 1:] for ф in файлы}


def выпуск():
    """Рабочая база одной командой (ускорение 18.10.2026): закрыть клиентов → резервная копия → загрузить →
    проверить → сверить; расхождения только в своих изменённых файлах (косметика 8.5.1, У-13) — принять и сверить
    снова; в чужих — стоп (кто-то правил базу Конфигуратором). Затем .cf. Коммит — отдельно, со своим сообщением."""
    import contextlib
    import datetime
    итоги = []
    закрыть_клиентов('рабочая')
    резерв = os.path.join(КОРЕНЬ, '.platform', 'резерв')
    os.makedirs(резерв, exist_ok=True)
    копия = os.path.join(резерв, '1Cv8_%s.1CD' % datetime.datetime.now().strftime('%Y%m%d_%H%M'))
    _шаг(итоги, 'резервная копия', lambda: shutil.copy2(os.path.join(БАЗЫ['рабочая'], '1Cv8.1CD'), копия) and 0)
    for старая in sorted(ф for ф in os.listdir(резерв) if ф.startswith('1Cv8_2'))[:-5]:   # хранить 5 последних
        os.remove(os.path.join(резерв, старая))
    if (_шаг(итоги, 'загрузить рабочая', lambda: загрузить('рабочая'))
            or _шаг(итоги, 'проверить модули', lambda: проверить('рабочая'))):
        return _сводка(итоги)
    поток = io.StringIO()
    with contextlib.redirect_stdout(поток):
        код = сверить('рабочая')
    if код:
        различия = {с.split(': ', 1)[1].strip() for с in поток.getvalue().splitlines()
                    if с.startswith(('РАЗЛИЧИЕ: ', 'ТОЛЬКО В '))}
        чужие = sorted(различия - _изменённые_файлы())
        if чужие:
            print(поток.getvalue())
            print('СТОП: расхождения в файлах, которые не менялись в исходнике:', ', '.join(чужие))
            итоги.append(('сверка', 1, 0))
            return _сводка(итоги)
        if _шаг(итоги, 'принять косметику (%d файлов)' % len(различия), lambda: принять_выгрузку('рабочая')):
            return _сводка(итоги)
    else:
        итоги.append(('сверка: 0 расхождений', 0, 0))
    _шаг(итоги, 'поставка .cf', lambda: выгрузить_cf('рабочая'))
    return _сводка(итоги)


