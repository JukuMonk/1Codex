// UP, форма элемента «Сценарии работы» до ДиЗ-07 (8.5.1): повтор реквизита ВНУТРИ версии отбрасывался —
// вторую строку (ТЧ «… ТОР») «находил» шаг, который это же заполнение только что добавило из шапки / ТЧ «… ОР»
&НаСервере
Функция ЗаполнитьИзВерсииНаСервере(Строки = "изменяемые")

	Добавлено = 0;
	Для Каждого Черновик Из МетодологТЗ.ШагиИзВерсииСтруктуры(Объект.ВерсияСтруктуры, Объект.ТипСценария, Строки) Цикл
		Есть = Ложь;
		Для Каждого Шаг Из Объект.Шаги Цикл
			// в пользовательской истории вид пункта зависит от правила (ДиЗ-05 п.4): один пункт на реквизит, ручную
			// правку вида методологом черновик не дублирует; в программной разработке — как прежде, по реквизиту и виду
			Если Шаг.Реквизит = Черновик.Реквизит И (Шаг.ВидПункта = Черновик.ВидПункта
				Или Объект.ТипСценария = Перечисления.ТипыСценариев.ПользовательскаяИстория) Тогда
				Есть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Есть Тогда
			Продолжить;
		КонецЕсли;
		НовыйШаг = Объект.Шаги.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйШаг, Черновик);
		Добавлено = Добавлено + 1;
	КонецЦикла;
	Если Добавлено > 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;
	Возврат Добавлено;

КонецФункции
