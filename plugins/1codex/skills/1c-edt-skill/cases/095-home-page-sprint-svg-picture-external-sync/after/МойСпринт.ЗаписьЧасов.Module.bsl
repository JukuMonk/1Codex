
// «Записать часы» со страницы «Мой спринт»: элемент «Учет времени» — как ручной ввод в форме элемента (без
// ДатаЗагрузкиБ24: обмен с Битрикс24 односторонний и такие записи не трогает). «Моя стадия завершена» — флажок
// «Завершено» записи: по нему форма спринта («Пересчитать») и отчёты считают стадию задачи выполненной.

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Задача = Параметры.Задача;
	Стадия = Параметры.Стадия;
	Исполнитель = Параметры.Исполнитель;
	СтадияЗавершена = Параметры.Завершить;
	Дата = НачалоДня(ТекущаяДатаСеанса());
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Сообщить(НСтр("ru = 'В строке плана спринта нет задачи — часы записать не к чему.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Я = ТекущийИсполнитель();
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Исполнитель = Я;
	КонецЕсли;
	Если Исполнитель <> Я И Не (РольДоступна("Администратор") Или РольДоступна("ДобавлениеВремениЗаДругогоСотрудника")) Тогда
		Сообщить(НСтр("ru = 'Часы за другого сотрудника записывает руководитель (роль «Добавление времени за другого сотрудника»).'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Параметры.Завершить Тогда
		Заголовок = НСтр("ru = 'Завершить стадию'");
		Команды.Записать.Заголовок = НСтр("ru = 'Завершить'");
	Иначе
		Заголовок = НСтр("ru = 'Записать часы'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Записать(Команда)

	Если Часов = 0 И Не СтадияЗавершена Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите, сколько часов.'"), "Часов");
		Возврат;
	КонецЕсли;
	Если Часов > 24 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Больше 24 часов за день — проверьте число.'"), "Часов");
		Возврат;
	КонецЕсли;
	Если Часов > 0 И Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Напишите, что сделано (как в «Учете времени»).'"), "Комментарий");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Дата) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите дату.'"), "Дата");
		Возврат;
	КонецЕсли;
	ЗаписатьНаСервере();
	Закрыть(Истина);

КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаКлиенте
Процедура СообщитьОбОшибке(Текст, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()

	Запись = Справочники.УчетВремени.СоздатьЭлемент();
	Запись.Исполнитель = Исполнитель;
	// за сегодня — текущее время (как форма элемента), за прошлый день — середина дня
	Запись.ДатаСоздания = ?(Дата = НачалоДня(ТекущаяДатаСеанса()), ТекущаяДатаСеанса(), НачалоДня(Дата) + 12 * 3600);
	Запись.Задача = Задача;
	Запись.КодЗадачи = Задача.Код;
	Запись.Часов = Часов;
	Запись.Комментарий = ?(ЗначениеЗаполнено(СокрЛП(Комментарий)), СокрЛП(Комментарий),
		НСтр("ru = 'Стадия завершена'"));
	Запись.Стадия = Стадия;
	Запись.Завершено = СтадияЗавершена;
	Запись.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийИсполнитель()

	ПолноеИмя = ПользователиИнформационнойБазы.ТекущийПользователь().ПолноеИмя;
	Возврат Справочники.ПользователиБитрикс.НайтиПоРеквизиту("ИмяПользователяБД", ПолноеИмя);

КонецФункции

#КонецОбласти
