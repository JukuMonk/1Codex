// Серверный общий модуль с вызовом сервера: экспортные функции зовут из
// клиентского кода форм. Помощники держим СВОИ (ЧислоИлиНоль) — функцию из
// чужого модуля, вызванную без префикса, компилятор не проверяет (case 013).

#Область ПрограммныйИнтерфейс

// Активные элементы справочника. Иерархический справочник обязан отсекать
// группы: у группы реквизиты возвращают NULL (case 017).
Функция АктивныеЭлементы() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.Наименование КАК Наименование,
		|	Элементы.Радиус КАК Радиус
		|ИЗ
		|	Справочник.ПримерСправочник КАК Элементы
		|ГДЕ
		|	НЕ Элементы.ПометкаУдаления
		|	И Элементы.Активен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Элементы.Наименование");
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Запись независимого регистра: одна актуальная запись на объект.
Процедура ОтметитьНедоступность(Объект, Минут, Причина) Экспорт

	Набор = РегистрыСведений.ПримерНедоступность.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.НедоступенС = ТекущаяДата();
	Запись.НедоступенПо = ТекущаяДата() + Минут * 60;
	Запись.Причина = Лев(Причина, 100);
	Набор.Записать();

КонецПроцедуры

// Чтение независимого регистра — ЗАПРОСОМ: метод Получить возвращает
// структуру всегда, даже когда записи нет (case 018).
Функция Недоступность(Объект) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Записи.НедоступенПо КАК НедоступенПо,
		|	Записи.Причина КАК Причина
		|ИЗ
		|	РегистрСведений.ПримерНедоступность КАК Записи
		|ГДЕ
		|	Записи.Объект = &Объект
		|	И Записи.НедоступенПо > &Сейчас");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("По, Причина", Выборка.НедоступенПо, Выборка.Причина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Число из чего угодно: NULL у реквизита группы, пустая строка, Неопределено.
Функция ЧислоИлиНоль(Значение)

	Если Значение = Неопределено ИЛИ Значение = NULL ИЛИ Значение = "" Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти
