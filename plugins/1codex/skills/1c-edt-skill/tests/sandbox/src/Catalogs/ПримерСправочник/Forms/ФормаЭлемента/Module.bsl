// Модуль формы элемента. Каждая процедура — с директивой: без неё
// процедура модуля формы компилируется серверной (case 011).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Новый элемент: умолчания ставим здесь, а не в XML формы.
	Если Объект.Ссылка.Пустая() И НЕ Объект.Активен Тогда
		Объект.Активен = Истина;
	КонецЕсли;

КонецПроцедуры
