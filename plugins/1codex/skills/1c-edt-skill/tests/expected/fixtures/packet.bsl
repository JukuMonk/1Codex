// Фикстура к T16: пакет из трёх запросов; выбросить ВТОРОЙ (Активные),
// не оставив пустого запроса и не сломав индексы результатов.
// Эталон — ../T16.md.

&НаСервере
Функция Сводка()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ПримерСправочник КАК Элементы
		|ГДЕ
		|	НЕ Элементы.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Элементы.Ссылка) КАК Активных
		|ИЗ
		|	Справочник.ПримерСправочник КАК Элементы
		|ГДЕ
		|	Элементы.Активен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Записи.Объект КАК Объект,
		|	Записи.НедоступенПо КАК НедоступенПо
		|ИЗ
		|	РегистрСведений.ПримерНедоступность КАК Записи
		|ГДЕ
		|	Записи.НедоступенПо > &Сейчас");
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

	Результаты = Запрос.ВыполнитьПакет();
	Сводка = Новый Структура;
	Сводка.Вставить("Элементы", Результаты[0].Выгрузить());
	Выборка = Результаты[1].Выбрать();
	Выборка.Следующий();
	Сводка.Вставить("Активных", Выборка.Активных);
	Сводка.Вставить("Недоступные", Результаты[2].Выгрузить());
	Возврат Сводка;

КонецФункции
