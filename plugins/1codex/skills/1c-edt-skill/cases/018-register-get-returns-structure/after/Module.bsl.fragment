// CORRECT

Функция ПрочитатьКэш(УзелОт, УзелДо, ТипТС)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Кэш.Найден КАК Найден,
		|	Кэш.Длина  КАК Длина,
		|	Кэш.Время  КАК Время,
		|	Кэш.Путь   КАК Путь
		|ИЗ
		|	РегистрСведений.мвмКэшМаршрутов КАК Кэш
		|ГДЕ
		|	Кэш.УзелОт = &УзелОт
		|	И Кэш.УзелДо = &УзелДо
		|	И Кэш.ТипТС = &ТипТС");
	Запрос.УстановитьПараметр("УзелОт", УзелОт);
	Запрос.УстановитьПараметр("УзелДо", УзелДо);
	Запрос.УстановитьПараметр("ТипТС", ТипТС);
	Запись = Запрос.Выполнить().Выбрать();
	Если НЕ Запись.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
