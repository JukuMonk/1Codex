// Модуль мобильной формы «АРМ Водителя».
//
// Четыре страницы, которые листаются пальцем: «Сейчас», «Рейсы»,
// «Маршрут», «Смена». Что показывать и что разрешено нажимать, решает
// общий модуль «мвмРейсыВодителя» — форма только раскладывает ответ.
//
// Собирается скриптом инструменты/обработка_арм_водителя.py.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Водитель = мвмРейсыВодителя.Физлицо();
	ОформитьТаблицы();
	ПоказатьВсё();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСейчас;

КонецПроцедуры

// Диспетчер назначает рейсы, пока водитель едет. Ждать, что тот сам нажмёт
// «Обновить», не стоит: экран перечитывается сам раз в минуту.
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ПоТаймеру", 60);

КонецПроцедуры

&НаКлиенте
Процедура ПоТаймеру()

	ПоказатьНаСервере();

КонецПроцедуры

// На ходу читают цветом, а не текстом. Сигналов два, и они разные:
// рейс в работе — зелёный, точка с вышедшим нормативом — красная.
&НаСервере
Процедура ОформитьТаблицы()

	ВРаботе = УсловноеОформление.Элементы.Добавить();
	ДобавитьУсловие(ВРаботе, "Рейсы.Состояние",
		ВидСравненияКомпоновкиДанных.НеРавно, "рейс выполнен");
	ДобавитьУсловие(ВРаботе, "Рейсы.Состояние",
		ВидСравненияКомпоновкиДанных.НеРавно, "не начат");
	ВРаботе.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(226, 242, 226));
	ДобавитьПоля(ВРаботе, Элементы.Рейсы);

	ОтДиспетчера = УсловноеОформление.Элементы.Добавить();
	ДобавитьУсловие(ОтДиспетчера, "Сообщения.ОтДиспетчера",
		ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОтДиспетчера.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(227, 238, 255));
	ДобавитьПоля(ОтДиспетчера, Элементы.Сообщения);

КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловие(Элемент, Путь, ВидСравнения, Значение)

	Отбор = Элемент.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Путь);
	Отбор.ВидСравнения = ВидСравнения;
	Отбор.ПравоеЗначение = Значение;
	Отбор.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоля(Элемент, Таблица)

	Для Каждого Колонка Из Таблица.ПодчиненныеЭлементы Цикл
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);
		Поле.Использование = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПоказатьНаСервере()

	ПоказатьВсё();

КонецПроцедуры

// Выбор строки в очереди: рейс становится текущим, и «Сейчас»
// пересобирается под него.
&НаКлиенте
Процедура РейсыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Рейсы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.Рейс = ТекущийРейс Тогда
		Возврат;
	КонецЕсли;

	ТекущийРейс = ТекущиеДанные.Рейс;
	ПоказатьРейсНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПоказатьРейсНаСервере()

	ПоказатьРейс();

КонецПроцедуры

// Единственное действие, которое требуется от водителя. Что она сделает
// сейчас, написано на ней самой: подпись меняется вместе с состоянием.
&НаКлиенте
Процедура Дальше(Команда)

	Если НЕ ЗначениеЗаполнено(ТекущийРейс) Тогда
		ПоказатьПредупреждение(, ?(ПустаяСтрока(Пояснение), "Рейсов нет.",
			Пояснение));
		Возврат;
	КонецЕсли;

	Итог = ШагНаСервере();
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

&НаСервере
Функция ШагНаСервере()

	Итог = мвмРейсыВодителя.Шаг(ТекущийРейс);
	ПоказатьВсё();
	Возврат Итог;

КонецФункции

// «Не получается»: груза нет, принять некому, не проехать. Точка
// закрывается с причиной, и рейс идёт дальше — стоять из-за чужой беды
// водителю незачем, а диспетчер причину увидит в листе.
&НаКлиенте
Процедура НеПолучается(Команда)

	Если НЕ ЗначениеЗаполнено(ТекущийРейс) Тогда
		ПоказатьПредупреждение(, "Рейс не выбран.");
		Возврат;
	КонецЕсли;

	Список = ПричиныСписком();
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Список причин пуст. Позвоните диспетчеру:"
			+ " причины заводит он, в справочнике «Причины закрытия заказов».");
		Возврат;
	КонецЕсли;

	ПоказатьВыборИзМеню(Новый ОписаниеОповещения("ПричинаВыбрана", ЭтотОбъект),
		Список, Элементы.НеПолучается);

КонецПроцедуры

&НаСервере
Функция ПричиныСписком()

	Список = Новый СписокЗначений;
	Для Каждого Строка Из мвмРейсыВодителя.Причины() Цикл
		Список.Добавить(Строка.Причина, Строка.Имя);
	КонецЦикла;
	Возврат Список;

КонецФункции

&НаКлиенте
Процедура ПричинаВыбрана(Выбранное, Параметры) Экспорт

	Если Выбранное = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗакрытьСПричинойНаСервере(Выбранное.Значение);
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

&НаСервере
Функция ЗакрытьСПричинойНаСервере(Причина)

	Номер = НомерТекущейТочки();
	Если Номер = 0 Тогда
		Возврат "Незакрытых точек в рейсе нет.";
	КонецЕсли;

	Итог = мвмРейсыВодителя.ЗакрытьСПричиной(ТекущийРейс, Номер, Причина);
	ПоказатьВсё();
	Возврат Итог;

КонецФункции

// Первая незакрытая точка рейса — та самая, о которой идёт речь на
// странице «Сейчас».
&НаСервере
Функция НомерТекущейТочки()

	Для Каждого Точка Из Точки Цикл
		Если НЕ Точка.Выполнен Тогда
			Возврат Точка.Номер;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Конец дня: путевой лист помечается закрытым водителем. Спрашиваем — это
// действие последнее и обратного хода у водителя нет.
&НаКлиенте
Процедура ЗакрытьСмену(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("СменаЗавершение", ЭтотОбъект),
		"Закрыть смену? Отметить рейсы после этого будет нельзя.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СменаЗавершение(Ответ, Параметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗакрытьСменуНаСервере();
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

&НаСервере
Функция ЗакрытьСменуНаСервере()

	Итог = мвмРейсыВодителя.ЗакрытьСмену(Водитель);
	ПоказатьВсё();
	Возврат Итог;

КонецФункции

// Очередь и всё, что под ней: после отметки меняется и то, и другое.
&НаСервере
Процедура ПоказатьВсё()

	ЗначениеВРеквизитФормы(мвмРейсыВодителя.Рейсы(Водитель), "Рейсы");

	// Прежний рейс мог уйти из списка (закрылся вчера, отменил диспетчер) —
	// тогда берём первый незакрытый: он в списке первым и стоит.
	Найден = Ложь;
	Для Каждого Строка Из Рейсы Цикл
		Если Строка.Рейс = ТекущийРейс Тогда
			Найден = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Найден Тогда
		ТекущийРейс = ?(Рейсы.Количество() > 0, Рейсы[0].Рейс, Неопределено);
		Если Рейсы.Количество() > 0 Тогда
			Элементы.Рейсы.ТекущаяСтрока = Рейсы[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;

	ПоказатьРейс();

КонецПроцедуры

// Выбранный рейс: его точки и страница «Сейчас».
&НаСервере
Процедура ПоказатьРейс()

	ЗначениеВРеквизитФормы(мвмРейсыВодителя.Точки(ТекущийРейс), "Точки");
	ПоказатьЭкран();
	ОбновитьКарту();
	ОбновитьЧат();

КонецПроцедуры

// Лента чата и строка «новых сообщений» на «Сейчас». Если чат открыт
// прямо сейчас — новое тут же считается прочитанным.
&НаСервере
Процедура ОбновитьЧат()

	ЗначениеВРеквизитФормы(мвмЧатВодителей.Сообщения(Водитель), "Сообщения");
	Если Сообщения.Количество() > 0 Тогда
		Элементы.Сообщения.ТекущаяСтрока =
			Сообщения[Сообщения.Количество() - 1].ПолучитьИдентификатор();
	КонецЕсли;

	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЧат Тогда
		мвмЧатВодителей.ПрочитаноВодителем(Водитель);
	КонецЕсли;
	НовыхСообщений = мвмЧатВодителей.НепрочитанныхВодителем(Водитель);
	Элементы.ЧатНадпись.Заголовок = "Новых сообщений от диспетчера: "
		+ Формат(НовыхСообщений, "ЧГ=") + " — откройте страницу «Чат»";
	Элементы.ЧатНадпись.Видимость = (НовыхСообщений > 0);

КонецПроцедуры

// Открыл страницу чата — всё в ней прочитано; диспетчер это увидит.
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаЧат И НовыхСообщений > 0 Тогда
		ПрочитатьЧатНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьЧатНаСервере()

	мвмЧатВодителей.ПрочитаноВодителем(Водитель);
	ОбновитьЧат();

КонецПроцедуры

// Сообщение диспетчеру. Ответ — оповещением в углу, а не окном: в чате
// окно «ОК» на каждую реплику невыносимо.
&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(НовоеСообщение) Тогда
		ПоказатьОповещениеПользователя("Напишите сообщение");
		Возврат;
	КонецЕсли;

	Итог = ОтправитьНаСервере();
	ПоказатьОповещениеПользователя(Итог);

КонецПроцедуры

&НаСервере
Функция ОтправитьНаСервере()

	Итог = мвмЧатВодителей.ОтВодителя(Водитель, НовоеСообщение);
	Если СтрНачинаетсяС(Итог, "Отправлено") Тогда
		НовоеСообщение = "";
	КонецЕсли;
	ОбновитьЧат();
	Возврат Итог;

КонецФункции

// Карта рейса пересобирается только когда меняется рейс или отметки его
// точек: подложка внутри неё весит сотни килобайт, и гонять её по воздуху
// раз в минуту незачем. Карта — украшение: не построилась — экран живёт
// без неё.
&НаСервере
Процедура ОбновитьКарту()

	Ключ = "";
	Если ЗначениеЗаполнено(ТекущийРейс) Тогда
		Ключ = Строка(ТекущийРейс.УникальныйИдентификатор());
		Для Каждого Точка Из Точки Цикл
			Ключ = Ключ + ?(Точка.Выполнен, "+", "-");
		КонецЦикла;
	КонецЕсли;
	// Поле карты видно только с картой: пустое — серый прямоугольник.
	Элементы.КартаHTML.Видимость = НЕ ПустаяСтрока(КартаHTML);
	Если Ключ = КартаКлюч Тогда
		Возврат;
	КонецЕсли;

	КартаКлюч = Ключ;
	КартаHTML = "";
	Если НЕ ПустаяСтрока(Ключ) Тогда
		Попытка
			КартаHTML = мвмРейсыВодителя.КартаРейса(ТекущийРейс);
		Исключение
			КартаHTML = "";
		КонецПопытки;
	КонецЕсли;
	Элементы.КартаHTML.Видимость = НЕ ПустаяСтрока(КартаHTML);

КонецПроцедуры

// Страница «Сейчас» целиком приходит из общего модуля: он один решает,
// что главное в этом состоянии, как назвать кнопку и что можно нажать.
&НаСервере
Процедура ПоказатьЭкран()

	Экран = мвмРейсыВодителя.Экран(Водитель, ТекущийРейс);

	СостояниеЭкрана = Экран.Состояние;
	ЧтоДелать = Экран.Заголовок;
	Пояснение = Экран.Пояснение;
	КудаЕду = Экран.Пункт;
	ЧтоВезу = Экран.Груз;
	НормативТекст = Экран.Норматив;
	ПораЗакончить = Экран.Просрочено;
	КомментарийДиспетчера = Экран.Комментарий;
	МояМашина = Экран.Машина;
	СменаТекст = Экран.Смена.Текст;

	Незакрытых = 0;
	Для Каждого Строка Из Рейсы Цикл
		Если Строка.Состояние <> "рейс выполнен" Тогда
			Незакрытых = Незакрытых + 1;
		КонецЕсли;
	КонецЦикла;
	РейсовОсталось = Незакрытых;

	// Заголовок, пояснение и комментарий — надписи: текст им отдаётся
	// заголовком, длинное переносится, а не обрезается.
	// Вышел норматив — заголовок красный: на ходу читают цветом.
	Элементы.КомментарийДиспетчера.Заголовок = ?(ПустаяСтрока(КомментарийДиспетчера),
		"", "Диспетчер: " + КомментарийДиспетчера);
	Элементы.ЧтоДелать.Заголовок = ЧтоДелать;
	Элементы.ЧтоДелать.ЦветТекста = ?(ПораЗакончить,
		Новый Цвет(211, 47, 47), Новый Цвет());
	Элементы.Пояснение.Заголовок = Пояснение;

	// Кнопка называется тем, что она сделает: «Я на месте», «Погрузка
	// закончена». «Дальше» ни о чём не говорит, когда экран в кармане.
	Элементы.Дальше.Заголовок = ?(ПустаяСтрока(Экран.Кнопка), "Дальше",
		Экран.Кнопка);
	Элементы.Дальше.Видимость = Экран.ЕстьДействие;
	Элементы.НеПолучается.Видимость = Экран.ЕстьДействие;
	Элементы.ЗакрытьСмену.Видимость = Экран.Смена.Есть
		И НЕ Экран.Смена.Закрыта;

	// Пустые строки на телефоне занимают место молча: чего нет, того не
	// показываем вовсе.
	Элементы.Пояснение.Видимость = НЕ ПустаяСтрока(Пояснение);
	Элементы.ЧтоВезу.Видимость = НЕ ПустаяСтрока(ЧтоВезу);
	Элементы.НормативТекст.Видимость = НЕ ПустаяСтрока(НормативТекст);
	Элементы.КомментарийДиспетчера.Видимость =
		НЕ ПустаяСтрока(КомментарийДиспетчера);
	Элементы.КудаЕду.Видимость = ЗначениеЗаполнено(КудаЕду);
	Элементы.ПораЗакончить.Видимость = ПораЗакончить;

КонецПроцедуры
