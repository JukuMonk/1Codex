// Отбор динамического списка из параметров формы и по полям поиска.
//
// Три вещи, проверенные в бою (cases 033, 036):
//   - Параметры.Отбор читается в ПриСозданииНаСервере;
//   - отбор накладывается через ОтборыСписковКлиентСервер (БСП) — правит
//     ПОЛЬЗОВАТЕЛЬСКИЕ настройки списка, а не фиксированные;
//   - переключение иерархии списка держим в двух процедурах — серверной
//     и клиентской — с одним телом. &НаКлиентеНаСервере для этого
//     не полагаться без проверки (case 033, MEDIUM).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
		ПоискВладелец = Параметры.Отбор.Владелец;
		ПрименитьОтборНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоискВладелецПриИзменении(Элемент)

	ПрименитьОтбор();

КонецПроцедуры

&НаКлиенте
Процедура ПоискНаименованиеПриИзменении(Элемент)

	ПрименитьОтбор();

КонецПроцедуры

// Клиентская и серверная версии — одно тело.
&НаКлиенте
Процедура ПрименитьОтбор()

	ЕстьОтбор = ЗначениеЗаполнено(ПоискВладелец) ИЛИ НЕ ПустаяСтрока(ПоискНаименование);
	ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Владелец",
		ПоискВладелец, ЗначениеЗаполнено(ПоискВладелец));
	ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Наименование",
		ПоискНаименование, НЕ ПустаяСтрока(ПоискНаименование),
		ВидСравненияКомпоновкиДанных.Содержит);
	ИерархияПоОтбору(ЕстьОтбор);

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборНаСервере()

	ЕстьОтбор = ЗначениеЗаполнено(ПоискВладелец) ИЛИ НЕ ПустаяСтрока(ПоискНаименование);
	ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Владелец",
		ПоискВладелец, ЗначениеЗаполнено(ПоискВладелец));
	ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Наименование",
		ПоискНаименование, НЕ ПустаяСтрока(ПоискНаименование),
		ВидСравненияКомпоновкиДанных.Содержит);
	ИерархияПоОтборуНаСервере(ЕстьОтбор);

КонецПроцедуры

// При отборе иерархический список показываем плоско: иначе найденные
// элементы прячутся по группам, а группы (ЭтоГруппа) отбору не отвечают.
&НаКлиенте
Процедура ИерархияПоОтбору(Плоско)

	Если Плоско Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	Иначе
		Элементы.Список.Отображение = ОтображениеТаблицы.ИерархическийСписок;
	КонецЕсли;
	ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "ЭтоГруппа", Ложь, Плоско);

КонецПроцедуры

&НаСервере
Процедура ИерархияПоОтборуНаСервере(Плоско)

	Если Плоско Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	Иначе
		Элементы.Список.Отображение = ОтображениеТаблицы.ИерархическийСписок;
	КонецЕсли;
	ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "ЭтоГруппа", Ложь, Плоско);

КонецПроцедуры

// Вариант без БСП: параметр в тексте запроса списка (ПроизвольныйЗапрос).
&НаСервере
Процедура УстановитьПараметрСписка(Имя, Значение)

	Список.Параметры.УстановитьЗначениеПараметра(Имя, Значение);

КонецПроцедуры
