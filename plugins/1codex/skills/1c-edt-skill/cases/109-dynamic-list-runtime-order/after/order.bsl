// Фрагмент серверной процедуры формы; имена адаптировать к проекту.
	Схема = Элементы.СценарииРаздела.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.СценарииРаздела.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	// В настройках динамического списка структура/выбор деталей могут быть пустыми.
	// Явная детальная группировка — как в штатном групповом изменении реквизитов.
	Настройки.Структура.Очистить();
	Детали = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Детали.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Детали.Использование = Истина;
	// Полученные настройки СКД не включают программный Порядок динамического списка.
	// Переносим его явно; иначе после первого перемещения СКД возвращает порядок вставки.
	Если СценарииРаздела.Порядок.Элементы.Количество() > 0 Тогда
		Настройки.Порядок.Элементы.Очистить();
		Для Каждого ИсходныйПорядок Из СценарииРаздела.Порядок.Элементы Цикл
			НовыйПорядок = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйПорядок, ИсходныйПорядок);
		КонецЦикла;
	КонецЕсли;
	Для Каждого ИсходныйПорядок Из Настройки.Порядок.Элементы Цикл
		ПорядокДеталей = Детали.Порядок.Элементы.Добавить(ТипЗнч(ИсходныйПорядок));
		ЗаполнитьЗначенияСвойств(ПорядокДеталей, ИсходныйПорядок);
	КонецЦикла;
