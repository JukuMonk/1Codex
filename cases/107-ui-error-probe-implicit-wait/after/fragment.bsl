// CORRECT: фрагмент модуля менеджера; ТП — подключённое тестируемое приложение.
&НаКлиенте
Функция ИндексДиалогаОшибки()

	ОкноДиагностики = ТП.ПолучитьАктивноеОкно();
	ИндексДиагностики = Новый Соответствие;
	Если ОкноДиагностики <> Неопределено Тогда
		СобратьСуществующиеЭлементыОшибки(ОкноДиагностики, ИндексДиагностики, 0);
	КонецЕсли;
	Возврат ИндексДиагностики;

КонецФункции

&НаКлиенте
Процедура СобратьСуществующиеЭлементыОшибки(УзелДиагностики, ИндексДиагностики, ГлубинаДиагностики)

	Если ГлубинаДиагностики > 6 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ДочернийУзел Из УзелДиагностики.ПолучитьПодчиненныеОбъекты() Цикл
		Попытка
			ИмяУзлаДиагностики = ДочернийУзел.Имя;
			Если ИмяУзлаДиагностики = "ErrorInfo" Или ИмяУзлаДиагностики = "AdditionalInfo"
				Или ИмяУзлаДиагностики = "ServerText" Тогда
				ИндексДиагностики.Вставить(ИмяУзлаДиагностики, ДочернийУзел);
			КонецЕсли;
		Исключение
			// У окна/формы нет имени элемента; проверяем его дочерние объекты.
		КонецПопытки;
		СобратьСуществующиеЭлементыОшибки(ДочернийУзел, ИндексДиагностики, ГлубинаДиагностики + 1);
	КонецЦикла;

КонецПроцедуры
