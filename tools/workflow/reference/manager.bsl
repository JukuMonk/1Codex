// Менеджер тестирования (/TESTMANAGER): ведёт тестируемый клиент (/TESTCLIENT -TPort) по сценарию.
// Параметр запуска /C "<сценарий.txt>;<журнал.txt>[;порт]". Шаги «ссылка», «изменить», «завершить», «ячейка» — ZHDRM. Сценарий — строки «шаг | арг1 | арг2 | арг3»,
// # — комментарий. Итог — журнал «ОК/ОШИБКА строка => результат»; на первой ошибке — состояние окна.
// Интерпретатор — из 1c-edt-skill/tools/platform.py (уровень 9), через АЗОТ; в ZHDRM добавлен шаг «команда». Вынесен во внешнюю обработку, чтобы
// не вставлять его в модули конфигурации.

&НаКлиенте
Перем ТП;
&НаКлиенте
Перем ПутьЗапросаСнимка;

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("Прогон", 2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Прогон()

	Части = СтрРазделить(ПараметрЗапуска, ";");
	ПутьСценария = Части[0];
	ПутьЖурнала = ?(Части.Количество() > 1, Части[1], ПутьСценария + ".log");
	Порт = ?(Части.Количество() > 2, Число(Части[2]), 48123);
	ПутьЗапросаСнимка = ПутьЖурнала + ".снимок";
	Журнал = Новый Массив;
	ПутьПрогресса = ПутьЖурнала + ".progress";
	ЗаписатьФайл(ПутьПрогресса, "СТАРТ менеджера UI");
	Попытка
		ПараметрыТП = Новый Массив;
		ПараметрыТП.Добавить("localhost");
		ПараметрыТП.Добавить(Порт);
		ТП = Новый("ТестируемоеПриложение", ПараметрыТП);
	Исключение
		Журнал.Добавить(БезСекретов_("ОШИБКА: ТестируемоеПриложение: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Подключено = Ложь;
	Ошибка = "";
	Если ТП <> Неопределено Тогда
		Для Н = 1 По 90 Цикл
			Попытка
				ТП.УстановитьСоединение();
				Подключено = Истина;
				Прервать;
			Исключение
				Ошибка = БезСекретов_(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Пауза(2);
			КонецПопытки;
		КонецЦикла;
		Если Не Подключено Тогда
			Журнал.Добавить("ОШИБКА: нет соединения с тестируемым клиентом: " + Ошибка);
		КонецЕсли;
	КонецЕсли;
	Если Подключено Тогда
		Для Каждого Строка Из СтрРазделить(ПрочитатьФайл(ПутьСценария), Символы.ПС, Ложь) Цикл
			Строка = СокрЛП(Строка);
			Если Строка = "" Или Лев(Строка, 1) = "#" Тогда
				Продолжить;
			КонецЕсли;
			Арг = СтрРазделить(Строка, "|");
			Для Инд = 0 По Арг.ВГраница() Цикл
				Арг[Инд] = СокрЛП(Арг[Инд]);
			КонецЦикла;
			Пока Арг.Количество() < 4 Цикл
				Арг.Добавить("");
			КонецЦикла;
			// «?шаг | …» — необязательный: ошибка пишется «ПРОПУЩЕН», сценарий идёт дальше (UP, 17.10.2026)
			Необязательный = Лев(Арг[0], 1) = "?";
			Если Необязательный Тогда
				Арг[0] = СокрЛП(Сред(Арг[0], 2));
			КонецЕсли;
			НачалоШага = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписатьФайл(ПутьПрогресса, СтрСоединить(Журнал, Символы.ПС) + Символы.ПС + "НАЧАЛО " + БезСекретов_(Строка));
			Попытка
				Итог = Шаг(НРег(Арг[0]), Арг[1], Арг[2], Арг[3]);
				Если НРег(Арг[0]) <> "дамп" И НРег(Арг[0]) <> "контекст" Тогда
					ПроверитьОшибкуКлиента_();
				КонецЕсли;
				// длительность шага — для поиска медленных мест (UP, 17.10.2026)
				Журнал.Добавить("ОК   " + БезСекретов_(Строка + ?(ЗначениеЗаполнено(Итог), " => " + Итог, ""))
					+ " [" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоШага, "ЧГ=0") + " мс]");
				ЗаписатьФайл(ПутьПрогресса, СтрСоединить(Журнал, Символы.ПС));
			Исключение
				ПодробностиСбоя = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Если Необязательный Тогда
					Журнал.Добавить("ПРОПУЩЕН " + БезСекретов_(Строка + ": " + ПодробностиСбоя));
					Журнал.Добавить(БезСекретов_(Состояние_()));
					ЗаписатьФайл(ПутьПрогресса, СтрСоединить(Журнал, Символы.ПС));
					Продолжить;
				КонецЕсли;
				Журнал.Добавить("ОШИБКА " + БезСекретов_(Строка + ": " + ПодробностиСбоя));
				Журнал.Добавить(БезСекретов_(Состояние_()));
				ЗаписатьФайл(ПутьПрогресса, СтрСоединить(Журнал, Символы.ПС));
				Прервать;
			КонецПопытки;
		КонецЦикла;
		Попытка
			ТП.РазорватьСоединение();
		Исключение
		КонецПопытки;
	КонецЕсли;
	ЗаписатьФайл(ПутьЖурнала, СтрСоединить(Журнал, Символы.ПС));
	ЗаписатьФайл(ПутьПрогресса, СтрСоединить(Журнал, Символы.ПС) + Символы.ПС + "КОНЕЦ менеджера UI");
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаКлиенте
Функция Шаг(Шаг, А1, А2, А3)

	Если Шаг <> "дамп" И Шаг <> "контекст" Тогда
		ПроверитьОшибкуКлиента_();
	КонецЕсли;
	Если Шаг = "этап" Тогда
		Возврат А1;
	ИначеЕсли Шаг = "команда" Тогда
		// навигационная ссылка раздела/списка: e1cib/list/Справочник.X, e1cib/app/Обработка.Y (ZHDRM)
		Было = КлючОкна_();
		ТП.ПолучитьАктивноеОкно().ВыполнитьКоманду(А1);
		ЖдатьСмены_(Было, 0.7);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "ждать" Тогда
		ПределЯвногоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах() + Число(А1) * 1000;
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределЯвногоОжидания Цикл
			ПроверитьОшибкуКлиента_();
			Пауза(0.1);
		КонецЦикла;
		Возврат "";
	ИначеЕсли Шаг = "форма" Тогда
		Для Н = 1 По 200 Цикл
			ПроверитьОшибкуКлиента_();
			Ф = Форма_();
			Если Ф <> Неопределено И СтрНайти(НРег(Заголовок_(Ф)), НРег(А1)) > 0 Тогда
				Возврат Заголовок_(Ф);
			КонецЕсли;
			Пауза(0.3);
		КонецЦикла;
		ВызватьИсключение "нет формы «" + А1 + "», активна: " + Заголовок_(Форма_());
	ИначеЕсли Шаг = "окно" Тогда
		// окно по заголовку формы среди всех открытых — сделать активным (форма под другим окном, 20.10.2026)
		Для Н = 1 По 100 Цикл
			ПроверитьОшибкуКлиента_();
			Для Каждого ОкноТП Из ТП.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
				Ф = ОкноТП.НайтиОбъект(Тип("ТестируемаяФорма"));
				Если Ф <> Неопределено И СтрНайти(НРег(Заголовок_(Ф)), НРег(А1)) > 0 Тогда
					ОкноТП.Активизировать();
					Пауза(0.3);
					Возврат Заголовок_(Ф);
				КонецЕсли;
			КонецЦикла;
			Пауза(0.3);
		КонецЦикла;
		ВызватьИсключение "нет окна «" + А1 + "»";
	ИначеЕсли Шаг = "кнопка" Тогда
		Элемент_(Тип("ТестируемаяКнопкаФормы"), А1).Нажать();
		Пауза(0.3);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "кнопка-точно" Тогда
		ТочнаяКнопка_(А1).Нажать();
		Пауза(0.3);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "страница" Тогда
		Элемент_(Тип("ТестируемаяГруппаФормы"), А1).Активизировать();
		Пауза(0.3);
		Возврат "";
	ИначеЕсли Шаг = "надпись" Тогда
		Текст = Заголовок_(Элемент_(Тип("ТестируемаяДекорацияФормы"), А1));
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "заголовок" Тогда
		Ф = Форма_();
		Объект_ = Неопределено;
		Для Каждого ТипЭл Из СтрРазделить("ТестируемаяГруппаФормы,ТестируемоеПолеФормы,ТестируемаяДекорацияФормы,ТестируемаяКнопкаФормы", ",") Цикл
			Объект_ = Ф.НайтиОбъект(Тип(ТипЭл), , А1);
			Если Объект_ <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Объект_ = Неопределено Тогда
			ВызватьИсключение "нет элемента «" + А1 + "»";
		КонецЕсли;
		Текст = Заголовок_(Объект_);
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "поле" Тогда
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Поле.Активизировать();
		Поле.ВвестиТекст(А2);
		Форма_().ПерейтиКСледующемуЭлементу();
		Пауза(0.7);
		Возврат Поле.ПолучитьОтображаемыйТекст();
	ИначеЕсли Шаг = "флажок" Тогда
		// флажок формы: флажок | ИмяПоля — нажатие переключает (UP, 18.10.2026)
		// у флажка нет отображаемого текста («Неподходящий тип элемента управления») — способы пробуются по очереди,
		// в журнал пишется сработавший
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Попытка
			Поле.Активизировать();
		Исключение
		КонецПопытки;
		Способ = "";
		Ошибки = Новый Массив;
		// 8.5.1: УстановитьОтметку() без параметров переключает флажок; Нажать и ВвестиТекст — «Неподходящий тип
		// элемента управления» (UP, 18.10.2026)
		Попытка
			Поле.УстановитьОтметку();
			Способ = "УстановитьОтметку";
		Исключение
			Ошибки.Добавить("УстановитьОтметку: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если Способ = "" Тогда
			Попытка
				Поле.Нажать();
				Способ = "Нажать";
			Исключение
				Ошибки.Добавить("Нажать: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		Если Способ = "" Тогда
			Попытка
				Поле.ВвестиТекст("Да");
				Форма_().ПерейтиКСледующемуЭлементу();
				Способ = "ВвестиТекст";
			Исключение
				Ошибки.Добавить("ВвестиТекст: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		Если Способ = "" Тогда
			ВызватьИсключение "флажок не переключается: " + СтрСоединить(Ошибки, "; ");
		КонецЕсли;
		Пауза(0.7);
		Возврат "переключён (" + Способ + ")";
	ИначеЕсли Шаг = "значение" Тогда
		Текст = Элемент_(Тип("ТестируемоеПолеФормы"), А1).ПолучитьОтображаемыйТекст();
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "строка" Тогда
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Если НРег(А2) = "последняя" Тогда
			Таблица.ПерейтиКПоследнейСтроке();
		ИначеЕсли НРег(А2) = "следующая" Тогда
			Таблица.ПерейтиКСледующейСтроке();
		Иначе
			Таблица.ПерейтиКПервойСтроке();
		КонецЕсли;
		Пауза(0.3);
		Возврат "";
	ИначеЕсли Шаг = "текущая" Или Шаг = "текущаястрока" Тогда
		// значения текущей строки таблицы (ПолучитьТекущуюСтроку); пустая таблица — исключение платформы
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Значение = Таблица.ПолучитьТекущуюСтроку();
		Части = Новый Массив;
		Попытка
			Для Каждого КЗ Из Значение Цикл
				Части.Добавить(Строка(КЗ.Ключ) + "=" + Строка(КЗ.Значение));
			КонецЦикла;
		Исключение
			Части.Добавить(Строка(Значение));
		КонецПопытки;
		Текст = СтрСоединить(Части, "; ");
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "ссылка" Тогда
		// поле ссылочного типа (и ячейка строки в режиме правки): набрать часть наименования и выбрать строку
		// подсказки ввода; подсказка заполняется асинхронно — ждать до 10 с (из platform.py набора)
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Попытка
			Поле.Активизировать();
		Исключение
		КонецПопытки;
		Поле.ВвестиТекст(А2);
		Пауза(0.7);
		Искомое = ?(ЗначениеЗаполнено(А3), А3, А2);
		Выбор = Неопределено;
		Для Н = 1 По 33 Цикл
			Попытка
				Выбор = СтрокаСписка_(Поле, Искомое);
				Прервать;
			Исключение
				Если Н = 10 Тогда
					ВызватьИсключение;
				КонецЕсли;
				Пауза(0.3);
			КонецПопытки;
		КонецЦикла;
		Поле.ВыполнитьВыборИзВыпадающегоСписка(Выбор);
		Пауза(0.3);
		Возврат Поле.ПолучитьОтображаемыйТекст();
	ИначеЕсли Шаг = "изменить" Тогда
		// начать правку текущей строки таблицы (как F2): изменить | Таблица | ИмяПоляКолонки — сначала встать на
		// колонку: правка, начатая на колонке «только просмотр», ввода в другую не принимает (ZHDRM)
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Если ЗначениеЗаполнено(А2) Тогда
			Элемент_(Тип("ТестируемоеПолеФормы"), А2).Активизировать();
		КонецЕсли;
		Таблица.ИзменитьСтроку();
		Пауза(0.3);
		Возврат "";
	ИначеЕсли Шаг = "завершить" Тогда
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.ЗакончитьРедактированиеСтроки();
		Пауза(0.3);
		Возврат "";
	ИначеЕсли Шаг = "ячейка" Тогда
		// текст ячейки текущей строки: ячейка | Таблица | ИмяПоляКолонки | ожидаемое (на 8.3.27 нет ПолучитьТекущуюСтроку)
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Колонка = Элемент_(Тип("ТестируемоеПолеФормы"), А2);
		// колонку на 8.3.27 задаёт ИМЯ элемента; объект поля молча отдаёт текущую ячейку, заголовок — «отсутствует
		// указанное значение» (ZHDRM, 09.10.2026). Остальные варианты — для других версий платформы.
		Попытка
			Текст = Таблица.ПолучитьТекстЯчейки(А2);
		Исключение
			Текст = Таблица.ПолучитьТекстЯчейки(Колонка.ТекстЗаголовка);
		КонецПопытки;
		Проверить(Текст, А3);
		Возврат Текст;
	ИначеЕсли Шаг = "выбор" Тогда
		// кнопка выбора («…») поля или ячейки строки в режиме правки: выбор | ИмяПоля (UP, 17.10.2026)
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Попытка
			Поле.Активизировать();
		Исключение
		КонецПопытки;
		Было = КлючОкна_();
		Поле.Выбрать();                         // кнопка выбора поля («НажатьКнопкуВыбора» у поля нет — 8.5.1)
		ЖдатьСмены_(Было, 0.7);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "раздел" Тогда
		// раздел командного интерфейса по заголовку: раздел | Методология — раскрыть панель функций раздела
		// (навигационная ссылка e1cib/navigationpoint/… в интерфейсе 8.5 раздел не раскрывает) (UP, 17.10.2026)
		Кнопка = ТП.ПолучитьАктивноеОкно().НайтиОбъект(Тип("ТестируемаяКнопкаКомандногоИнтерфейса"), А1);
		Если Кнопка = Неопределено Тогда
			Для Каждого ОкноКлиента_ Из ТП.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
				Кнопка = ОкноКлиента_.НайтиОбъект(Тип("ТестируемаяКнопкаКомандногоИнтерфейса"), А1);
				Если Кнопка <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			ВызватьИсключение "нет раздела «" + А1 + "»";
		КонецЕсли;
		Кнопка.Нажать();
		Пауза(0.7);
		Возврат "";
	ИначеЕсли Шаг = "выделить" Тогда
		// выделить все строки таблицы: выделить | Таблица (UP, 17.10.2026)
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Таблица.ВыделитьВсеСтроки();
		Пауза(0.3);
		Возврат "";
	ИначеЕсли Шаг = "сортировать" Тогда
		Элемент_(Тип("ТестируемаяТаблицаФормы"), А1).УстановитьПорядок(А2);
		Пауза(0.3);
		Возврат "";
	ИначеЕсли Шаг = "фокус-поле" Тогда
		Элемент_(Тип("ТестируемоеПолеФормы"), А1).Активизировать();
		Возврат "";
	ИначеЕсли Шаг = "открыть-поле" Тогда
		// TestedFormField input extension.Open(), синтакс-помощник 8.5.1.1529.
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Поле.Активизировать();
		Было = КлючОкна_();
		Поле.Открыть();
		ЖдатьСмены_(Было, 0.7);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "открыть" Тогда
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Было = КлючОкна_();
		Таблица.Выбрать();
		ЖдатьСмены_(Было, 0.7);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "вопрос" Тогда
		// ответ в диалоге ПоказатьВопрос/ПоказатьПредупреждение: кнопка по заголовку
		Для Н = 1 По 66 Цикл
			ПроверитьОшибкуКлиента_();
			Ф = Форма_();
			Кнопка = Неопределено;
			Если Ф <> Неопределено Тогда
				Кнопка = Ф.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), А1);
			КонецЕсли;
			Если Кнопка <> Неопределено Тогда
				Текст = Заголовок_(Ф);
				Кнопка.Нажать();
				Пауза(0.3);
				Возврат Текст;
			КонецЕсли;
			Пауза(0.3);
		КонецЦикла;
		ВызватьИсключение "нет диалога с кнопкой «" + А1 + "», активна: " + Заголовок_(Форма_());
	ИначеЕсли Шаг = "закрыть" Тогда
		Ф = Форма_();
		Текст = Заголовок_(Ф);
		Было = КлючОкна_();
		ТП.ПолучитьАктивноеОкно().Закрыть();   // у ТестируемаяФорма метода Закрыть нет — закрывается окно
		ЖдатьСмены_(Было, 0.7);
		// закрыть | без сохранения: если 1С спросит «Данные были изменены. Сохранить?» — «Нет»; не спросит — дальше
		// (шаг «вопрос» в этом случае ждал бы диалога и падал) (UP, 17.10.2026)
		Если НРег(А1) = "без сохранения" Тогда
			ФВопрос = Форма_();
			Если ФВопрос <> Неопределено Тогда
				Кнопка = ФВопрос.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Нет");
				Если Кнопка <> Неопределено Тогда
					Было = КлючОкна_();
					Кнопка.Нажать();
					ЖдатьСмены_(Было, 0.3);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Возврат Текст;
	ИначеЕсли Шаг = "закрыть-форму" Тогда
		// закрыть активное окно, только если заголовок его формы начинается с А1 (после необязательного «?выбор»:
		// не открылось — родительскую форму не закрывать) (UP, 17.10.2026)
		Текст = Заголовок_(Форма_());
		Если СтрНачинаетсяС(НРег(Текст), НРег(А1)) Тогда
			Было = КлючОкна_();
			ТП.ПолучитьАктивноеОкно().Закрыть();
			ЖдатьСмены_(Было, 0.7);
			Возврат "закрыто: " + Текст;
		КонецЕсли;
		Возврат "не открыто (активна: " + Текст + ")";
	ИначеЕсли Шаг = "снимок" Тогда
		// запрос снимка: Python снимает окно тестируемого клиента и удаляет файл запроса
		ЗаписатьФайл(ПутьЗапросаСнимка, А1);
		Для Н = 1 По 900 Цикл
			Пауза(0.1);
			Если Не ФайлЕсть(ПутьЗапросаСнимка) Тогда
				Возврат "";
			КонецЕсли;
		КонецЦикла;
		ВызватьИсключение "снимок не сделан";
	ИначеЕсли Шаг = "сообщения" Тогда
		Тексты = Сообщения_();
		Проверить(Тексты, А1);
		Возврат Тексты;
	ИначеЕсли Шаг = "дамп" Или Шаг = "контекст" Тогда
		Возврат Состояние_();
	ИначеЕсли Шаг = "добавить-строку" Или Шаг = "скопировать-строку" Тогда
		// Кнопка передаётся точным именем: никаких догадок о стандартных командах таблицы.
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		ТочнаяКнопка_(А2).Нажать();
		Пауза(0.3);
		Возврат "таблица=" + А1 + "; команда=" + А2;
	ИначеЕсли Шаг = "редактировать-выбор" Тогда
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А2);
		Таблица.Активизировать();
		Поле.Активизировать();
		Таблица.ИзменитьСтроку();
		Пауза(0.3);
		ПроверитьОшибкуКлиента_();
		Было = КлючОкна_();
		Поле.Выбрать();
		ЖдатьСмены_(Было, 0.7);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "видимыйпорядок" Тогда
		Возврат ПорядокТаблицы_(А1, А2, А3);
	КонецЕсли;
	ВызватьИсключение "неизвестный шаг «" + Шаг + "»";

КонецФункции

// Строка подсказки ввода/списка выбора, содержащая текст (из platform.py набора: ТестUIСтрокаСписка).
// Макросы используют те же подтверждённые тест-клиентом действия, что и отдельные шаги.
&НаКлиенте
Функция ТочнаяКнопка_(ИмяКомандыТаблицы)

	ФормаТаблицы = Форма_();
	Если ФормаТаблицы = Неопределено Тогда
		ВызватьИсключение "нет активной формы для команды таблицы";
	КонецЕсли;
	КомандаТаблицы = ФормаТаблицы.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , ИмяКомандыТаблицы);
	Если КомандаТаблицы = Неопределено Тогда
		ВызватьИсключение "нет кнопки таблицы с точным именем «" + ИмяКомандыТаблицы + "»";
	КонецЕсли;
	Возврат КомандаТаблицы;

КонецФункции

// Читает явно заданные первые N строк в экранном порядке. Курсор остаётся на последней прочитанной.
// Это ограниченная диагностическая выборка, не полный экспорт динамического списка.
&НаКлиенте
Функция ПорядокТаблицы_(ИмяТаблицыПорядка, ИмяКолонкиПорядка, ПределСтрокТекст)

	ПределСтрок = Число(ПределСтрокТекст);
	Если ПределСтрок < 1 Или ПределСтрок > 200 Или ПределСтрок <> Цел(ПределСтрок) Тогда
		ВызватьИсключение "видимыйпорядок: число строк должно быть целым от 1 до 200";
	КонецЕсли;
	ТаблицаПорядка = Элемент_(Тип("ТестируемаяТаблицаФормы"), ИмяТаблицыПорядка);
	Элемент_(Тип("ТестируемоеПолеФормы"), ИмяКолонкиПорядка);
	ТаблицаПорядка.Активизировать();
	ТаблицаПорядка.ПерейтиКПервойСтроке();
	ЗначенияПорядка = Новый Массив;
	Для ИндексПорядка = 1 По ПределСтрок Цикл
		ПроверитьОшибкуКлиента_();
		ЗначенияПорядка.Добавить(Строка(ИндексПорядка) + ":" + ТаблицаПорядка.ПолучитьТекстЯчейки(ИмяКолонкиПорядка));
		Если ИндексПорядка < ПределСтрок Тогда
			ТаблицаПорядка.ПерейтиКСледующейСтроке();
		КонецЕсли;
	КонецЦикла;
	Возврат "запрошено строк=" + Строка(ПределСтрок) + "; " + СтрСоединить(ЗначенияПорядка, "; ");

КонецФункции

// Глобальная ошибка — отдельное окно. ErrorInfo является подтверждённым именем платформы;
// AdditionalInfo/ServerText читаются только если реально присутствуют.
&НаКлиенте
Функция ОшибкаКлиента_()

	АктивноеОкноОшибки = ТП.ПолучитьАктивноеОкно();
	Если АктивноеОкноОшибки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ИндексОшибка = Новый Соответствие;
	СобратьЭлементыОшибки_(АктивноеОкноОшибки, ИндексОшибка, 0);
	ТекстыОшибкиКлиента = Новый Массив;
	ОсновнаяОшибка = ТекстЭлементаОшибки_(ИндексОшибка.Получить("ErrorInfo"));
	Если Не ПустаяСтрока(ОсновнаяОшибка) Тогда
		ТекстыОшибкиКлиента.Добавить("ОШИБКА КЛИЕНТА: " + ОсновнаяОшибка);
		Для Каждого ИмяПодробностей Из СтрРазделить("AdditionalInfo,ServerText", ",") Цикл
			ПодробностиКлиента = ТекстЭлементаОшибки_(ИндексОшибка.Получить(ИмяПодробностей));
			Если Не ПустаяСтрока(ПодробностиКлиента) Тогда
				ТекстыОшибкиКлиента.Добавить(ИмяПодробностей + ": " + ПодробностиКлиента);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(ТекстыОшибкиКлиента, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура СобратьЭлементыОшибки_(УзелОшибка, ИндексОшибка, ГлубинаОшибка)

	Если ГлубинаОшибка > 6 Тогда
		Возврат;
	КонецЕсли;
	// Только уже существующее дерево: НайтиОбъект при отсутствии элемента неявно ждёт.
	Для Каждого ДочернийОшибка Из УзелОшибка.ПолучитьПодчиненныеОбъекты() Цикл
		Попытка
			ИмяОшибка = ДочернийОшибка.Имя;
			Если ИмяОшибка = "ErrorInfo" Или ИмяОшибка = "AdditionalInfo" Или ИмяОшибка = "ServerText" Тогда
				ИндексОшибка.Вставить(ИмяОшибка, ДочернийОшибка);
			КонецЕсли;
		Исключение
			// У окна/формы нет имени элемента; дочерние объекты всё равно проверяем.
		КонецПопытки;
		СобратьЭлементыОшибки_(ДочернийОшибка, ИндексОшибка, ГлубинаОшибка + 1);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ТекстЭлементаОшибки_(ЭлементОшибкиКлиента)

	Если ЭлементОшибкиКлиента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(ЭлементОшибкиКлиента) = Тип("ТестируемоеПолеФормы") Тогда
		Возврат ЭлементОшибкиКлиента.ПолучитьОтображаемыйТекст();
	Иначе
		Возврат Заголовок_(ЭлементОшибкиКлиента);
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Процедура ПроверитьОшибкуКлиента_()

	ТекстГлобальнойОшибки = ОшибкаКлиента_();
	Если Не ПустаяСтрока(ТекстГлобальнойОшибки) Тогда
		ВызватьИсключение ТекстГлобальнойОшибки;
	КонецЕсли;

КонецПроцедуры

// Журнал диагностический: строки с явными признаками учётных данных не выводятся.
// Пароли/токены не использовать как тестовые значения; для подобных проверок нужен отдельный секретный канал.
&НаКлиенте
Функция БезСекретов_(ТекстДляЖурнала)

	ТекстПроверкиСекретов = НРег(Строка(ТекстДляЖурнала));
	Для Каждого ПризнакСекрета Из СтрРазделить("пароль,password,token,api_key,apikey,ключapi,ключапи,authorization,bearer ,секрет,secret,/p""", ",") Цикл
		Если СтрНайти(ТекстПроверкиСекретов, ПризнакСекрета) > 0 Тогда
			Возврат "[СКРЫТО: возможные учётные данные]";
		КонецЕсли;
	КонецЦикла;
	Возврат Строка(ТекстДляЖурнала);

КонецФункции

&НаКлиенте
Функция СтрокаСписка_(Поле, Текст)

	Представление = Поле.ПолучитьПредставлениеСпискаВыбора();
	Строки = ?(ТипЗнч(Представление) = Тип("Строка"), СтрРазделить(Представление, Символы.ПС, Ложь), Представление);
	Список = Новый Массив;
	Для Каждого Элемент Из Строки Цикл
		Если ТипЗнч(Элемент) = Тип("Структура") Или ТипЗнч(Элемент) = Тип("ФиксированнаяСтруктура") Тогда
			Части = Новый Массив;
			Выбор = Неопределено;
			Для Каждого КЗ Из Элемент Цикл
				Части.Добавить(КЗ.Ключ + "=" + Строка(КЗ.Значение));
				Если Выбор = Неопределено Или КЗ.Ключ = "ОтображаемыйТекст" Тогда
					Выбор = КЗ.Значение;
				КонецЕсли;
			КонецЦикла;
			Весь = СтрСоединить(Части, ", ");
		Иначе
			Выбор = Элемент;
			Весь = Строка(Элемент);
		КонецЕсли;
		Список.Добавить(Весь);
		Если СтрНайти(НРег(Весь), НРег(Текст)) > 0 Тогда
			Возврат Выбор;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "в подсказке нет «" + Текст + "»: " + СтрСоединить(Список, "; ");

КонецФункции

// «текст» — должно содержать; «!текст» — не должно; пусто — без проверки.
&НаКлиенте
Процедура Проверить(Текст, Ожидаемое)

	Если Лев(Ожидаемое, 1) = "!" Тогда
		Если СтрНайти(НРег(Текст), НРег(Сред(Ожидаемое, 2))) > 0 Тогда
			ВызватьИсключение "«" + Текст + "» не должно содержать «" + Сред(Ожидаемое, 2) + "»";
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Ожидаемое) И СтрНайти(НРег(Текст), НРег(Ожидаемое)) = 0 Тогда
		ВызватьИсключение "«" + Текст + "», ожидалось «" + Ожидаемое + "»";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция Форма_()

	ОкноКлиента = ТП.ПолучитьАктивноеОкно();
	Если ОкноКлиента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОкноКлиента.НайтиОбъект(Тип("ТестируемаяФорма"));

КонецФункции

&НаКлиенте
Функция Заголовок_(Объект)

	Если Объект = Неопределено Тогда
		Возврат "<нет>";
	КонецЕсли;
	Попытка
		Возврат Объект.ТекстЗаголовка;
	Исключение
		Возврат "<?>";
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция Элемент_(ТипЭлемента, ИмяИлиЗаголовок)

	Форма = Форма_();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "нет активной формы";
	КонецЕсли;
	Элемент = Форма.НайтиОбъект(ТипЭлемента, , ИмяИлиЗаголовок);
	Если Элемент = Неопределено Тогда
		Элемент = Форма.НайтиОбъект(ТипЭлемента, ИмяИлиЗаголовок);
	КонецЕсли;
	Если Элемент = Неопределено Тогда
		ВызватьИсключение "на форме «" + Заголовок_(Форма) + "» нет элемента «" + ИмяИлиЗаголовок + "» (" + ТипЭлемента + ")";
	КонецЕсли;
	Возврат Элемент;

КонецФункции

&НаКлиенте
Функция Сообщения_()

	Тексты = Новый Массив;
	Для Каждого ОкноКлиента Из ТП.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
		Попытка
			Для Каждого Т Из ОкноКлиента.ПолучитьТекстыСообщенийПользователю() Цикл
				Тексты.Добавить(Т);
			КонецЦикла;
		Исключение
			// панель сообщений есть только у основного окна
		КонецПопытки;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

&НаКлиенте
Функция Состояние_()

	Строки = Новый Массив;
	Попытка
		Для Каждого ОкноКлиента Из ТП.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
			Строки.Добавить("  окно: " + Заголовок_(ОкноКлиента));
		КонецЦикла;
		Форма = Форма_();
		Строки.Добавить("  активная форма: " + Заголовок_(Форма));
		Строки.Добавить("  сообщения: " + Сообщения_());
		Строки.Добавить(ОшибкаКлиента_());
		Если Форма <> Неопределено Тогда
			Дерево(Форма, Строки, "    ", 0);
		КонецЕсли;
	Исключение
		Строки.Добавить("  состояние недоступно: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура Дерево(Объект, Строки, Отступ, Глубина)

	Если Глубина > 6 Или Строки.Количество() > 300 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Подчиненный Из Объект.ПолучитьПодчиненныеОбъекты() Цикл
		Имя = "";
		Попытка
			Имя = Подчиненный.Имя;
		Исключение
		КонецПопытки;
		Строки.Добавить(Отступ + Строка(ТипЗнч(Подчиненный)) + " " + Имя + " «" + Заголовок_(Подчиненный) + "»");
		Дерево(Подчиненный, Строки, Отступ + "  ", Глубина + 1);
	КонецЦикла;

КонецПроцедуры

// Ключ активного окна и его формы — по нему видно, что команда/закрытие отработали.
&НаКлиенте
Функция КлючОкна_()

	ОкноКлиента = ТП.ПолучитьАктивноеОкно();
	Если ОкноКлиента = Неопределено Тогда
		Возврат "<нет>";
	КонецЕсли;
	Возврат Заголовок_(ОкноКлиента) + "|" + Заголовок_(ОкноКлиента.НайтиОбъект(Тип("ТестируемаяФорма")));

КонецФункции

// Ждать смены активного окна/формы опросом каждые 0,05 с, но не дольше Предел (прежней фиксированной паузы);
// после смены — 0,1 с на дорисовку (UP, 18.10.2026: обзор — минус ~40 с фиксированных пауз).
&НаКлиенте
Процедура ЖдатьСмены_(Было, Предел)

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Предел * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
		Пауза(0.05);
		Если КлючОкна_() <> Было Тогда
			Пауза(0.1);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Паузы шагов укорочены (UP, 17.10.2026): 2 с → 0,7 с, 1 с → 0,3 с; ожидания — опросом. Цикл без сна (в клиенте
// 1С его нет) занимает одно ядро процесса менеджера — на 12 ядрах тестируемому клиенту не мешает.
&НаКлиенте
Процедура Пауза(Секунд)

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;

КонецПроцедуры

// Файлы — на сервере (файловая база: тот же компьютер); синхронные файловые вызовы клиента
// в типовой могут быть запрещены.
&НаСервереБезКонтекста
Функция ПрочитатьФайл(Путь)

	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

&НаСервереБезКонтекста
Функция ФайлЕсть(Путь)

	Файл = Новый Файл(Путь);   // метод у выражения «Новый …» не вызывается — «Неопознанный оператор»
	Возврат Файл.Существует();

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьФайл(Путь, Содержимое)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(Содержимое);
	Текст.Записать(Путь, КодировкаТекста.UTF8);

КонецПроцедуры
