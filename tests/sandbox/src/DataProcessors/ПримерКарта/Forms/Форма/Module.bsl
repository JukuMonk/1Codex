// Поле HTML и обмен с 1С БЕЗ вызова JS: 1С пишет в скрытые поля страницы,
// страница читает их по таймеру; обратно — страница пишет очередь команд в
// поле bridge_out, 1С опрашивает его обработчиком ожидания и подтверждает
// номер в out_ack. Снято с рабочего АРМ (reference/html-field-data-processor).

&НаКлиенте
Перем ДокументГотов;

&НаКлиенте
Перем СчётчикВхода;

&НаКлиенте
Перем ПоследняяКомандаОбработана;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Макет берётся у объекта обработки, а не у формы.
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Макет = ОбъектОбработки.ПолучитьМакет("СтраницаHTML");
	HTMLСтраницы = Макет.ПолучитьТекст();
	// Текстовый макет хранится построчно: длинные строки сборка режет по 900
	// символов с маркером Символ(1) в конце куска, здесь склеиваем (case 023).
	HTMLСтраницы = СтрЗаменить(HTMLСтраницы, Символ(1) + Символы.ВК + Символы.ПС, "");
	HTMLСтраницы = СтрЗаменить(HTMLСтраницы, Символ(1) + Символы.ПС, "");
	HTMLСтраницы = СтрЗаменить(HTMLСтраницы, Символ(1), "");
	Если СтрНайти(Прав(HTMLСтраницы, 40), "</html>") = 0 Тогда
		Сообщить("Макет пришёл неполным — текст обрывается не на </html>.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ДокументГотов = Ложь;
	СчётчикВхода = 0;
	ПоследняяКомандаОбработана = 0;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ОпросМоста");

КонецПроцедуры

// Раньше этого момента обращаться к Документу нельзя.
&НаКлиенте
Процедура ПолеСтраницыДокументСформирован(Элемент)

	ДокументГотов = Истина;
	// Повторяющийся обработчик: минимальный интервал — 1 секунда.
	ПодключитьОбработчикОжидания("ОпросМоста", 1);

КонецПроцедуры

// 1С → страница: текст в поле in_<тип>, метка «длина\u0001номер» в in_<тип>_sig.
&НаКлиенте
Процедура ОтправитьВСтраницу(ВидСообщения, Текст)

	Попытка
		Док = Элементы.ПолеСтраницы.Документ;
	Исключение
		Док = Неопределено;
	КонецПопытки;
	Если Док = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеДанных = Док.getElementById("in_" + ВидСообщения);
	ПолеСигнала = Док.getElementById("in_" + ВидСообщения + "_sig");
	Если ПолеДанных = Неопределено ИЛИ ПолеСигнала = Неопределено Тогда
		Сообщить("Поле обмена in_" + ВидСообщения + " не найдено в документе.");
		Возврат;
	КонецЕсли;
	СчётчикВхода = СчётчикВхода + 1;
	ПолеДанных.value = Текст;
	ПолеСигнала.value = Формат(СтрДлина(Текст), "ЧГ=0") + Символ(1) + Формат(СчётчикВхода, "ЧГ=0");

КонецПроцедуры

// Страница → 1С: очередь команд JSON в поле bridge_out; подтверждение номером в out_ack.
&НаКлиенте
Процедура ОпросМоста()

	Если НЕ ДокументГотов Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПолеВыхода = Элементы.ПолеСтраницы.Документ.getElementById("bridge_out");
	Исключение
		Возврат;
	КонецПопытки;
	Если ПолеВыхода = Неопределено ИЛИ ПустаяСтрока(ПолеВыхода.value) Тогда
		Возврат;
	КонецЕсли;
	// «Команды» — свойство управляемой формы, в него писать нельзя (case 010).
	СписокКоманд = ИзJSON(ПолеВыхода.value);
	ПоследнийНомер = ПоследняяКомандаОбработана;
	Для Каждого Команда Из СписокКоманд Цикл
		Номер = Команда["n"];
		Если ТипЗнч(Номер) = Тип("Число") И Номер <= ПоследняяКомандаОбработана Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ОбработатьКоманду(Команда["k"], Команда["d"]);
		Исключение
			Сообщить("Ошибка обработки команды " + Команда["k"] + ": " + ОписаниеОшибки());
		КонецПопытки;
		Если ТипЗнч(Номер) = Тип("Число") Тогда
			ПоследнийНомер = Номер;
		КонецЕсли;
	КонецЦикла;
	ПоследняяКомандаОбработана = ПоследнийНомер;
	ПолеПодтв = Элементы.ПолеСтраницы.Документ.getElementById("out_ack");
	Если ПолеПодтв <> Неопределено Тогда
		ПолеПодтв.value = Формат(ПоследняяКомандаОбработана, "ЧГ=0");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКоманду(Имя, Данные)

	Если Имя = "appReady" Тогда
		// Страница поднялась целиком — только теперь отправляем данные.
		ОтправитьВСтраницу("package", ПакетНаСервере());
	ИначеЕсли Имя = "select" Тогда
		ПоказатьОповещениеПользователя("Выбрано: " + Строка(Данные["ид"]));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПакетНаСервере()

	Возврат ВJSON(Новый Структура("версия", 1));

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Ложь);

КонецФункции
