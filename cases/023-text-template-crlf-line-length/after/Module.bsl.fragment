// CORRECT

	Макет = ОбъектОбработки.ПолучитьМакет("КартаHTML");
	HTMLКарты = Макет.ПолучитьТекст();

	// Макет 1С хранится построчно и очень длинных строк не переносит.
	// Сборка режет такие строки, помечая место разреза Символ(1) в конце
	// строки; здесь склеиваем обратно.
	HTMLКарты = СтрЗаменить(HTMLКарты, Символ(1) + Символы.ВК + Символы.ПС, "");
	HTMLКарты = СтрЗаменить(HTMLКарты, Символ(1) + Символы.ПС, "");
	HTMLКарты = СтрЗаменить(HTMLКарты, Символ(1), "");

	Если СтрНайти(Прав(HTMLКарты, 40), "</html>") = 0 Тогда
		СообщитьПользователю("Макет карты пришёл неполным — текст обрывается не на </html>.");
	КонецЕсли;
