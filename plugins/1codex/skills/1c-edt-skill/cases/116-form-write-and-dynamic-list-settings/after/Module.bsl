&НаКлиенте
Процедура ЗаписатьИЗакрытьКоманда(Команда)
    Если Записать() Тогда
        Закрыть();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьПорядокРасположения(Список)
    Компоновщик = Список.КомпоновщикНастроек;
    Порядки = Новый Массив;
    Порядки.Добавить(Список.Порядок);
    Порядки.Добавить(Компоновщик.Настройки.Порядок);
    Для Каждого Элемент Из Компоновщик.ПользовательскиеНастройки.Элементы Цикл
        Если ТипЗнч(Элемент) = Тип("ПорядокКомпоновкиДанных") Тогда
            Порядки.Добавить(Элемент);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Порядок Из Порядки Цикл
        Порядок.Элементы.Очистить();
        Поле = Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
        Поле.Поле = Новый ПолеКомпоновкиДанных("ПорядокВРазделе");
        Поле.Использование = Истина;
    КонецЦикла;
КонецПроцедуры
