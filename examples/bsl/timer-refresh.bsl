// Периодическое обновление формы обработчиком ожидания.
//
// Правила из боя (АРМ с полем HTML и мобильный экран водителя):
//   - подключать в ПриОткрытии (клиент), не в ПриСозданииНаСервере;
//   - обработчик — клиентский, без параметров, экспорт не нужен;
//   - пока идёт длинный серверный вызов, поле HTML продолжает принимать
//     клики, а вызовы обработчика ожидания копятся и выполняются подряд,
//     когда клиент освободится: на время записи опрос ОТКЛЮЧАТЬ и
//     включать обратно в Попытка — онемевшая форма хуже ошибки;
//   - серверный вызов обновления — «…НаСервере» без контекста, если
//     форма не нужна, иначе с контекстом; сравнивать с текущим значением
//     и не переписывать то, что не изменилось.

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ОбновитьПоТаймеру", 30, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоТаймеру()

	Если ИдётЗапись Тогда
		Возврат;
	КонецЕсли;
	Ключ = КлючСостоянияНаСервере();
	Если Ключ <> ТекущийКлюч Тогда
		ТекущийКлюч = Ключ;
		ЗаполнитьЭкранНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючСостоянияНаСервере()

	// Дешёвый признак «что-то изменилось»: последняя дата изменения, счётчик.
	Возврат Строка(ПримерОбщийМодуль.МоментПоследнегоИзменения());

КонецФункции

&НаСервере
Процедура ЗаполнитьЭкранНаСервере()

	Данные = ПримерОбщийМодуль.ДанныеЭкрана();
	ЗначениеВРеквизитФормы(Данные.Строки, "Строки");
	// Пустые поля скрываем, а не показываем пустыми (мобильный экран).
	Элементы.Комментарий.Видимость = НЕ ПустаяСтрока(Данные.Комментарий);
	Комментарий = Данные.Комментарий;

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ИдётЗапись = Истина;
	ОтключитьОбработчикОжидания("ОбновитьПоТаймеру");
	Попытка
		ЗаписатьНаСервере();
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	ИдётЗапись = Ложь;
	ПодключитьОбработчикОжидания("ОбновитьПоТаймеру", 30, Ложь);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()

	ПримерОбщийМодуль.ЗаписатьСтроки(РеквизитФормыВЗначение("Строки"));

КонецПроцедуры
