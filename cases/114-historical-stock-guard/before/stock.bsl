Процедура ПроверитьОстатки(Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Остатки.Склад КАК Склад,
	| Остатки.Товар КАК Товар,
	| Остатки.КоличествоОстаток КАК Количество
	|ИЗ РегистрНакопления.учОстаткиТоваров.Остатки КАК Остатки
	|ГДЕ Остатки.КоличествоОстаток < 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отказ = Истина;
		Сообщить(СтрШаблон("Недостаточно товара %1 на складе %2. Нехватка: %3.",
			Выборка.Товар, Выборка.Склад, -Выборка.Количество));
	КонецЦикла;

КонецПроцедуры
