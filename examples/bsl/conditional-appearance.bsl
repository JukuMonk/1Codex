// Условное оформление таблицы формы из модуля (а не из XML).
//
// В XML условное оформление формы EDT пишет длинно и с uuid; собирать
// его генератором неудобно, а из модуля — три десятка строк и никаких
// зависимостей от порядка тегов. Вызывать из ПриСозданииНаСервере.
//
// Что закрашиваем: просроченные строки красным текстом, отмеченные —
// жирным. Значения цветов — WebЦвета, шрифт — от стилевого.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастроитьОформление();

КонецПроцедуры

&НаСервере
Процедура НастроитьОформление()

	Оформление = УсловноеОформление;
	Оформление.Элементы.Очистить();

	// Просрочено: НедоступенПо < Сейчас.
	Элемент = Оформление.Элементы.Добавить();
	ОформитьТекстКрасным(Элемент);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Строки.НедоступенПо");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	Отбор.ПравоеЗначение = ТекущаяДата();
	Отбор.Использование = Истина;
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("СтрокиНедоступенПо");
	Поле.Использование = Истина;

	// Отмечено: жирный шрифт всей строки (поля не указываем — вся строка).
	Элемент = Оформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт",
		Новый Шрифт(, , Истина));
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Строки.Отметка");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Отбор.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура ОформитьТекстКрасным(Элемент)

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);

КонецПроцедуры

// Мобильная форма: цвет/шрифт у надписей проще ставить прямо в свойстве
// элемента — условное оформление там тоже работает, но одиночной надписи
// достаточно Элементы.Надпись.ЦветТекста.
&НаКлиенте
Процедура ПодсветитьНорматив(Просрочено)

	Элементы.Норматив.ЦветТекста = ?(Просрочено, WebЦвета.Красный, Новый Цвет);

КонецПроцедуры
