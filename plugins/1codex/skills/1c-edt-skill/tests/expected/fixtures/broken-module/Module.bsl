&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСтроки();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтроки()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.Наименование КАК Наименование,
		|	Элементы.Комментарий КАК По
		|ИЗ
		|	Справочник.ПримерСправочник КАК Элементы
		|ГДЕ
		|	НЕ Элементы.ПометкаУдаления
		|	И Элементы.Комментарий <> ""
		|УПОРЯДОЧИТЬ ПО
		|	Элементы.Наименование");
	Строки.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Процедура ОткрытьЭлемент(Команда)

	Строка = Элементы.Строки.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Структура("Ключ", Строка.Ссылка);
	ОткрытьФорму("Справочник.ПримерСправочник.ФормаОбъекта", Параметры, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	ОчиститьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОчиститьНаСервере()

	Для Каждого Строка Из Строки Цикл
		ОбъектЭлемента = Строка.Ссылка.ПолучитьОбъект();
		ОбъектЭлемента.Тип = Перечисления.ПримерПеречисление.ПустаяСсылка;
		ОбъектЭлемента.ОбменДаннымиЗагрузка = Истина;
		ОбъектЭлемента.Записать();
	КонецЦикла;

КонецПроцедуры
