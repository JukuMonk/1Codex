Пока Выборка.Следующий() Цикл
	Упаковка = Выборка.ВидУпаковки;
	Нагрузка = Упаковка.Нагрузка;        // запрос к базе на каждую строку
	Кантовать = Упаковка.Кантовать;      // и ещё один
	Если Упаковка.ПолучитьОбъект() = Неопределено Тогда   // «существует ли» — чтением всего объекта
		Продолжить;
	КонецЕсли;
	…
КонецЦикла;
