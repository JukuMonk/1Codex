Рамки = Новый Соответствие;                               // один раз на пересчёт
Для Каждого Зона Из Зоны Цикл
	Рамки.Вставить(Зона.Ключ, РамкаКонтура(Зона.Значение));
КонецЦикла;
Пока Выборка.Следующий() Цикл
	Для Каждого Зона Из Зоны Цикл
		Если НЕ ТочкаВРамке(Выборка.X, Выборка.Y, Рамки[Зона.Ключ]) Тогда   // четыре сравнения
			Продолжить;
		КонецЕсли;
		Если ТочкаВПолигоне(Выборка.X, Выборка.Y, Зона.Значение) Тогда
			…
		КонецЕсли;
	КонецЦикла;
КонецЦикла;

Функция ТочкаВРамке(X, Y, Рамка)
	Возврат X >= Рамка.МинX И X <= Рамка.МаксX И Y >= Рамка.МинY И Y <= Рамка.МаксY;
КонецФункции
