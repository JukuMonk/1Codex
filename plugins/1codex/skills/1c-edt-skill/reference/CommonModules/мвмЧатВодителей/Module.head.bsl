// Чат водителя с диспетчером — на типовых регистрах мобильного приложения
// УАТ: «Чаты с водителями» (сообщения) и «Статусы сообщений» (доставлено,
// прочитано). Своего регистра нет: у типовой есть и обработка «Сообщения
// мобильного приложения», и АРМ контроля перевозок — наша переписка видна
// и там.
//
// Собирается скриптом инструменты/чат_водителей.py — править здесь
// бесполезно, правка теряется при следующей сборке.

// Чат, в котором водитель переписывается с диспетчерами: свой, если заведён
// в справочнике «Список чатов», иначе общий (предопределённый).
Функция Чат(Водитель) Экспорт

	Возврат Справочники.уатЧаты.ПолучитьТекущийЧатВодителя(Водитель);

КонецФункции

// Переписка водителя за неделю, старые сверху. Колонки: Идентификатор,
// Дата, Когда, Кто, Текст, ОтДиспетчера, Прочитано.
//
// «Прочитано» — адресатом: у сообщения диспетчеру это статус чата, у
// сообщения водителю — статус водителя.
Функция Сообщения(Водитель, Сколько = 50) Экспорт

	Итог = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить(
			"Идентификатор,Дата,Когда,Кто,Текст,ОтДиспетчера,Прочитано", ",") Цикл
		Итог.Колонки.Добавить(Имя);
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Водитель) Тогда
		Возврат Итог;
	КонецЕсли;

	ЧатВодителя = Чат(Водитель);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 200
		|	Сообщения.Идентификатор КАК Идентификатор,
		|	Сообщения.Дата КАК Дата,
		|	Сообщения.ТекстСообщения КАК Текст,
		|	Сообщения.Отправитель КАК Отправитель,
		|	Сообщения.ВидСообщения КАК ВидСообщения,
		|	ЕСТЬNULL(Статусы.Прочитано, ЛОЖЬ) КАК Прочитано
		|ИЗ
		|	РегистрСведений.уатЧатыСВодителями КАК Сообщения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уатСтатусыСообщенийМобильногоПриложения КАК Статусы
		|		ПО Статусы.Идентификатор = Сообщения.Идентификатор
		|			И (Статусы.Получатель = &Водитель
		|				ИЛИ Статусы.Получатель = &Чат)
		|ГДЕ
		|	Сообщения.Чат = &Чат
		|	И Сообщения.Дата >= &Порог
		|	И (Сообщения.Отправитель = &Водитель
		|		ИЛИ Сообщения.ВидСообщения = ЗНАЧЕНИЕ(Перечисление.уатВидыСообщенийМобильногоПриложения.Исходящее))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ");
	Запрос.УстановитьПараметр("Водитель", Водитель);
	Запрос.УстановитьПараметр("Чат", ЧатВодителя);
	Запрос.УстановитьПараметр("Порог", НачалоДня(ТекущаяДатаСеанса()) - 7 * 86400);

	// Свежие первыми выбрали, чтобы отрезать хвост, а показываем старые
	// сверху — как в любом чате.
	Список = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() И Список.Количество() < Сколько Цикл
		Список.Добавить(Новый Структура(
			"Идентификатор,Дата,Текст,Отправитель,ВидСообщения,Прочитано",
			Выборка.Идентификатор, Выборка.Дата, Выборка.Текст, Выборка.Отправитель,
			Выборка.ВидСообщения, Выборка.Прочитано));
	КонецЦикла;

	Для Сдвиг = 0 По Список.ВГраница() Цикл
		Запись = Список[Список.ВГраница() - Сдвиг];
		Строка = Итог.Добавить();
		Строка.Идентификатор = Запись.Идентификатор;
		Строка.Дата = Запись.Дата;
		Строка.Когда = КогдаСловами(Запись.Дата);
		Строка.Текст = Запись.Текст;
		Строка.ОтДиспетчера = (Запись.ВидСообщения
			<> Перечисления.уатВидыСообщенийМобильногоПриложения.Входящее);
