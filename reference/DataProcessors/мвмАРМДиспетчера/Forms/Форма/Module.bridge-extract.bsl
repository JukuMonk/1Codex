///////////////////////////////////////////////////////////////////////////////
// ВНЕШНЯЯ ОБРАБОТКА «Карта внутризаводской логистики»
// Модуль формы. Тонкий клиент. Транспорт: скрытые поля + опрос.
//
// ЧТО НУЖНО В КОНФИГУРАТОРЕ:
//   Реквизит формы   HTMLКарты : Строка (неограниченная длина)
//   Элемент формы    ПолеКарты : Поле HTML документа, данные = HTMLКарты
//                                событие ДокументСформирован = ПолеКартыДокументСформирован
//   Макет            КартаHTML : Текстовый документ  (сюда кладётся genplan-1c.html)
//   Макет            Подложка  : Двоичные данные     (сюда кладётся genplan-podlozhka.png)
//
//   Макет карты берём именно Текстовым документом (или двоичными данными):
//   макет типа «HTML документ» платформа может переформатировать.
//
// ПЕРЕД ВНЕДРЕНИЕМ ПРОВЕРИТЬ ДВИЖОК ПОЛЯ HTML.
//   Карта написана на современном JavaScript. Если поле работает на старом
//   движке (MSHTML / Internet Explorer), она не запустится. Мост это увидит
//   сам и сообщит в команде ready полем движокES6 = Ложь — см. ОбработатьКоманду.
///////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Перем ОкноКарты;          // объект window внутри поля HTML

&НаКлиенте
Перем МостJS;             // объект Bridge внутри страницы

&НаКлиенте
Перем ДокументГотов;      // страница сформирована

&НаКлиенте
Перем РазмерПорции;       // символов в одной порции обмена

&НаКлиенте
Перем СчётчикВхода;       // сквозной номер сообщения 1С -> карта

&НаКлиенте
Перем ПоследняяКомандаОбработана;  // номер последней обработанной исходящей команды

&НаКлиенте
Перем ПустыхОпросов;      // подряд идущих опросов без данных — сторож тишины

#Область СозданиеИОткрытие

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Во внешней обработке макет берётся у объекта обработки,
	// а не напрямую у формы.
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Макет = ОбъектОбработки.ПолучитьМакет("КартаHTML");
	HTMLКарты = Макет.ПолучитьТекст();

	// Макет 1С хранится построчно и очень длинных строк не переносит:
	// в типовой конфигурации самая длинная строка макета — 2970 символов,
	// а в карте одна строка (минифицированный Leaflet) была 147 363.
	// Сборка режет такие строки, помечая место разреза Символ(1) в конце
	// строки; здесь склеиваем обратно.
	HTMLКарты = СтрЗаменить(HTMLКарты, Символ(1) + Символы.ВК + Символы.ПС, "");
	HTMLКарты = СтрЗаменить(HTMLКарты, Символ(1) + Символы.ПС, "");
	HTMLКарты = СтрЗаменить(HTMLКарты, Символ(1), "");

	// Размер карты в окно сообщений не пишем: диспетчеру он ничего не
	// говорит, а всплывает при каждом открытии АРМ. Проверка ниже важнее
	// и молчит, пока макет пришёл целиком.
	Если СтрНайти(Прав(HTMLКарты, 40), "</html>") = 0 Тогда
		СообщитьПользователю("Макет карты пришёл неполным — текст обрывается не на </html>.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДокументГотов = Ложь;
	СчётчикВхода  = 0;
	ПоследняяКомандаОбработана = 0;
	РазмерПорции  = 100000;   // 100 тыс. символов на порцию — безопасно для COM
	ПустыхОпросов = 0;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОтключитьОбработчикОжидания("ОпросМоста");
КонецПроцедуры

// Событие ДокументСформирован элемента ПолеКарты.
// Раньше этого момента обращаться к Документу нельзя.
&НаКлиенте
Процедура ПолеКартыДокументСформирован(Элемент)

	ДокументГотов = Истина;
	ОкноКарты     = Неопределено;
	МостJS        = Неопределено;
	ПустыхОпросов = 0;

	// Осмотр — отложенный: на ДокументСформирован страница ещё разбирается
	// (замер показал «готовность:loading, элементов:24»), и мерить нечего.
	ПодключитьОбработчикОжидания("ОсмотретьСтраницу", 3, Истина);

	// Опрос очереди команд от карты.
	// Для повторяющегося обработчика минимальный интервал — 1 секунда.
	// Если понадобится более быстрая реакция, есть приём: подключать
	// однократный обработчик с долей секунды и перевзводить его в конце
	// ОпросМоста. Минус приёма — цепочка рвётся при любом исключении,
	// поэтому по умолчанию оставлен обычный повторяющийся опрос.
	ПодключитьОбработчикОжидания("ОпросМоста", 1);

КонецПроцедуры

// Что на самом деле доехало до поля HTML.
//
// Пустой экран при живых полях обмена мы уже ловили, и вслепую это не
// лечится: страница может прийти обрезанной, а может целиком, но упасть
// на первом же скрипте. Здесь разделяем эти два случая.
//
// Сбои JS читаются из поля js_errors, а не из массива window.__bridgeErrors:
// value поля 1С читает надёжно, свойства JS-объектов — как повезёт.
&НаКлиенте
Процедура ОсмотретьСтраницу()

	Попытка
		Док = Элементы.ПолеКарты.Документ;
		Всего = Док.getElementsByTagName("*").length;
		// Контейнера нет — страница пришла обрезанной или не той:
		// единственный случай, когда цифры осмотра стоит показать.
		Если Док.getElementById("map") = Неопределено Тогда
			СообщитьПользователю("Карта не поднялась: контейнер не найден."
				+ " Отправлено " + СтрДлина(HTMLКарты) + " символов,"
				+ " элементов в документе " + Всего + ".");
		КонецЕсли;
	Исключение
		СообщитьПользователю("Не удалось осмотреть документ карты: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Попытка
		Поле = Док.getElementById("js_errors");
		Если Поле = Неопределено Тогда
			СообщитьПользователю("Поле js_errors не найдено — сборка карты старая.");
			Возврат;
		КонецЕсли;
		Сбои = СокрЛП(Строка(Поле.value));
	Исключение
		СообщитьПользователю("Не удалось прочитать js_errors: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Поле состояния карта переписывает раз в полсекунды. Пустое оно только
	// в одном случае — скрипты страницы вообще не выполнялись.
	Если ПустаяСтрока(Сбои) Тогда
		СообщитьПользователю("Скрипты карты не выполнялись: поле состояния пустое.");
	ИначеЕсли СтрНайти(Сбои, "СБОИ:") > 0 Тогда
		// Обычное состояние («js:7 готовность:complete …») не показываем:
		// оно означает, что всё хорошо, а хорошее не нуждается в отчёте.
		ДляПоказа = ?(СтрДлина(Сбои) > 700, Лев(Сбои, 700) + " …", Сбои);
		СообщитьПользователю("Карта — " + ДляПоказа);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ТранспортМоста

// Возвращает объект Bridge внутри страницы (кэшируется).
&НаКлиенте
Функция ПолучитьМост()

	Если МостJS <> Неопределено Тогда
		Возврат МостJS;
	КонецЕсли;

	Если НЕ ДокументГотов Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Документ = Элементы.ПолеКарты.Документ;

		// Chromium отдаёт defaultView, MSHTML — parentWindow.
		Окно = Документ.defaultView;
		Если Окно = Неопределено Тогда
			Окно = Документ.parentWindow;
		КонецЕсли;

		ОкноКарты = Окно;
		МостJS    = Окно.Bridge;
	Исключение
		МостJS = Неопределено;
	КонецПопытки;

	Возврат МостJS;

КонецФункции

// Отправка данных в карту. Длинные строки уходят порциями:
// 1С кладёт порцию в скрытое поле и зовёт Bridge.receive.
&НаКлиенте
Процедура ОтправитьВКарту(ВидСообщения, ТекстСообщения)

	// 1С -> карта БЕЗ вызова JS: кладём весь текст в поле in_<тип>, а метку
	// "длина\u0001seq" в in_<тип>_sig. Мост опрашивает эти поля и забирает
	// данные. Разные поля на тип — чтобы подложка и пакет (оба на appReady)
	// не затирали друг друга.
	Попытка
		Док = Элементы.ПолеКарты.Документ;
	Исключение
		Док = Неопределено;
	КонецПопытки;
	Если Док = Неопределено Тогда
		СообщитьПользователю("Нет доступа к документу HTML-поля."); 
		Возврат;
	КонецЕсли;

	ПолеДанных  = Док.getElementById("in_" + ВидСообщения);
	ПолеСигнала = Док.getElementById("in_" + ВидСообщения + "_sig");
	Если ПолеДанных = Неопределено ИЛИ ПолеСигнала = Неопределено Тогда
		СообщитьПользователю("Поле обмена in_" + ВидСообщения + " не найдено в документе карты.");
		Возврат;
	КонецЕсли;

	Если СчётчикВхода = Неопределено Тогда
		СчётчикВхода = 0;
	КонецЕсли;
	СчётчикВхода = СчётчикВхода + 1;
	Попытка
		ПолеДанных.value  = ТекстСообщения;
		ПолеСигнала.value = Формат(СтрДлина(ТекстСообщения), "ЧГ=0") + Символ(1) + Формат(СчётчикВхода, "ЧГ=0");
	Исключение
		СообщитьПользователю("Ошибка записи данных в поле in_" + ВидСообщения + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Чтение крупной выгрузки из карты кусками — надёжнее, чем тянуть
// мегабайтную строку одним обращением.
&НаКлиенте
Функция ПрочитатьКрупныеДанные(Размер)

	// Читаем пакет напрямую из DOM-поля bridge_data — БЕЗ вызова JS.
	// Мост.slice в этой связке (V8WebKit+1С) недоступен, как и все JS-вызовы;
	// но value поля 1С читает так же, как читает очередь из bridge_out.
	Попытка
		Поле = Элементы.ПолеКарты.Документ.getElementById("bridge_data");
	Исключение
		Поле = Неопределено;
	КонецПопытки;
	Если Поле = Неопределено Тогда
		СообщитьПользователю("Не удалось прочитать данные из карты: поле bridge_data не найдено.");
		Возврат "";
	КонецЕсли;

	Данные = Строка(Поле.value);

	// Если карта сообщила размер, а пришло меньше — данные обрезаны.
	Если Размер > 0 И СтрДлина(Данные) < Размер Тогда
		СообщитьПользователю("Данные из карты пришли не полностью: " + СтрДлина(Данные)
			+ " из " + Размер + " символов. Запись отменена.");
		Возврат "";
	КонецЕсли;

	Поле.value = "";   // освобождаем поле после чтения
	Возврат Данные;

КонецФункции

// Опрос очереди команд. Читаем — обрабатываем — подтверждаем.
// Подтверждение по номеру команды: то, что карта добавила между чтением
// и подтверждением, останется в очереди и приедет следующим опросом.
// Пауза и возобновление опроса моста на время долгой работы.
//
// Период тот же, что при запуске: одна секунда. Держим его здесь
// рядом, чтобы возобновление не разошлось с подключением.
&НаКлиенте
Процедура ПаузаОпросаМоста()
	ОтключитьОбработчикОжидания("ОпросМоста");
КонецПроцедуры

&НаКлиенте
Процедура ВозобновитьОпросМоста()
	ПодключитьОбработчикОжидания("ОпросМоста", 1);
КонецПроцедуры

&НаКлиенте
Процедура ОпросМоста()

	Если НЕ ДокументГотов Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПолеВыхода = Элементы.ПолеКарты.Документ.getElementById("bridge_out");
	Исключение
		Возврат;
	КонецПопытки;

	Если ПолеВыхода = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Текст = ПолеВыхода.value;
	Если ПустаяСтрока(Текст) Тогда
		// Пустая очередь ПОСЛЕ успешного старта — норма: команды обработаны и
		// подтверждены через out_ack, поле очищено. Тишину подозреваем только
		// пока не пришло НИ ОДНОЙ команды — тогда карта действительно молчит.
		Если ПоследняяКомандаОбработана = Неопределено ИЛИ ПоследняяКомандаОбработана = 0 Тогда
			ПустыхОпросов = ПустыхОпросов + 1;
			Если ПустыхОпросов = 10 Тогда           // ~10 секунд при периоде 1 с
				ПоказатьПричинуТишины();
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПустыхОпросов = 0;

	// «Команды» — свойство управляемой формы, в него писать нельзя.
	СписокКоманд = ИзJSON(Текст);
	Если СписокКоманд = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПоследняяКомандаОбработана = Неопределено Тогда
		ПоследняяКомандаОбработана = 0;
	КонецЕсли;

	// Подтверждение обработки идёт через DOM (out_ack), а не вызовом JS —
	// поэтому в очереди могут оставаться уже обработанные команды. Берём
	// только новые по номеру, иначе appReady шлётся заново каждый опрос.
	ПоследнийНомер = ПоследняяКомандаОбработана;
	Для Каждого Команда Из СписокКоманд Цикл
		Номер = Команда["n"];
		Если ТипЗнч(Номер) = Тип("Число") И Номер <= ПоследняяКомандаОбработана Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ОбработатьКоманду(Команда["k"], Команда["d"]);
		Исключение
			СообщитьПользователю("Ошибка обработки команды " + Команда["k"] + ": "
				+ ОписаниеОшибки());
		КонецПопытки;
		Если ТипЗнч(Номер) = Тип("Число") Тогда
			ПоследнийНомер = Номер;
		КонецЕсли;
	КонецЦикла;

	ПоследняяКомандаОбработана = ПоследнийНомер;

	// Пишем номер подтверждения в поле — мост прочитает и очистит очередь.
	Попытка
		ПолеПодтв = Элементы.ПолеКарты.Документ.getElementById("out_ack");
		Если ПолеПодтв <> Неопределено Тогда
			ПолеПодтв.value = Формат(ПоследняяКомандаОбработана, "ЧГ=0");
		КонецЕсли;
	Исключение
		// подтверждение не критично для отрисовки — молчим
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаКоманд

&НаКлиенте
Процедура ОбработатьКоманду(Имя, Данные)

	Если Имя = "ready" Тогда

		// Рукопожатие моста. Приходит сразу при загрузке страницы, ДО кода
		// карты — по нему видно, что связь есть. Данные слать ещё рано:
		// ждём appReady, иначе они уйдут в неподнявшуюся карту.
		Если Данные <> Неопределено И Данные["движокES6"] = Ложь Тогда
			СообщитьПользователю("Поле HTML работает на устаревшем движке —
				|карта не запустится. Требуется поддержка современного JavaScript
				|(см. проверку движка в инструкции по внедрению).");
		КонецЕсли;

	ИначеЕсли Имя = "appReady" Тогда

		// Карта поднялась целиком — только теперь отправляем данные.
		ОтправитьПодложку();
		ОтправитьПакет();

	ИначеЕсли Имя = "bootFailed" Тогда

		// Мост жив, а карта не запустилась. Показываем причину.
		Текст = "Карта не запустилась.";
		Если Данные["движокES6"] = Ложь Тогда
			Текст = Текст + Символы.ПС + "Причина: движок поля HTML не поддерживает современный JavaScript.";
		КонецЕсли;
		Ошибки = Данные["ошибки"];
		Если Ошибки <> Неопределено Тогда
			Для Каждого Ошибка Из Ошибки Цикл
				Текст = Текст + Символы.ПС + "Ошибка JS: " + Ошибка;
			КонецЦикла;
		КонецЕсли;
		СообщитьПользователю(Текст);

	ИначеЕсли Имя = "saveMap" Тогда

		// Карта подготовила полный пакет — забираем и пишем в справочники.
		//
		// Опрос моста на это время выключаем: запись идёт долгим серверным
		// вызовом, вызовы обработчика ожидания за это время копятся и
		// выполняются подряд, когда клиент освободится. Вместе с ними —
		// всё, что успел натыкать пользователь; на таком щелчке по карте
		// его уже выбрасывало из 1С.
		ПаузаОпросаМоста();
		Попытка
			ПакетJSON = ПрочитатьКрупныеДанные(Данные["размер"]);
			Идентификаторы = ЗаписатьКартуНаСервере(ПакетJSON);
			ОтправитьВКарту("ids", Идентификаторы);
		Исключение
			// Мост поднимаем в любом случае: онемевшая карта хуже ошибки —
			// про ошибку хотя бы написано в сообщениях.
			ВозобновитьОпросМоста();
			ВызватьИсключение;
		КонецПопытки;
		ВозобновитьОпросМоста();

	ИначеЕсли Имя = "route" Тогда

		// Расчёт маршрута для документа должен жить в 1С: он нужен и без
		// открытой формы (проведение заявки, фоновое задание, отчёт).
		Ответ = РассчитатьМаршрутНаСервере(Данные);
		ОтправитьВКарту("route", Ответ);

	ИначеЕсли Имя = "open" Тогда

		// Диспетчер просит открыть документ, на который смотрит.
		ОткрытьДокумент(Данные);

	ИначеЕсли Имя = "select" Тогда

		// Выбор объекта на карте — можно подсветить связанные документы.
		// ТекущийУзел = Данные["узел"];

	ИначеЕсли Имя = "demoData" Тогда

		// Демонстрационный набор для проверки АРМ. Собирает его общий модуль:
		// данные ложатся в справочники, а не в браузер, и переживают перезапуск.
		Попытка
			СообщитьПользователю(СформироватьДемоДанные());
		Исключение
			СообщитьПользователю("Демо-данные не созданы: " + ОписаниеОшибки());
		КонецПопытки;
		// Карта должна увидеть созданное сразу.
		ОтправитьПакет();

	ИначеЕсли Имя = "setting" Тогда

		// Одна настройка без записи графа: диспетчер двигает ползунок,
		// а не переписывает план завода.
		КлючНастройки = Данные["ключ"];
		Если НЕ ПустаяСтрока(КлючНастройки) Тогда
			СохранитьНастройкуНаСервере(КлючНастройки,
				Строка(Данные["значение"]));
		КонецЕсли;

	ИначеЕсли Имя = "reload" Тогда

		// Карта просит прислать данные заново (например, после выключения демо).
		ОтправитьПакет();

	ИначеЕсли Имя = "error" Тогда

		СообщитьПользователю("Карта сообщила об ошибке: " + Данные["message"]);

	ИначеЕсли Имя = "assign" Тогда

		// Диспетчер назначил машину: создаём Маршрутный лист.
		ОтправитьВКарту("message", НазначитьРейс(Данные));
		// Следом оперативка: очередь и рейсы должны обновиться сразу,
		// иначе диспетчер второй раз назначит ту же заявку. Граф от
		// назначения не меняется — целиком пакет не пересобираем.
		ОтправитьОперативку();

	ИначеЕсли Имя = "autoAssign" Тогда

		// Автоназначение: раздать очередь по свободным машинам.
		ОтправитьВКарту("message", АвтоНазначить(Данные));
		ОтправитьОперативку();

	ИначеЕсли Имя = "vehicleHold" Тогда

		// Блокировка машины: причину и срок спрашивает форма 1С,
		// снятие делается сразу — это одно действие без вопросов.
		Если Данные["окно"] = Истина Тогда
			ОткрытьФормуПростоя(Данные);
		Иначе
			ОтправитьВКарту("message", ОтметитьНедоступность(Данные));
			ОтправитьОперативку();
		КонецЕсли;

	ИначеЕсли Имя = "reject" Тогда

		// Отклонение заявки с причиной: дубль, не транспортная работа.
		ОтправитьВКарту("message", ОтклонитьЗаявку(Данные));
		ОтправитьОперативку();

	ИначеЕсли Имя = "reassign" Тогда

		// Снять лист и отдать заявку другой машине — одним действием.
		ОтправитьВКарту("message", ПереназначитьРейс(Данные));
		ОтправитьОперативку();

	ИначеЕсли Имя = "tripStatus" Тогда

		// Отметка выезда, прибытия или отмены назначения.
		ОтправитьВКарту("message", ОтметитьРейс(Данные));
		ОтправитьОперативку();

	ИначеЕсли Имя = "chatSend" Тогда

		// Диспетчер написал водителю. Сообщение ложится в типовой
		// чат мобильного приложения; экран водителя подхватит его
		// сам, в ближайшую минуту.
		ОтправитьВКарту("message", НаписатьВодителю(Данные));
		ОтправитьОперативку();

	ИначеЕсли Имя = "chatRead" Тогда

		// Диспетчер открыл переписку: сообщения водителя прочитаны.
		ПрочитатьЧатВодителя(Данные);
		ОтправитьОперативку();

	КонецЕсли;

КонецПроцедуры

// Вызывается, если карта долго молчит. Разделяет три разные причины,
// которые со стороны 1С выглядят одинаково — «пустое поле обмена».
&НаКлиенте
Процедура ПоказатьПричинуТишины()
	// Карта за 10 секунд не прислала ни одной команды в bridge_out. Обмен
	// идёт через DOM-поля (объект Bridge для этого не нужен), поэтому тишина
	// означает, что страница просто не выполнила скрипты.
	СообщитьПользователю("Карта не отвечает: за 10 секунд не пришло ни одной команды.
		|Вероятные причины:
		| — макет «КартаHTML» вставлен не полностью или не как «Текстовый документ»;
		| — поле HTML не выполняет скрипты (устаревший движок);
		| — HTML-поле формы имеет нулевой размер.
		|Проверьте, что в макете «КартаHTML» лежит весь файл целиком.");
КонецПроцедуры

#КонецОбласти