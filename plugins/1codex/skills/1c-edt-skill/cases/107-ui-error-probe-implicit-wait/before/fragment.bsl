// WRONG: отсутствующие ErrorInfo ищутся при каждом шаге во всех окнах.
// НайтиОбъект не является бесплатной проверкой наличия: он может ожидать элемент.
Для Каждого ОкноТП Из ТП.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
	ОшибкаТП = ОкноТП.НайтиОбъект(Тип("ТестируемаяДекорацияФормы"), , "ErrorInfo");
	Если ОшибкаТП = Неопределено Тогда
		ОшибкаТП = ОкноТП.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "ErrorInfo");
	КонецЕсли;
КонецЦикла;
