// UP, ДиЗ-07: форма элемента «Сценарии работы» (черновик) и «Версии структуры объектов» (маппинг), 8.5.1

&НаСервереБезКонтекста
Функция КлючЧерновика(Реквизит, ВидПункта, ИсторияПользователя)

	Возврат ЗначениеВСтрокуВнутр(Реквизит) + ?(ИсторияПользователя, "", "|" + ЗначениеВСтрокуВнутр(ВидПункта));

КонецФункции

&НаСервере
Функция ЗаполнитьИзВерсииНаСервере(Строки = "изменяемые")

	// один реквизит бывает в версии несколько раз (шапка и табличные части «… ОР», «… ТОР») — черновик
	// пропускает столько его строк, сколько шагов с ним уже было ДО черновика, остальные добавляет
	ИсторияПользователя = Объект.ТипСценария = Перечисления.ТипыСценариев.ПользовательскаяИстория;
	Было = Новый Соответствие;
	Для Каждого Шаг Из Объект.Шаги Цикл
		Ключ = КлючЧерновика(Шаг.Реквизит, Шаг.ВидПункта, ИсторияПользователя);
		Было.Вставить(Ключ, ?(Было[Ключ] = Неопределено, 0, Было[Ключ]) + 1);
	КонецЦикла;
	Добавлено = 0;
	Для Каждого Черновик Из МетодологТЗ.ШагиИзВерсииСтруктуры(Объект.ВерсияСтруктуры, Объект.ТипСценария, Строки) Цикл
		Ключ = КлючЧерновика(Черновик.Реквизит, Черновик.ВидПункта, ИсторияПользователя);
		Если Было[Ключ] <> Неопределено И Было[Ключ] > 0 Тогда
			Было.Вставить(Ключ, Было[Ключ] - 1);
			Продолжить;
		КонецЕсли;
		НовыйШаг = Объект.Шаги.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйШаг, Черновик);
		Добавлено = Добавлено + 1;
	КонецЦикла;
	Если Добавлено > 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;
	Возврат Добавлено;

КонецФункции

// маппинг: ключ — версия + реквизит + табличная часть (колонка «Табл. часть» добавлена в ТЧ Маппинг)
//	Ключ = ЗначениеВСтрокуВнутр(Сторона.Версия) + ЗначениеВСтрокуВнутр(СтрокаВерсии.Реквизит) + "|"
//		+ СтрокаВерсии.ТабличнаяЧасть;

&НаСервереБезКонтекста
Функция РеквизитыВерсииПоТексту(Версия, Текст)

	// реквизит один раз, в скобках — все места в версии (шапка, табличные части «… ОР», «… ТОР»)
	Список = Новый СписокЗначений;
	Места = Новый Соответствие;
	Искомое = НРег(СокрЛП(Текст));
	Для Каждого СтрокаВерсии Из Версия.Реквизиты Цикл
		Если Не ЗначениеЗаполнено(СтрокаВерсии.Реквизит) Или СтрНайти(НРег(Строка(СтрокаВерсии.Реквизит)), Искомое) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Места[СтрокаВерсии.Реквизит] = Неопределено Тогда
			Места.Вставить(СтрокаВерсии.Реквизит, Новый Массив);
			Список.Добавить(СтрокаВерсии.Реквизит);
		КонецЕсли;
		Место = ?(ПустаяСтрока(СтрокаВерсии.ТабличнаяЧасть), "шапка", СтрокаВерсии.ТабличнаяЧасть);
		Если Места[СтрокаВерсии.Реквизит].Найти(Место) = Неопределено Тогда
			Места[СтрокаВерсии.Реквизит].Добавить(Место);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Список Цикл
		Элемент.Представление = Строка(Элемент.Значение) + " (" + СтрСоединить(Места[Элемент.Значение], ", ") + ")";
	КонецЦикла;
	Возврат Список;

КонецФункции
