// CORRECT

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КИ.Ссылка КАК Лицо,
		|	КИ.НомерТелефона КАК Номер
		|ИЗ
		|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК КИ
		|УПОРЯДОЧИТЬ ПО
		|	КИ.Ссылка");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Пустые номера отсеиваем ЗДЕСЬ, а не условием запроса: пустая
		// строка внутри строкового литерала BSL требует удвоенных кавычек.
		Если ПустаяСтрока(Выборка.Номер) Тогда
			Продолжить;
		КонецЕсли;
