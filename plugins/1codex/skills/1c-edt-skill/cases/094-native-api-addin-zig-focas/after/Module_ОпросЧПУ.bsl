// Прямой опрос станков с ЧПУ из 1С (итерация 15), без промежуточных узлов: и опрос, и компонента — в процессе
// сервера 1С. Узел сбора данных с адресом focas://<IP ЧПУ>:<порт> — один станок FANUC (реквизит «Оборудование»).
// Внешняя компонента (общий макет пульс_КомпонентаЧПУ; исходник и сборка — инструменты/компонента) читает ЧПУ по
// FOCAS через библиотеку FANUC заказчика (константа пульс_ПутьБиблиотекиFOCAS) и только ЧИТАЕТ — в ЧПУ не пишет.
// Этот модуль пишет показания в сырую телеметрию (каналы «FOCAS/…»): изменение — сразу, без изменений — не реже
// раза в ПульсСекунд(); состояния считает тот же классификатор по каналу «Работа»:
//   2 — идёт программа (run = STaRT), 1 — ЧПУ на связи, программа не идёт (стоп, пауза, сброс, авария).
// Нет ответа ЧПУ — записей нет, и через ТаймаутOFFLINE состояние OFFLINE, а не OFF (ТЗ §19): выключенный станок
// и обрыв сети по FOCAS неразличимы.

#Область ПрограммныйИнтерфейс

// Узел сбора данных — станок с ЧПУ (адрес focas://…).
//
// Параметры:
//  Узел - СправочникСсылка.пульс_УзлыСбораДанных
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоУзелЧПУ(Узел) Экспорт

	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНачинаетсяС(НРег(СокрЛП(Узел.БазовыйURL)), ПрефиксАдреса());

КонецФункции

// Начало адреса узла ЧПУ (для отбора в запросах: ПОДОБНО "focas://%").
//
// Возвращаемое значение:
//  Строка
//
Функция ПрефиксАдреса() Экспорт

	Возврат "focas://";

КонецФункции

// Адрес узла ЧПУ → IP и порт.
//
// Параметры:
//  АдресУзла - Строка - focas://<адрес>[:<порт>]; порт по умолчанию — 8193 (FOCAS по Ethernet).
//
// Возвращаемое значение:
//  Структура, Неопределено - Адрес (Строка), Порт (Число); Неопределено — адрес не ЧПУ или пустой.
//
Функция РазобратьАдрес(АдресУзла) Экспорт

	Адрес = СокрЛП(АдресУзла);
	Если Не СтрНачинаетсяС(НРег(Адрес), ПрефиксАдреса()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Адрес = Сред(Адрес, СтрДлина(ПрефиксАдреса()) + 1);
	Если СтрЗаканчиваетсяНа(Адрес, "/") Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;
	Порт = 8193;
	Двоеточие = СтрНайти(Адрес, ":", НаправлениеПоиска.СКонца);
	Если Двоеточие > 0 Тогда
		ТекстПорта = Сред(Адрес, Двоеточие + 1);
		Адрес = Лев(Адрес, Двоеточие - 1);
		Попытка
			Порт = Число(ТекстПорта);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Или Порт <= 0 Или Порт > 65535 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Адрес, Порт", Адрес, Порт);

КонецФункции

// Каналы узла ЧПУ: что из ответа компоненты пишется в сырую телеметрию.
//
// Возвращаемое значение:
//  Массив из Структура - Control (Строка), Поле (Строка — поле ответа компоненты; «Работа», «Авария» —
//                        вычисляются), ТипПараметра (Строка — имя пульс_ТипыПараметровТелеметрии), Единица (Строка),
//                        ДляСостояния (Булево).
//
Функция КаналыЧПУ() Экспорт

	Каналы = Новый Массив;
	Добавить = Новый Структура("Control, Поле, ТипПараметра, Единица, ДляСостояния");
	Для Каждого Описание Из СтрРазделить(
		"Работа|*работа|Произвольный||1;"
		+ "Выполнение|run|Произвольный||0;"
		+ "Режим|aut|Произвольный||0;"
		+ "Авария|*авария|Авария||0;"
		+ "Программа|onum|Произвольный||0;"
		+ "Обороты шпинделя|speed|Обороты|об/мин|0;"
		+ "Подача|feed|Произвольный|мм/мин|0;"
		+ "Нагрузка шпинделя|load|Нагрузка|%|0;"
		+ "Детали|parts|Произвольный|шт|0", ";") Цикл
		Части = СтрРазделить(Описание, "|", Истина);
		Канал = Новый Структура("Control, Поле, ТипПараметра, Единица, ДляСостояния",
			Части[0], Части[1], Части[2], Части[3], Части[4] = "1");
		Каналы.Добавить(Канал);
	КонецЦикла;
	Возврат Каналы;

КонецФункции

// Каналы узла ЧПУ на его станок: находит или создаёт (повтор не создаёт дублей); если у станка нет канала
// состояния или он с этого же узла — настройки мониторинга по каналу «Работа» (пороги 0,5 / 1,5 / 1,4 и таймаут OFFLINE).
//
// Параметры:
//  Узел - СправочникСсылка.пульс_УзлыСбораДанных - узел ЧПУ с заполненным «Оборудование».
//
// Возвращаемое значение:
//  Структура - Каналы (Соответствие: Control → СправочникСсылка.пульс_КаналыТелеметрии), Создано (Число),
//              НастройкиЗаданы (Булево), Текст (Строка).
//
Функция СоздатьКаналы(Узел) Экспорт

	Оборудование = Узел.Оборудование;
	Если Не ЗначениеЗаполнено(Оборудование) Тогда
		ВызватьИсключение СтрШаблон("У узла ЧПУ «%1» не указан станок (реквизит «Станок (узел ЧПУ)»).", Узел);
	КонецЕсли;
	Итог = Новый Структура("Каналы, Создано, НастройкиЗаданы, Текст", Новый Соответствие, 0, Ложь, "");
	Для Каждого Описание Из КаналыЧПУ() Цикл
		Привязка = пульс_Сервис.ПривязатьФизическийКанал(Узел, УстройствоFOCAS(), Описание.Control, Оборудование, ,
			Перечисления.пульс_ТипыПараметровТелеметрии[Описание.ТипПараметра], Описание.Единица);
		Канал = Привязка.Ссылка;
		Если Канал.ИспользоватьДляОпределенияСостояния <> Описание.ДляСостояния Или Не Канал.Активно Тогда
			Объект = Канал.ПолучитьОбъект();
			Объект.ИспользоватьДляОпределенияСостояния = Описание.ДляСостояния;
			Объект.Активно = Истина;
			Объект.Записать();
		КонецЕсли;
		Итог.Каналы.Вставить(Описание.Control, Канал);
		Итог.Создано = Итог.Создано + ?(Привязка.Создан, 1, 0);
	КонецЦикла;

	КаналРаботы = Итог.Каналы.Получить("Работа");
	Менеджер = РегистрыСведений.пульс_НастройкиМониторинга.СоздатьМенеджерЗаписи();
	Менеджер.Оборудование = Оборудование;
	Менеджер.Прочитать();
	Новая = Не Менеджер.Выбран();
	Если Новая Или Не ЗначениеЗаполнено(Менеджер.ОсновнойКаналТока)
		Или Менеджер.ОсновнойКаналТока.УзелСбораДанных = Узел Тогда
		Менеджер.Оборудование = Оборудование;
		Менеджер.ОсновнойКаналТока = КаналРаботы;
		Менеджер.ПорогOFF = 0.5;
		Менеджер.ПорогWORKВход = 1.5;
		Менеджер.ПорогWORKВыход = 1.4; // классификатору нужен гистерезис: выход строго ниже входа (значения 1 и 2)
		Менеджер.ПорогOVERLOAD = 0;
		Менеджер.ВремяПодтвержденияOFF = 0;
		Менеджер.ВремяПодтвержденияWORK = 0;
		Менеджер.ВремяПодтвержденияIDLE = 0;
		Менеджер.ВремяПодтвержденияOVERLOAD = 0;
		Менеджер.ТаймаутOFFLINE = ТаймаутOFFLINE();
		Если Новая Тогда
			Менеджер.УчитыватьWORKВНаработке = Истина;
		КонецЕсли;
		Менеджер.Записать();
		Итог.НастройкиЗаданы = Истина;
	КонецЕсли;
	Итог.Текст = СтрШаблон("Каналы ЧПУ станка «%1»: %2, новых %3.", Оборудование, Итог.Каналы.Количество(), Итог.Создано)
		+ ?(Итог.НастройкиЗаданы, " Состояние — по каналу «Работа» (идёт программа — работа).",
			" Состояние станка определяет другой канал (" + Строка(Менеджер.ОсновнойКаналТока) + ") — не менялся.");
	Возврат Итог;

КонецФункции

// Опросчик: подключённая компонента с загруженной библиотекой FOCAS и память о последних записях
// (между циклами регламентного задания — что уже записано, когда был журнал и пересчёт состояния).
//
// Возвращаемое значение:
//  Структура - Компонента (AddIn.ФрегатЧПУ.CNC), Записано (Соответствие: Канал → Структура Значение, Строка,
//              МоментUTC), Узлы (Соответствие: Узел → Структура Успех, ЖурналUTC, СостояниеUTC).
//
Функция НовыйОпросчик() Экспорт

	Путь = СокрЛП(Константы.пульс_ПутьБиблиотекиFOCAS.Получить());
	Если ПустаяСтрока(Путь) Тогда
		ВызватьИсключение "Не задана библиотека FOCAS (Настройки → «Опрос станков с ЧПУ» → «Библиотека FOCAS»): "
			+ "путь к Fwlib64.dll на сервере 1С.";
	КонецЕсли;
	Если Не ПодключитьВнешнююКомпоненту("ОбщийМакет.пульс_КомпонентаЧПУ", "ФрегатЧПУ", ТипВнешнейКомпоненты.Native) Тогда
		ВызватьИсключение "Не подключена внешняя компонента «Опрос ЧПУ» (общий макет пульс_КомпонентаЧПУ) — "
			+ "нет сборки под ОС и разрядность сервера 1С?";
	КонецЕсли;
	Компонента = Новый("AddIn.ФрегатЧПУ.CNC");
	Если Не Компонента.ЗагрузитьБиблиотеку(Путь) Тогда
		ВызватьИсключение Компонента.ПоследняяОшибка;
	КонецЕсли;
	Возврат Новый Структура("Компонента, Записано, Узлы", Компонента, Новый Соответствие, Новый Соответствие);

КонецФункции

// Один цикл опроса: все узлы — параллельно (внутри компоненты), запись изменений, журнал, состояния.
//
// Параметры:
//  Опросчик - Структура - см. НовыйОпросчик.
//  Узлы - Массив из СправочникСсылка.пульс_УзлыСбораДанных, Неопределено - по умолчанию все активные узлы ЧПУ.
//  Записывать - Булево - Ложь — только прочитать (проверка соединения).
//
// Возвращаемое значение:
//  Массив из Структура - Узел, Оборудование, Успех, Данные (Структура — ответ компоненты по станку),
//                        Записано (Число записей), ТекстОшибки, ДлительностьМс.
//
Функция ОпроситьУзлы(Опросчик, Узлы = Неопределено, Записывать = Истина) Экспорт

	Описания = ОписанияУзлов(Узлы);
	Результаты = Новый Массив;
	Компонента = Опросчик.Компонента;
	Компонента.Очистить();
	ПоИдентификатору = Новый Соответствие;
	Для Каждого Описание Из Описания Цикл
		Результат = Новый Структура("Узел, Оборудование, Успех, Данные, Записано, ТекстОшибки, ДлительностьМс",
			Описание.Узел, Описание.Оборудование, Ложь, Неопределено, 0, "", 0);
		Результаты.Добавить(Результат);
		Адрес = РазобратьАдрес(Описание.БазовыйURL);
		Если Адрес = Неопределено Тогда
			Результат.ТекстОшибки = "Адрес узла не вида focas://<IP>:<порт>: " + Описание.БазовыйURL;
			Продолжить;
		КонецЕсли;
		Идентификатор = Строка(Описание.Узел.УникальныйИдентификатор());
		ПоИдентификатору.Вставить(Идентификатор, Результат);
		Компонента.ДобавитьСтанок(Идентификатор, Адрес.Адрес, Адрес.Порт,
			?(Описание.ТаймаутHTTP > 0, Описание.ТаймаутHTTP, 2) * 1000);
	КонецЦикла;
	Если ПоИдентификатору.Количество() = 0 Тогда
		Возврат Результаты;
	КонецЕсли;

	Ответ = Компонента.ПрочитатьВсе();
	МоментUTC = ТекущаяУниверсальнаяДата();
	UID = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ);
	Ответы = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Для Каждого Станок Из Ответы Цикл
		Результат = ПоИдентификатору.Получить(Станок.id);
		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Данные = Станок;
		Результат.Успех = Станок.ok;
		Результат.ДлительностьМс = ?(Станок.Свойство("ms"), Станок.ms, 0);
		Если Не Станок.ok Тогда
			Результат.ТекстОшибки = СтрШаблон("%1 (код %2, %3)", Станок.error, Станок.code, Станок.where);
		КонецЕсли;
	КонецЦикла;

	Если Записывать Тогда
		Для Каждого Результат Из Результаты Цикл
			Попытка
				Записать(Опросчик, Результат, МоментUTC, UID);
			Исключение
				Результат.ТекстОшибки = Результат.ТекстОшибки + " Запись: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации("ПУЛЬС.ОпросЧПУ", УровеньЖурналаРегистрации.Ошибка, , Результат.Узел,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	Возврат Результаты;

КонецФункции

// Обработчик регламентного задания пульс_ОпросЧПУ: раз в минуту, внутри — цикл опроса с интервалом константы
// (у регламентного задания период не меньше минуты в файловой базе, а станки нужно видеть каждые несколько секунд).
Процедура ВыполнитьРегламентноеЗадание() Экспорт

	Если Не Константы.пульс_ОпросЧПУ.Получить() Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Опросчик = НовыйОпросчик();
	Исключение
		ЗаписьЖурналаРегистрации("ПУЛЬС.ОпросЧПУ", УровеньЖурналаРегистрации.Ошибка, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ВыполнитьЦикл(Опросчик, 55, Истина);

КонецПроцедуры

// Цикл опроса заданной длительности (регламентное задание; тесты — короче).
//
// Параметры:
//  Опросчик - Структура - см. НовыйОпросчик.
//  ДлительностьСекунд - Число
//  ПоНастройке - Булево - выйти раньше, если опрос выключили в настройках (регламентное задание).
//
// Возвращаемое значение:
//  Число - выполнено циклов.
//
Функция ВыполнитьЦикл(Опросчик, ДлительностьСекунд, ПоНастройке = Ложь) Экспорт

	Интервал = ИнтервалОпроса();
	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + ДлительностьСекунд * 1000;
	Циклов = 0;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			ОпроситьУзлы(Опросчик);
		Исключение
			ЗаписьЖурналаРегистрации("ПУЛЬС.ОпросЧПУ", УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Циклов = Циклов + 1;
		Если ПоНастройке И Не Константы.пульс_ОпросЧПУ.Получить() Тогда
			Прервать; // выключили в настройках — не ждать конца минуты
		КонецЕсли;
		Осталось = Мин(Интервал * 1000 - (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало),
			Конец - ТекущаяУниверсальнаяДатаВМиллисекундах());
		Если Осталось > 0 Тогда
			Опросчик.Компонента.Пауза(Осталось);
		КонецЕсли;
	КонецЦикла;
	Возврат Циклов;

КонецФункции

// Расписание регламентного задания: включено/выключено (константа пульс_ОпросЧПУ), раз в минуту.
//
// Параметры:
//  Включено - Булево
//
Процедура ПрименитьРасписание(Включено) Экспорт

	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.пульс_ОпросЧПУ);
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = 60;
	Задание.Расписание = Расписание;
	Задание.Использование = Включено;
	Задание.Записать();

КонецПроцедуры

// «Проверить соединение» узла ЧПУ: прочитать станок сейчас, без записи.
//
// Параметры:
//  Узел - СправочникСсылка.пульс_УзлыСбораДанных
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Текст (Строка — для показа), Качество (Строка).
//
Функция ПроверитьСоединение(Узел) Экспорт

	Опросчик = НовыйОпросчик();
	Результат = ОпроситьУзлы(Опросчик, ОдинУзел(Узел), Ложь)[0];
	Если Результат.Успех Тогда
		Текст = СтрШаблон("ЧПУ «%1» отвечает, %2 мс.", Узел, Формат(Результат.ДлительностьМс, "ЧН=0; ЧГ="))
			+ Символы.ПС + ТекстПоказаний(Результат.Данные);
	Иначе
		Текст = СтрШаблон("ЧПУ «%1» не отвечает: %2", Узел, Результат.ТекстОшибки);
	КонецЕсли;
	Возврат Новый Структура("Успех, Текст, Качество", Результат.Успех, Текст,
		?(Результат.Успех, "GOOD", "CONNECTION_ERROR"));

КонецФункции

// «Синхронизировать сейчас» узла ЧПУ: опрос с записью и расчётом состояния.
//
// Параметры:
//  Узел - СправочникСсылка.пульс_УзлыСбораДанных
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Текст (Строка — для показа).
//
Функция ОпроситьУзелСейчас(Узел) Экспорт

	Опросчик = НовыйОпросчик();
	Результат = ОпроситьУзлы(Опросчик, ОдинУзел(Узел))[0];
	Строки = Новый Массив;
	Если Результат.Успех Тогда
		Строки.Добавить(СтрШаблон("ЧПУ «%1»: записано показаний %2, %3 мс.", Узел, Результат.Записано,
			Формат(Результат.ДлительностьМс, "ЧН=0; ЧГ=")));
		Строки.Добавить(ТекстПоказаний(Результат.Данные));
	Иначе
		Строки.Добавить(СтрШаблон("ЧПУ «%1» не отвечает: %2", Узел, Результат.ТекстОшибки));
	КонецЕсли;
	Текущее = РегистрыСведений.пульс_ТекущиеСостоянияОборудования.Получить(
		Новый Структура("Оборудование", Результат.Оборудование));
	Если ЗначениеЗаполнено(Текущее.Состояние) Тогда
		Строки.Добавить(СтрШаблон("Состояние «%1»: %2.", Результат.Оборудование, Текущее.Состояние));
	КонецЕсли;
	Возврат Новый Структура("Успех, Текст", Результат.Успех, СтрСоединить(Строки, Символы.ПС));

КонецФункции

// Показания станка — для людей.
//
// Параметры:
//  Данные - Структура - ответ компоненты по станку.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстПоказаний(Данные) Экспорт

	Если Данные = Неопределено Или Не Данные.ok Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Если Данные.Свойство("series") Тогда
		Части.Добавить(СтрШаблон("FANUC %1, серия %2, версия %3.", СокрЛП(Данные.cnc_type), Данные.series, Данные.version));
	КонецЕсли;
	Части.Добавить(СтрШаблон("Режим %1, выполнение %2%3.", ИмяРежима(Данные.aut), ИмяВыполнения(Данные.run),
		?(Данные.run = 3, " — идёт программа", "")));
	Если Данные.Свойство("prog") Тогда
		Части.Добавить("Программа " + Данные.prog + ".");
	КонецЕсли;
	Значения = Новый Массив;
	Если Данные.Свойство("speed") Тогда
		Значения.Добавить(Формат(Данные.speed, "ЧН=0; ЧГ=") + " об/мин");
	КонецЕсли;
	Если Данные.Свойство("feed") Тогда
		Значения.Добавить("подача " + Формат(Данные.feed, "ЧН=0; ЧГ=") + " мм/мин");
	КонецЕсли;
	Если Данные.Свойство("load") Тогда
		Значения.Добавить("нагрузка шпинделя " + Формат(Данные.load, "ЧН=0") + " %");
	КонецЕсли;
	Если Данные.Свойство("parts") Тогда
		Значения.Добавить("деталей " + Формат(Данные.parts, "ЧН=0; ЧГ="));
	КонецЕсли;
	Если Значения.Количество() > 0 Тогда
		Части.Добавить(СтрСоединить(Значения, ", ") + ".");
	КонецЕсли;
	Если Данные.alarm <> 0 Или Данные.emergency <> 0 Тогда
		Части.Добавить(?(Данные.emergency <> 0, "Аварийный стоп!", "Есть авария на ЧПУ."));
	КонецЕсли;
	Возврат СтрСоединить(Части, " ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УстройствоFOCAS()

	Возврат "FOCAS";

КонецФункции

// Без изменений показание повторяется не реже — чтобы состояние не ушло в OFFLINE по таймауту.
Функция ПульсСекунд()

	Возврат Макс(30, ИнтервалОпроса());

КонецФункции

Функция ИнтервалОпроса()

	Интервал = Константы.пульс_ИнтервалОпросаЧПУСекунд.Получить();
	Возврат ?(Интервал > 0, Интервал, 5);

КонецФункции

// Таймаут OFFLINE канала «Работа»: пульс и три пропущенных опроса.
Функция ТаймаутOFFLINE()

	Возврат ПульсСекунд() + 3 * ИнтервалОпроса();

КонецФункции

Функция ОдинУзел(Узел)

	Узлы = Новый Массив;
	Узлы.Добавить(Узел);
	Возврат Узлы;

КонецФункции

Функция ОписанияУзлов(Узлы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Узлы.Ссылка КАК Узел,
	|	Узлы.БазовыйURL КАК БазовыйURL,
	|	Узлы.ТаймаутHTTP КАК ТаймаутHTTP,
	|	Узлы.Оборудование КАК Оборудование
	|ИЗ
	|	Справочник.пульс_УзлыСбораДанных КАК Узлы
	|ГДЕ
	|	Узлы.БазовыйURL ПОДОБНО &Префикс
	|	И (&ВсеАктивные И Узлы.Активно И НЕ Узлы.ПометкаУдаления
	|		ИЛИ НЕ &ВсеАктивные И Узлы.Ссылка В (&Узлы))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Узлы.Наименование";
	Запрос.УстановитьПараметр("Префикс", ПрефиксАдреса() + "%");
	Запрос.УстановитьПараметр("ВсеАктивные", Узлы = Неопределено);
	Запрос.УстановитьПараметр("Узлы", ?(Узлы = Неопределено, Новый Массив, Узлы));
	Описания = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура("Узел, БазовыйURL, ТаймаутHTTP, Оборудование");
		ЗаполнитьЗначенияСвойств(Описание, Выборка);
		Описания.Добавить(Описание);
	КонецЦикла;
	Возврат Описания;

КонецФункции

// Значение канала из ответа компоненты; Неопределено — поля нет (функции нет на этом ЧПУ).
Функция ЗначениеКанала(Данные, Поле)

	Если Поле = "*работа" Тогда
		Возврат ?(Данные.run = 3, 2, 1);
	ИначеЕсли Поле = "*авария" Тогда
		Возврат ?(Данные.alarm <> 0 Или Данные.emergency <> 0, 1, 0);
	ИначеЕсли Данные.Свойство(Поле) Тогда
		Возврат Данные[Поле];
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Запись показаний одного станка: изменения и пульс → сырая телеметрия; журнал обмена — при смене связи и раз
// в минуту; состояние — при записи, смене связи и не реже пульса (OFFLINE по таймауту).
Процедура Записать(Опросчик, Результат, МоментUTC, UID)

	Узел = Результат.Узел;
	Память = Опросчик.Узлы.Получить(Узел);
	Если Память = Неопределено Тогда
		Память = Новый Структура("Успех, ЖурналUTC, СостояниеUTC, Каналы", Неопределено, '00010101', '00010101', Неопределено);
		Опросчик.Узлы.Вставить(Узел, Память);
	КонецЕсли;
	Пульс = ПульсСекунд();

	Если Результат.Успех И ЗначениеЗаполнено(Результат.Оборудование) Тогда
		Если Память.Каналы = Неопределено Тогда
			Память.Каналы = СоздатьКаналы(Узел).Каналы;
		КонецЕсли;
		Набор = РегистрыСведений.пульс_СыраяТелеметрия.СоздатьНаборЗаписей();
		Записанные = Новый Массив;
		Для Каждого Описание Из КаналыЧПУ() Цикл
			Значение = ЗначениеКанала(Результат.Данные, Описание.Поле);
			Канал = Память.Каналы.Получить(Описание.Control);
			Если Значение = Неопределено Или Не ЗначениеЗаполнено(Канал) Тогда
				Продолжить;
			КонецЕсли;
			ЗначениеСтрокой = ?(Описание.Поле = "onum" И Результат.Данные.Свойство("prog"), Результат.Данные.prog, "");
			Прежнее = Опросчик.Записано.Получить(Канал);
			Если Прежнее <> Неопределено И Прежнее.Значение = Значение И Прежнее.Строка = ЗначениеСтрокой
				И МоментUTC - Прежнее.МоментUTC < Пульс Тогда
				Продолжить;
			КонецЕсли;
			Запись = Набор.Добавить();
			Запись.УзелСбораДанных = Узел;
			Запись.Device = УстройствоFOCAS();
			Запись.Control = Описание.Control;
			Запись.UID = UID;
			Запись.Значение = Значение;
			Запись.КаналТелеметрии = Канал;
			Запись.Оборудование = Результат.Оборудование;
			Запись.ДатаUTC = МоментUTC;
			Запись.ДатаПолучения = МоментUTC;
			Запись.КачествоДанных = Перечисления.пульс_КачествоДанных.GOOD;
			Запись.ЗначениеСтрокой = ЗначениеСтрокой;
			Опросчик.Записано.Вставить(Канал, Новый Структура("Значение, Строка, МоментUTC", Значение, ЗначениеСтрокой, МоментUTC));
			Записанные.Добавить(Канал);
		КонецЦикла;
		Если Набор.Количество() > 0 Тогда
			Набор.Записать(Ложь);
			Для Каждого Канал Из Записанные Цикл
				ОтметитьКанал(Узел, Канал, МоментUTC, UID);
			КонецЦикла;
		КонецЕсли;
		Результат.Записано = Набор.Количество();
	ИначеЕсли Результат.Успех Тогда
		Результат.ТекстОшибки = "У узла ЧПУ не указан станок — показания не записаны.";
	КонецЕсли;

	СменаСвязи = (Память.Успех <> Результат.Успех);
	Если СменаСвязи Или МоментUTC - Память.ЖурналUTC >= 60 Тогда
		Итог = Новый Структура("Успех, Качество, КодСостояния, ДлительностьМс, ТекстОшибки", Результат.Успех,
			?(Результат.Успех, Перечисления.пульс_КачествоДанных.GOOD, Перечисления.пульс_КачествоДанных.CONNECTION_ERROR),
			0, Результат.ДлительностьМс, Результат.ТекстОшибки);
		пульс_Диагностика.ЗаписатьВЖурналОбмена(Узел, Перечисления.пульс_ОперацииОбмена.ОпросЧПУ, Итог, Результат.Записано);
		Память.ЖурналUTC = МоментUTC;
	КонецЕсли;
	Память.Успех = Результат.Успех;

	Если ЗначениеЗаполнено(Результат.Оборудование)
		И (Результат.Записано > 0 Или СменаСвязи Или МоментUTC - Память.СостояниеUTC >= Пульс) Тогда
		// +1 с: показание записано на «сейчас», а дата — до секунды; значение держится до следующей записи
		пульс_Состояния.ОбновитьСостояние(Результат.Оборудование, МоментUTC + 1);
		Память.СостояниеUTC = МоментUTC;
	КонецЕсли;

КонецПроцедуры

// «Загружено по» канала — как у обмена с Wiren Board (отчёт «Обмен с контроллерами», панель).
Процедура ОтметитьКанал(Узел, Канал, МоментUTC, UID)

	Менеджер = РегистрыСведений.пульс_СостояниеСинхронизацииКаналов.СоздатьМенеджерЗаписи();
	Менеджер.УзелСбораДанных = Узел;
	Менеджер.КаналТелеметрии = Канал;
	Менеджер.ЗагруженоПоUTC = МоментUTC;
	Менеджер.ПоследнийUID = UID;
	Менеджер.ДатаПоследнейПопыткиUTC = МоментUTC;
	Менеджер.ДатаПоследнегоУспехаUTC = МоментUTC;
	Менеджер.СтатусОбмена = Перечисления.пульс_КачествоДанных.GOOD;
	Менеджер.ЗаписейПоследнегоОбмена = 1;
	Менеджер.Записать();

КонецПроцедуры

Функция ИмяРежима(Код)

	Имена = СтрРазделить("MDI,MEM (авто),—,EDIT,HND,JOG,TJOG,THND,INC,REF,RMT", ",");
	Возврат ?(Код >= 0 И Код < Имена.Количество(), Имена[Код], Строка(Код));

КонецФункции

Функция ИмяВыполнения(Код)

	Имена = СтрРазделить("RESET (сброс),STOP (стоп),HOLD (пауза),STRT (пуск),MSTR", ",");
	Возврат ?(Код >= 0 И Код < Имена.Количество(), Имена[Код], Строка(Код));

КонецФункции

#КонецОбласти
