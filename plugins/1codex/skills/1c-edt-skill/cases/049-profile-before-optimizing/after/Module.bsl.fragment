Функция Маршрут(Откуда, Куда, ТС) Экспорт
	Граф = мвмМаршрутизацияПовтИсп.ГрафПроездов();   // один раз на сеанс, без параметров
	Параметры = ПараметрыТС(ТС);                        // проходимость решается при обходе
	Куча = Новый Массив;                                 // двоичная куча (расстояние, узел)
	Расстояния = Новый Соответствие;
	Расстояния.Вставить(Откуда, 0);
	КучаДобавить(Куча, 0, Откуда);
	Пока Куча.Количество() > 0 Цикл
		Верх = КучаВзять(Куча);                          // O(log N)
		Если Верх.Расстояние > Расстояния[Верх.Узел] Тогда Продолжить; КонецЕсли;   // устаревшая запись
		Если Верх.Узел = Куда Тогда Прервать; КонецЕсли;
		Для Каждого Проезд Из Граф[Верх.Узел] Цикл
			Если НЕ ПроездДоступен(Проезд, Параметры) Тогда Продолжить; КонецЕсли;
			// … ослабление ребра, КучаДобавить …
		КонецЦикла;
	КонецЦикла;
КонецФункции
