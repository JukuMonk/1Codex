// Модуль формы обработки «Пример обработки».
//
// Правило: клиентская команда → серверная процедура «…НаСервере» →
// серверная работа с таблицей. У каждой процедуры директива (case 011).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТолькоАктивные = Истина;
	ЗаполнитьСтроки();

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	ЗаполнитьСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Отмечено = 0;
	Для Каждого Строка Из Строки Цикл
		Если ЗначениеЗаполнено(Строка.Элемент) Тогда
			Строка.Отметка = Истина;
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	ПоказатьПредупреждение(, "Отмечено строк: " + Отмечено);

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	КЗаписи = 0;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Отметка И ЗначениеЗаполнено(Строка.Элемент) Тогда
			КЗаписи = КЗаписи + 1;
		КонецЕсли;
	КонецЦикла;
	Если КЗаписи = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одной строки.");
		Возврат;
	КонецЕсли;
	Итог = ЗаписатьНаСервере();
	ЗаполнитьНаСервере();
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере()

	Записано = 0;
	Ошибок = 0;
	Для Каждого Строка Из Строки Цикл
		Если НЕ Строка.Отметка ИЛИ НЕ ЗначениеЗаполнено(Строка.Элемент) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЭлементОбъект = Строка.Элемент.ПолучитьОбъект();
			ЭлементОбъект.Комментарий = Строка.Комментарий;
			// Режим загрузки — свойство СТРУКТУРЫ ОбменДанными (case 014).
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			ЭлементОбъект.Записать();
			Записано = Записано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Элемент «" + Строка.Элемент + "» не записан: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Итог = "Записано: " + Записано;
	Если Ошибок > 0 Тогда
		Итог = Итог + ", с ошибкой: " + Ошибок;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Шаблон пользователь пишет звёздочкой, языку запросов нужен процент.
&НаСервереБезКонтекста
Функция ШаблонВЗапрос(Шаблон)

	Текст = СокрЛП(Шаблон);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "*", "%");
	Если СтрНайти(Текст, "%") = 0 Тогда
		Текст = "%" + Текст + "%";
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаСервере
Процедура ЗаполнитьСтроки()

	Строки.Очистить();
	// Сравнение со строкой в запросе не пишем: пустая строка внутри
	// строкового литерала требует четырёх кавычек (case 015). Пустой
	// шаблон отсеиваем параметром.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.Наименование КАК Наименование,
		|	Элементы.Комментарий КАК Комментарий,
		|	Элементы.Активен КАК Активен
		|ИЗ
		|	Справочник.ПримерСправочник КАК Элементы
		|ГДЕ
		|	НЕ Элементы.ПометкаУдаления
		|	И (&БезОтбора ИЛИ Элементы.Наименование ПОДОБНО &Шаблон)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Элементы.Наименование");
	ШаблонЗапроса = ШаблонВЗапрос(Шаблон);
	Запрос.УстановитьПараметр("БезОтбора", ПустаяСтрока(ШаблонЗапроса));
	Запрос.УстановитьПараметр("Шаблон", ШаблонЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТолькоАктивные И НЕ Выборка.Активен Тогда
			Продолжить;
		КонецЕсли;
		Строка = Строки.Добавить();
		Строка.Элемент = Выборка.Ссылка;
		Строка.Комментарий = Выборка.Комментарий;
		Строка.Состояние = ?(Выборка.Активен, "активен", "выключен");
	КонецЦикла;

КонецПроцедуры
