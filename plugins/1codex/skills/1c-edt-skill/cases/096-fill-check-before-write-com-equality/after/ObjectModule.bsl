// Версия структуры объекта (эталон / проект).
// При записи (ДиЗ-01, ДиЗ-02 к ТЗ-01):
//   * пустой тип строки — из словаря реквизитов;
//   * табличная часть — ссылка на справочник «Названия табличных частей объектов» (ДиЗ-02 п.4); строковая
//     колонка ТабличнаяЧасть — её копия для выгрузки ИИ, печати и сопоставления эталона с проектом; строки,
//     записанные до ДиЗ-02 (только строка), получают ссылку — элемент справочника находится или создаётся;
//   * у строки — постоянный ключ (связь с вариантами ссылки), «Ссылается на» — все варианты через «; »
//     (первый — СсылкаНаОбъект, остальные — табличная часть СсылкиНаОбъекты, ДиЗ-02 п.3).
// Модуль генерируется: инструменты/методолог_диз01.py (правки — в инструменты/методолог/).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// ДиЗ-05 к ТЗ-01 п.5: проверка заполнения идёт раньше ПередЗаписью — наименование по шаблону (и номер версии,
// если пуст: следующий у объекта) ставится здесь, иначе новая версия не записывается: «Поле "Наименование" не
// заполнено».
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Номер = 0 И ЗначениеЗаполнено(Владелец) Тогда
		Номер = МетодологБиблиотека.СледующийНомерВерсии(Владелец, Ссылка);
	КонецЕсли;
	Наименование = МетодологБиблиотека.НаименованиеВерсии(ЭтотОбъект);

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// программная запись (обработки, COM) проверку заполнения не проходит — номер и здесь (ДиЗ-05 п.5)
	Если Номер = 0 И ЗначениеЗаполнено(Владелец) Тогда
		Номер = МетодологБиблиотека.СледующийНомерВерсии(Владелец, Ссылка);
	КонецЕсли;
	МетодологБиблиотека.ПривестиСтрокиВерсии(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
