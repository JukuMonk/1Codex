  <formCommands>
    <name>СохранитьПланВФайл</name>
    <title>
      <key>ru</key>
      <value>Сохранить план в файл</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>ru</key>
      <value>Узлы, проезды, геозоны, типы и настройки карты — в JSON для другой базы</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>СохранитьПланВФайл</name>
      </handler>
    </action>
    <currentRowUse>Auto</currentRowUse>
  </formCommands>
  <formCommands>
    <name>ЗагрузитьПланИзФайла</name>
