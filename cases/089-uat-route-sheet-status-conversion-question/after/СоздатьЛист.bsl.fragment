	Лист = Документы.уатМаршрутныйЛист.СоздатьДокумент();
	// … как раньше …
	// Статус — как у типовой: пустой форма листа встречает вопросом о конвертации.
	Документы.уатМаршрутныйЛист.РассчитатьСтатусДокумента(Лист);
	Лист.ОбменДанными.Загрузка = Истина;
	Лист.Записать(РежимЗаписиДокумента.Запись);

