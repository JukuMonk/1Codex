// Упрощённый вид ТИПОВОЙ формы: скрыть и переставить в модуле под
// константой, XML формы не менять (case 037).
//
// Почему не XML: типовая форма остаётся типовой, режим выключается
// константой, обновление типовой не конфликтует. Три вставки в типовой
// модуль делает генератор (edt_lib.insert_into_procedure, case 026):
//   в конец ПриСозданииНаСервере:   мвмУпроститьФорму();
//   в конец УстановитьВидимость:    мвмСкрытьЛишнее();   ← типовая показывает
//                                                           часть вкладок заново
//   в конец ПриЧтенииНаСервере / ОбработкаЗаполнения — умолчания нового
//   объекта ПОСЛЕ типовых (иначе типовая перекроет).
// Своя область в чужом модуле переписывается генератором целиком.

#Область Мвм_УпрощённаяФорма

&НаСервереБезКонтекста
Функция мвмУпрощённаяФорма()

	Возврат Константы.ПримерУпрощённыйРежим.Получить();

КонецФункции

&НаСервере
Процедура мвмУпроститьФорму()

	Если НЕ мвмУпрощённаяФорма() Тогда
		Возврат;
	КонецЕсли;

	// Группы переносим ЦЕЛИКОМ, иначе одинокая соседняя типовая группа
	// станет видна там, где её не ждут (case 037, «откуда поле Договор»).
	Перед = Элементы.ГруппаДополнительныеРеквизиты;
	Элементы.Переместить(Элементы.ГруппаЗаказчик, Элементы.ГруппаДополнительно, Перед);
	Элементы.Переместить(Элементы.ГруппаДоговор, Элементы.ГруппаДополнительно, Перед);
	Элементы.Переместить(Элементы.ГруппаОрганизация, Элементы.ГруппаДополнительно, Перед);

	мвмСкрытьЛишнее();

КонецПроцедуры

&НаСервере
Процедура мвмСкрытьЛишнее()

	Если НЕ мвмУпрощённаяФорма() Тогда
		Возврат;
	КонецЕсли;
	Лишнее = "ПодменюФинансы,ГруппаКонтактноеЛицо,ГруппаСтраницаУслуги,СтраницыИтогов";
	Для Каждого Имя Из СтрРазделить(Лишнее, ",") Цикл
		Если Элементы.Найти(Имя) <> Неопределено Тогда
			Элементы[Имя].Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Умолчания нового объекта — после типовых умолчаний из настроек
// пользователя, иначе типовая их перекроет.
&НаСервере
Процедура мвмУмолчанияНовогоОбъекта()

	Если НЕ мвмУпрощённаяФорма() ИЛИ НЕ Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = мвмЕдинственнаяОрганизация();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция мвмЕдинственнаяОрганизация()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления");
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Возврат Таблица[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

#КонецОбласти
