// CORRECT

// Число из чего угодно: NULL у реквизита группы, пустая строка из
// настроек, Неопределено из соответствия. Ноль значит «не задано».
Функция ЧислоИлиНоль(Значение)
	Если Значение = Неопределено ИЛИ Значение = NULL ИЛИ Значение = "" Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ПределУзлов(Дорога, ПределА, ПределБ)

	Итог = ЧислоИлиНоль(Дорога);
