// Фрагмент приёма результата: владелец не записывается автоматически.
// Имя табличной части и поля адаптировать к фактическим метаданным проекта.
&НаКлиенте
Процедура ПослеРедактированияТекста(Результат, ИдентификаторСтроки) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаФормы = Объект.Шаги.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаФормы = Неопределено Тогда
		Сообщить("Строка была удалена; текст не применён.");
		Возврат;
	КонецЕсли;
	СтрокаФормы.ТекстПункта = Результат;
	Модифицированность = Истина;
КонецПроцедуры
