// Маршрутный лист: представление — номер в 1С:ERP и ДСЕ («МЛ-26-17294 · Корпус подшипника 5.20.041»).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Поля.Добавить("НомерERP");
	Поля.Добавить("ДСЕ");
	Поля.Добавить("Номер");

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Представление = ?(ПустаяСтрока(Данные.НомерERP), "Маршрутный лист " + Данные.Номер, Данные.НомерERP)
		+ ?(ПустаяСтрока(Данные.ДСЕ), "", " · " + Данные.ДСЕ);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
