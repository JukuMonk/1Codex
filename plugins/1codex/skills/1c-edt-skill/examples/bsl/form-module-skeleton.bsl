// Скелет модуля управляемой формы. Что здесь обязательно:
//   - у КАЖДОЙ процедуры директива: без неё процедура модуля формы
//     компилируется серверной, и ОткрытьФорму/Сообщить падают при нажатии
//     кнопки, а не при компиляции (case 011);
//   - вставлять код между директивой и объявлением нельзя (case 012);
//   - имена Параметры, Объект, Элементы, ЭтаФорма, Команды заняты формой —
//     локальную переменную под ними не завести (case 010);
//   - клиентская команда → серверная «…НаСервере» → работа с данными;
//   - обработчик каждого события формы/элемента/команды, объявленного в
//     Form.form (<handlers>, <formCommands>), должен здесь существовать.
//
// Файл: UTF-8 без BOM, CRLF, отступ — табуляция.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Параметры формы читаются здесь; свои умолчания — тоже здесь, а не в XML.
	Если Параметры.Свойство("ТолькоАктивные") Тогда
		ТолькоАктивные = Параметры.ТолькоАктивные;
	КонецЕсли;
	ЗаполнитьСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Клиентские приготовления: подключение обработчика ожидания и т.п.
	ПодключитьОбработчикОжидания("ОбновитьПоТаймеру", 60, Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТолькоАктивныеПриИзменении(Элемент)

	ЗаполнитьСтрокиНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	ЗаполнитьСтрокиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭлемент(Команда)

	Строка = Элементы.Строки.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// НЕ «Параметры = Новый Структура» — имя занято формой (case 010).
	ПараметрыФормы = Новый Структура("Ключ", Строка.Элемент);
	ОткрытьФорму("Справочник.ПримерСправочник.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСтрокиНаСервере()

	ЗаполнитьСтроки();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтроки()

	Строки.Очистить();
	Для Каждого Элемент Из ПримерОбщийМодуль.АктивныеЭлементы() Цикл
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Элемент = Элемент.Ссылка;
		НоваяСтрока.Наименование = Элемент.Наименование;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоТаймеру()

	ЗаполнитьСтрокиНаСервере();

КонецПроцедуры

// Серверная функция без контекста формы: сюда нельзя обращаться к Элементы
// и реквизитам формы, зато имя «Параметры» здесь свободно.
&НаСервереБезКонтекста
Функция ПредставлениеЭлемента(Ссылка)

	Возврат Строка(Ссылка);

КонецФункции

#КонецОбласти
