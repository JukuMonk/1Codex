// Модуль мобильной формы. Логика — в общем модуле, форма раскладывает ответ.
// Страницы закладками (TabsOnTop) работают и на телефоне, и на компьютере;
// смахивания ПО СТРОКЕ у платформы нет — действия строки в контекстном
// меню (долгое нажатие) или кнопками на странице (case 030).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьВсё();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСейчас;

КонецПроцедуры

// Экран перечитывается сам раз в минуту: пользователь «Обновить» не жмёт.
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ПоТаймеру", 60);

КонецПроцедуры

&НаКлиенте
Процедура ПоТаймеру()

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	ЗаполнитьВсё();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВсё()

	// Таблица общего модуля кладётся в реквизит целиком: колонки реквизита
	// формы держим НАДМНОЖЕСТВОМ колонок таблицы модуля.
	ЗначениеВРеквизитФормы(ПримерОбщийМодуль.АктивныеЭлементы(), "Задачи");
	Если Задачи.Количество() > 0 И НЕ ЗначениеЗаполнено(ТекущаяЗадача) Тогда
		ТекущаяЗадача = Задачи[0].Задача;
		Элементы.Задачи.ТекущаяСтрока = Задачи[0].ПолучитьИдентификатор();
	КонецЕсли;
	ПоказатьЭкран();

КонецПроцедуры

// Заголовок и пояснение — НАДПИСИ: текст им отдаётся через Заголовок,
// длинное переносится, а не обрезается. Пустое на телефоне не показываем.
&НаСервере
Процедура ПоказатьЭкран()

	// «Объект» — свойство формы (case 010): свой реквизит назван иначе.
	ТекущийОбъект = ТекущаяЗадача;
	Элементы.ЧтоДелать.Заголовок = ?(ЗначениеЗаполнено(ТекущаяЗадача),
		"Выполнить: " + Строка(ТекущаяЗадача), "Задач нет");
	Элементы.ЧтоДелать.ЦветТекста = ?(Просрочено, Новый Цвет(211, 47, 47), Новый Цвет());
	Элементы.Дальше.Заголовок = ?(ЗначениеЗаполнено(ТекущаяЗадача), "Готово", "Дальше");
	Элементы.НормативТекст.Видимость = НЕ ПустаяСтрока(НормативТекст);
	Элементы.Просрочено.Видимость = Просрочено;

КонецПроцедуры

&НаКлиенте
Процедура ЗадачиПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Задачи.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.Задача = ТекущаяЗадача Тогда
		Возврат;
	КонецЕсли;
	ТекущаяЗадача = ТекущиеДанные.Задача;
	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаЧат И НовыхСообщений > 0 Тогда
		ЗаполнитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Дальше(Команда)

	Если НЕ ЗначениеЗаполнено(ТекущаяЗадача) Тогда
		ПоказатьПредупреждение(, "Задач нет.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ШагНаСервере());

КонецПроцедуры

&НаСервере
Функция ШагНаСервере()

	ПримерОбщийМодуль.ОтметитьНедоступность(ТекущаяЗадача, 30, "в работе");
	ЗаполнитьВсё();
	Возврат "Отмечено.";

КонецФункции

// Выбор причины — меню: ПоказатьВыборИзМеню с оповещением, не окно с таблицей.
&НаКлиенте
Процедура НеПолучается(Команда)

	Список = Новый СписокЗначений;
	Список.Добавить("нет", "Груза нет");
	Список.Добавить("некому", "Принять некому");
	ПоказатьВыборИзМеню(Новый ОписаниеОповещения("ПричинаВыбрана", ЭтотОбъект),
		Список, Элементы.НеПолучается);

КонецПроцедуры

&НаКлиенте
Процедура ПричинаВыбрана(Выбранное, ДопПараметры) Экспорт

	Если Выбранное = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Причина: " + Выбранное.Представление);

КонецПроцедуры

// Ответ — оповещением в углу, а не окном: в чате «ОК» на каждую реплику невыносимо.
&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(НовоеСообщение) Тогда
		ПоказатьОповещениеПользователя("Напишите сообщение");
		Возврат;
	КонецЕсли;
	НовоеСообщение = "";
	ПоказатьОповещениеПользователя("Отправлено");

КонецПроцедуры
