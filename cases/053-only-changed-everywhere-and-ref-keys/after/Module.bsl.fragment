// 1. Зоны сравниваются с базой одним пакетом запросов.
ТекущиеЗоны = ЗоныДляСравнения();
Для Каждого Зона Из Пакет["геозоны"] Цикл
	ТекущаяЗона = ТекущиеЗоны.Получить(СсылкаПоИд("уатГеозоны_уэ", Зона["ид"], Идентификаторы));
	Если ТекущаяЗона <> Неопределено И ЗонаНеИзменилась(ТекущаяЗона, Зона, …) Тогда
		Продолжить;
	КонецЕсли;
	…
	ЭлементСправочника.Записать();
	ЗоныИзменились = Истина;
КонецЦикла;
// 2. Привязка — по спискам изменённых; полный пересчёт только при изменении зоны.
Если ЗоныИзменились Тогда
	ПересчитатьПривязкуКГеозонам();
ИначеЕсли ИзменённыеУзлы.Количество() + ИзменённыеПроезды.Количество() > 0 Тогда
	ПересчитатьПривязкуКГеозонам(КлючиСоответствия(ИзменённыеУзлы), КлючиСоответствия(ИзменённыеПроезды));
КонецЕсли;
// В пересчёте: у каждого элемента свой набор с отбором — Записать(Истина) заменяет ровно его строки,
// у удалённого элемента набор пустой и строки уходят.
Набор = РегистрыСведений.мвмПривязкаГрафаКГеозонам.СоздатьНаборЗаписей();
Набор.Отбор.Элемент.Установить(Элемент);
…
Набор.Записать(Истина);
// 3. Ссылочные ключи — напрямую.
Функция ПоСсылке(Соответствие, Ссылка, ПоУмолчанию)
	Значение = Соответствие[Ссылка];
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
КонецФункции
