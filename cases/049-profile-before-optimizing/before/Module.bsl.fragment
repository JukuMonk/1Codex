Функция Маршрут(Откуда, Куда, ТС) Экспорт
	Граф = ЗагрузитьГраф(ТС);            // запрос к справочникам на КАЖДЫЙ маршрут
	Расстояния = Новый Соответствие;
	Посещён = Новый Соответствие;
	Расстояния.Вставить(Откуда, 0);
	Пока Истина Цикл
		Текущий = Неопределено; Минимум = 0;
		Для Каждого Пара Из Расстояния Цикл   // перебор ВСЕХ узлов на каждом шаге: O(N²)
			Если Посещён[Пара.Ключ] = Неопределено И (Текущий = Неопределено ИЛИ Пара.Значение < Минимум) Тогда
				Текущий = Пара.Ключ; Минимум = Пара.Значение;
			КонецЕсли;
		КонецЦикла;
		Если Текущий = Неопределено ИЛИ Текущий = Куда Тогда Прервать; КонецЕсли;
		// … ослабление рёбер …
	КонецЦикла;
КонецФункции
