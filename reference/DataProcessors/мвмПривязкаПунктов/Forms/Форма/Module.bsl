// Модуль формы «Привязка пунктов к узлам плана».
//
// Собирается скриптом инструменты/обработка_привязки_пунктов.py —
// править здесь бесполезно, правка теряется при следующей сборке.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТолькоНепривязанные = Истина;
	Разделитель = "//";
	ЗаполнитьСтроки();

КонецПроцедуры

&НаКлиенте
Процедура Подобрать(Команда)

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	ЗаполнитьСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Отмечено = 0;
	Для Каждого Строка Из Строки Цикл
		// Отмечаем только то, что подобралось: пустой узел записывать нечего.
		Если ЗначениеЗаполнено(Строка.Узел) Тогда
			Строка.Отметка = Истина;
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	ПоказатьПредупреждение(, "Отмечено строк: " + Отмечено);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтмеченные(Команда)

	КЗаписи = 0;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Отметка И ЗначениеЗаполнено(Строка.Пункт) Тогда
			КЗаписи = КЗаписи + 1;
		КонецЕсли;
	КонецЦикла;
	Если КЗаписи = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одной строки.");
		Возврат;
	КонецЕсли;

	Итог = ЗаписатьНаСервере();
	ЗаполнитьНаСервере();
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

// Записываем ТОЛЬКО отмеченное: подбор по имени — предположение, и решает
// его судьбу диспетчер, а не скрипт.
&НаСервере
Функция ЗаписатьНаСервере()

	Записано = 0;
	Ошибок = 0;
	Для Каждого Строка Из Строки Цикл

		Если НЕ Строка.Отметка ИЛИ НЕ ЗначениеЗаполнено(Строка.Пункт) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ПунктОбъект = Строка.Пункт.ПолучитьОбъект();
			ПунктОбъект.мвмУзелКарты = Строка.Узел;
			ПунктОбъект.Записать();
			Записано = Записано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Пункт «" + Строка.Пункт + "» не записан: "
				+ ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Итог = "Записано пунктов: " + Записано;
	Если Ошибок > 0 Тогда
		Итог = Итог + ", с ошибкой: " + Ошибок;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Ключ подбора: имя пункта до разделителя «//». За разделителем
// стоит уточнение («ворота 3», «рампа»), оно у каждого пункта своё, а объект
// один — по нему и ищем узел.
&НаСервереБезКонтекста
Функция КлючИмени(Наименование, Разделитель)

	Имя = СокрЛП(Наименование);
	Если НЕ ПустаяСтрока(Разделитель) Тогда
		Позиция = СтрНайти(Имя, Разделитель);
		Если Позиция > 0 Тогда
			Имя = Лев(Имя, Позиция - 1);
		КонецЕсли;
	КонецЕсли;
	Возврат НРег(СокрЛП(Имя));

КонецФункции

// Шаблон пользователь пишет привычной звёздочкой, языку запросов нужен
// процент. Пустой шаблон означает «берём всё», а не «не найдено ничего».
&НаСервереБезКонтекста
Функция ШаблонВЗапрос(Шаблон)

	Текст = СокрЛП(Шаблон);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "*", "%");
	Текст = СтрЗаменить(Текст, "?", "_");
	// Без звёздочек человек имеет в виду «содержит», а не «в точности равно».
	Если СтрНайти(Текст, "%") = 0 И СтрНайти(Текст, "_") = 0 Тогда
		Текст = "%" + Текст + "%";
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаСервере
Процедура ЗаполнитьСтроки()

	Строки.Очистить();

	// Узлы плана: ключ — то же имя, приведённое к нижнему регистру. Одинаковых
	// имён в базе не запрещено, поэтому неоднозначность показываем, а не
	// выбираем за диспетчера молча.
	УзлыПоИмени = Новый Соответствие;
	ЗапросУзлов = Новый Запрос(
		"ВЫБРАТЬ
		|	Узлы.Ссылка КАК Ссылка,
		|	Узлы.Наименование КАК Наименование
		|ИЗ
		|	Справочник.мвмУзлыКарты КАК Узлы
		|ГДЕ
		|	НЕ Узлы.ПометкаУдаления");
	ВыборкаУзлов = ЗапросУзлов.Выполнить().Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		Ключ = КлючИмени(ВыборкаУзлов.Наименование, Разделитель);
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Найденное = УзлыПоИмени.Получить(Ключ);
		Если Найденное = Неопределено Тогда
			Список = Новый Массив;
			УзлыПоИмени.Вставить(Ключ, Список);
			Найденное = Список;
		КонецЕсли;
		Найденное.Добавить(ВыборкаУзлов.Ссылка);
	КонецЦикла;

	// Пункты. Группы отсекаем: у группы иерархического справочника реквизиты
	// возвращают NULL, и записывать в неё нечего.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Пункты.Ссылка КАК Ссылка,
		|	Пункты.Наименование КАК Наименование,
		|	Пункты.мвмУзелКарты КАК УзелКарты
		|ИЗ
		|	Справочник.уатПунктыНазначения КАК Пункты
		|ГДЕ
		|	НЕ Пункты.ПометкаУдаления
		|	И НЕ Пункты.ЭтоГруппа
		|	И (&БезОтбора ИЛИ Пункты.Наименование ПОДОБНО &Шаблон)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Пункты.Наименование");
	Шаблон = ШаблонВЗапрос(ШаблонОтбора);
	Запрос.УстановитьПараметр("БезОтбора", ПустаяСтрока(Шаблон));
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если ТолькоНепривязанные И ЗначениеЗаполнено(Выборка.УзелКарты) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = КлючИмени(Выборка.Наименование, Разделитель);
		Строка = Строки.Добавить();
		Строка.Пункт = Выборка.Ссылка;
		Строка.Ключ = Ключ;

		Найденные = УзлыПоИмени.Получить(Ключ);
		Если Найденные = Неопределено Тогда
			Строка.Узел = Выборка.УзелКарты;
			Строка.Состояние = ?(ЗначениеЗаполнено(Выборка.УзелКарты),
				"узла с таким именем нет, стоит прежний",
				"узла с таким именем нет");
		ИначеЕсли Найденные.Количество() > 1 Тогда
			// Несколько узлов с одним именем — выбирать должен человек.
			Строка.Узел = Выборка.УзелКарты;
			Строка.Состояние = "узлов с таким именем несколько ("
				+ Найденные.Количество() + ") — выберите вручную";
		Иначе
			Строка.Узел = Найденные[0];
			Если Строка.Узел = Выборка.УзелКарты Тогда
				Строка.Состояние = "уже привязан";
			ИначеЕсли ЗначениеЗаполнено(Выборка.УзелКарты) Тогда
				Строка.Состояние = "заменит прежний: " + Выборка.УзелКарты;
				Строка.Отметка = Ложь;
			Иначе
				Строка.Состояние = "подобран по имени";
				Строка.Отметка = Истина;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
