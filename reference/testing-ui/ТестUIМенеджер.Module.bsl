// Менеджер тестирования (/TESTMANAGER): ведёт тестируемый клиент (/TESTCLIENT -TPort) по сценарию.
// Параметр запуска /C "<сценарий.txt>;<журнал.txt>[;порт]". Шаги «ссылка», «изменить», «завершить», «ячейка» — ZHDRM. Сценарий — строки «шаг | арг1 | арг2 | арг3»,
// # — комментарий. Итог — журнал «ОК/ОШИБКА строка => результат»; на первой ошибке — состояние окна.
// Интерпретатор — из 1c-edt-skill/tools/platform.py (уровень 9), через АЗОТ; в ZHDRM добавлен шаг «команда». Вынесен во внешнюю обработку, чтобы
// не вставлять его в модули конфигурации.

&НаКлиенте
Перем ТП;
&НаКлиенте
Перем ПутьЗапросаСнимка;

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("Прогон", 2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Прогон()

	Части = СтрРазделить(ПараметрЗапуска, ";");
	ПутьСценария = Части[0];
	ПутьЖурнала = ?(Части.Количество() > 1, Части[1], ПутьСценария + ".log");
	Порт = ?(Части.Количество() > 2, Число(Части[2]), 48123);
	ПутьЗапросаСнимка = ПутьЖурнала + ".снимок";
	Журнал = Новый Массив;
	Попытка
		ПараметрыТП = Новый Массив;
		ПараметрыТП.Добавить("localhost");
		ПараметрыТП.Добавить(Порт);
		ТП = Новый("ТестируемоеПриложение", ПараметрыТП);
	Исключение
		Журнал.Добавить("ОШИБКА: ТестируемоеПриложение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Подключено = Ложь;
	Ошибка = "";
	Если ТП <> Неопределено Тогда
		Для Н = 1 По 90 Цикл
			Попытка
				ТП.УстановитьСоединение();
				Подключено = Истина;
				Прервать;
			Исключение
				Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				Пауза(2);
			КонецПопытки;
		КонецЦикла;
		Если Не Подключено Тогда
			Журнал.Добавить("ОШИБКА: нет соединения с тестируемым клиентом: " + Ошибка);
		КонецЕсли;
	КонецЕсли;
	Если Подключено Тогда
		Для Каждого Строка Из СтрРазделить(ПрочитатьФайл(ПутьСценария), Символы.ПС, Ложь) Цикл
			Строка = СокрЛП(Строка);
			Если Строка = "" Или Лев(Строка, 1) = "#" Тогда
				Продолжить;
			КонецЕсли;
			Арг = СтрРазделить(Строка, "|");
			Для Инд = 0 По Арг.ВГраница() Цикл
				Арг[Инд] = СокрЛП(Арг[Инд]);
			КонецЦикла;
			Пока Арг.Количество() < 4 Цикл
				Арг.Добавить("");
			КонецЦикла;
			// «?шаг | …» — необязательный: ошибка пишется «ПРОПУЩЕН», сценарий идёт дальше (UP, 17.10.2026)
			Необязательный = Лев(Арг[0], 1) = "?";
			Если Необязательный Тогда
				Арг[0] = СокрЛП(Сред(Арг[0], 2));
			КонецЕсли;
			Попытка
				Итог = Шаг(НРег(Арг[0]), Арг[1], Арг[2], Арг[3]);
				Журнал.Добавить("ОК   " + Строка + ?(ЗначениеЗаполнено(Итог), " => " + Итог, ""));
			Исключение
				Если Необязательный Тогда
					Журнал.Добавить("ПРОПУЩЕН " + Строка + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					Продолжить;
				КонецЕсли;
				Журнал.Добавить("ОШИБКА " + Строка + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Журнал.Добавить(Состояние_());
				Прервать;
			КонецПопытки;
		КонецЦикла;
		Попытка
			ТП.РазорватьСоединение();
		Исключение
		КонецПопытки;
	КонецЕсли;
	ЗаписатьФайл(ПутьЖурнала, СтрСоединить(Журнал, Символы.ПС));
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаКлиенте
Функция Шаг(Шаг, А1, А2, А3)

	Если Шаг = "команда" Тогда
		// навигационная ссылка раздела/списка: e1cib/list/Справочник.X, e1cib/app/Обработка.Y (ZHDRM)
		ТП.ПолучитьАктивноеОкно().ВыполнитьКоманду(А1);
		Пауза(2);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "ждать" Тогда
		Пауза(Число(А1));
		Возврат "";
	ИначеЕсли Шаг = "форма" Тогда
		Для Н = 1 По 60 Цикл
			Ф = Форма_();
			Если Ф <> Неопределено И СтрНайти(НРег(Заголовок_(Ф)), НРег(А1)) > 0 Тогда
				Возврат Заголовок_(Ф);
			КонецЕсли;
			Пауза(1);
		КонецЦикла;
		ВызватьИсключение "нет формы «" + А1 + "», активна: " + Заголовок_(Форма_());
	ИначеЕсли Шаг = "кнопка" Тогда
		Элемент_(Тип("ТестируемаяКнопкаФормы"), А1).Нажать();
		Пауза(1);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "страница" Тогда
		Элемент_(Тип("ТестируемаяГруппаФормы"), А1).Активизировать();
		Пауза(1);
		Возврат "";
	ИначеЕсли Шаг = "надпись" Тогда
		Текст = Заголовок_(Элемент_(Тип("ТестируемаяДекорацияФормы"), А1));
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "заголовок" Тогда
		Ф = Форма_();
		Объект_ = Неопределено;
		Для Каждого ТипЭл Из СтрРазделить("ТестируемаяГруппаФормы,ТестируемоеПолеФормы,ТестируемаяДекорацияФормы,ТестируемаяКнопкаФормы", ",") Цикл
			Объект_ = Ф.НайтиОбъект(Тип(ТипЭл), , А1);
			Если Объект_ <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Объект_ = Неопределено Тогда
			ВызватьИсключение "нет элемента «" + А1 + "»";
		КонецЕсли;
		Текст = Заголовок_(Объект_);
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "поле" Тогда
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Поле.Активизировать();
		Поле.ВвестиТекст(А2);
		Форма_().ПерейтиКСледующемуЭлементу();
		Пауза(2);
		Возврат Поле.ПолучитьОтображаемыйТекст();
	ИначеЕсли Шаг = "значение" Тогда
		Текст = Элемент_(Тип("ТестируемоеПолеФормы"), А1).ПолучитьОтображаемыйТекст();
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "строка" Тогда
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Если НРег(А2) = "последняя" Тогда
			Таблица.ПерейтиКПоследнейСтроке();
		ИначеЕсли НРег(А2) = "следующая" Тогда
			Таблица.ПерейтиКСледующейСтроке();
		Иначе
			Таблица.ПерейтиКПервойСтроке();
		КонецЕсли;
		Пауза(1);
		Возврат "";
	ИначеЕсли Шаг = "текущая" Тогда
		// значения текущей строки таблицы (ПолучитьТекущуюСтроку); пустая таблица — исключение платформы
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Значение = Таблица.ПолучитьТекущуюСтроку();
		Части = Новый Массив;
		Попытка
			Для Каждого КЗ Из Значение Цикл
				Части.Добавить(Строка(КЗ.Ключ) + "=" + Строка(КЗ.Значение));
			КонецЦикла;
		Исключение
			Части.Добавить(Строка(Значение));
		КонецПопытки;
		Текст = СтрСоединить(Части, "; ");
		Проверить(Текст, А2);
		Возврат Текст;
	ИначеЕсли Шаг = "ссылка" Тогда
		// поле ссылочного типа (и ячейка строки в режиме правки): набрать часть наименования и выбрать строку
		// подсказки ввода; подсказка заполняется асинхронно — ждать до 10 с (из platform.py набора)
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Попытка
			Поле.Активизировать();
		Исключение
		КонецПопытки;
		Поле.ВвестиТекст(А2);
		Пауза(2);
		Искомое = ?(ЗначениеЗаполнено(А3), А3, А2);
		Выбор = Неопределено;
		Для Н = 1 По 10 Цикл
			Попытка
				Выбор = СтрокаСписка_(Поле, Искомое);
				Прервать;
			Исключение
				Если Н = 10 Тогда
					ВызватьИсключение;
				КонецЕсли;
				Пауза(1);
			КонецПопытки;
		КонецЦикла;
		Поле.ВыполнитьВыборИзВыпадающегоСписка(Выбор);
		Пауза(1);
		Возврат Поле.ПолучитьОтображаемыйТекст();
	ИначеЕсли Шаг = "изменить" Тогда
		// начать правку текущей строки таблицы (как F2): изменить | Таблица | ИмяПоляКолонки — сначала встать на
		// колонку: правка, начатая на колонке «только просмотр», ввода в другую не принимает (ZHDRM)
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Если ЗначениеЗаполнено(А2) Тогда
			Элемент_(Тип("ТестируемоеПолеФормы"), А2).Активизировать();
		КонецЕсли;
		Таблица.ИзменитьСтроку();
		Пауза(1);
		Возврат "";
	ИначеЕсли Шаг = "завершить" Тогда
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.ЗакончитьРедактированиеСтроки();
		Пауза(1);
		Возврат "";
	ИначеЕсли Шаг = "ячейка" Тогда
		// текст ячейки текущей строки: ячейка | Таблица | ИмяПоляКолонки | ожидаемое (на 8.3.27 нет ПолучитьТекущуюСтроку)
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Колонка = Элемент_(Тип("ТестируемоеПолеФормы"), А2);
		// колонку на 8.3.27 задаёт ИМЯ элемента; объект поля молча отдаёт текущую ячейку, заголовок — «отсутствует
		// указанное значение» (ZHDRM, 09.10.2026). Остальные варианты — для других версий платформы.
		Попытка
			Текст = Таблица.ПолучитьТекстЯчейки(А2);
		Исключение
			Текст = Таблица.ПолучитьТекстЯчейки(Колонка.ТекстЗаголовка);
		КонецПопытки;
		Проверить(Текст, А3);
		Возврат Текст;
	ИначеЕсли Шаг = "выбор" Тогда
		// кнопка выбора («…») поля или ячейки строки в режиме правки: выбор | ИмяПоля (UP, 17.10.2026)
		Поле = Элемент_(Тип("ТестируемоеПолеФормы"), А1);
		Попытка
			Поле.Активизировать();
		Исключение
		КонецПопытки;
		Поле.Выбрать();                         // кнопка выбора поля («НажатьКнопкуВыбора» у поля нет — 8.5.1)
		Пауза(2);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "выделить" Тогда
		// выделить все строки таблицы: выделить | Таблица (UP, 17.10.2026)
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Таблица.ВыделитьВсеСтроки();
		Пауза(1);
		Возврат "";
	ИначеЕсли Шаг = "открыть" Тогда
		Таблица = Элемент_(Тип("ТестируемаяТаблицаФормы"), А1);
		Таблица.Активизировать();
		Таблица.Выбрать();
		Пауза(2);
		Возврат Заголовок_(Форма_());
	ИначеЕсли Шаг = "вопрос" Тогда
		// ответ в диалоге ПоказатьВопрос/ПоказатьПредупреждение: кнопка по заголовку
		Для Н = 1 По 20 Цикл
			Ф = Форма_();
			Кнопка = Неопределено;
			Если Ф <> Неопределено Тогда
				Кнопка = Ф.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), А1);
			КонецЕсли;
			Если Кнопка <> Неопределено Тогда
				Текст = Заголовок_(Ф);
				Кнопка.Нажать();
				Пауза(1);
				Возврат Текст;
			КонецЕсли;
			Пауза(1);
		КонецЦикла;
		ВызватьИсключение "нет диалога с кнопкой «" + А1 + "», активна: " + Заголовок_(Форма_());
	ИначеЕсли Шаг = "закрыть" Тогда
		Ф = Форма_();
		Текст = Заголовок_(Ф);
		ТП.ПолучитьАктивноеОкно().Закрыть();   // у ТестируемаяФорма метода Закрыть нет — закрывается окно
		Пауза(2);
		// закрыть | без сохранения: если 1С спросит «Данные были изменены. Сохранить?» — «Нет»; не спросит — дальше
		// (шаг «вопрос» в этом случае ждал бы диалога и падал) (UP, 17.10.2026)
		Если НРег(А1) = "без сохранения" Тогда
			ФВопрос = Форма_();
			Если ФВопрос <> Неопределено Тогда
				Кнопка = ФВопрос.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Нет");
				Если Кнопка <> Неопределено Тогда
					Кнопка.Нажать();
					Пауза(1);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Возврат Текст;
	ИначеЕсли Шаг = "закрыть-форму" Тогда
		// закрыть активное окно, только если заголовок его формы начинается с А1 (после необязательного «?выбор»:
		// не открылось — родительскую форму не закрывать) (UP, 17.10.2026)
		Текст = Заголовок_(Форма_());
		Если СтрНачинаетсяС(НРег(Текст), НРег(А1)) Тогда
			ТП.ПолучитьАктивноеОкно().Закрыть();
			Пауза(2);
			Возврат "закрыто: " + Текст;
		КонецЕсли;
		Возврат "не открыто (активна: " + Текст + ")";
	ИначеЕсли Шаг = "снимок" Тогда
		// запрос снимка: Python снимает окно тестируемого клиента и удаляет файл запроса
		ЗаписатьФайл(ПутьЗапросаСнимка, А1);
		Для Н = 1 По 30 Цикл
			Пауза(1);
			Если Не ФайлЕсть(ПутьЗапросаСнимка) Тогда
				Возврат "";
			КонецЕсли;
		КонецЦикла;
		ВызватьИсключение "снимок не сделан";
	ИначеЕсли Шаг = "сообщения" Тогда
		Тексты = Сообщения_();
		Проверить(Тексты, А1);
		Возврат Тексты;
	ИначеЕсли Шаг = "дамп" Тогда
		Возврат Состояние_();
	КонецЕсли;
	ВызватьИсключение "неизвестный шаг «" + Шаг + "»";

КонецФункции

// Строка подсказки ввода/списка выбора, содержащая текст (из platform.py набора: ТестUIСтрокаСписка).
&НаКлиенте
Функция СтрокаСписка_(Поле, Текст)

	Представление = Поле.ПолучитьПредставлениеСпискаВыбора();
	Строки = ?(ТипЗнч(Представление) = Тип("Строка"), СтрРазделить(Представление, Символы.ПС, Ложь), Представление);
	Список = Новый Массив;
	Для Каждого Элемент Из Строки Цикл
		Если ТипЗнч(Элемент) = Тип("Структура") Или ТипЗнч(Элемент) = Тип("ФиксированнаяСтруктура") Тогда
			Части = Новый Массив;
			Выбор = Неопределено;
			Для Каждого КЗ Из Элемент Цикл
				Части.Добавить(КЗ.Ключ + "=" + Строка(КЗ.Значение));
				Если Выбор = Неопределено Или КЗ.Ключ = "ОтображаемыйТекст" Тогда
					Выбор = КЗ.Значение;
				КонецЕсли;
			КонецЦикла;
			Весь = СтрСоединить(Части, ", ");
		Иначе
			Выбор = Элемент;
			Весь = Строка(Элемент);
		КонецЕсли;
		Список.Добавить(Весь);
		Если СтрНайти(НРег(Весь), НРег(Текст)) > 0 Тогда
			Возврат Выбор;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "в подсказке нет «" + Текст + "»: " + СтрСоединить(Список, "; ");

КонецФункции

// «текст» — должно содержать; «!текст» — не должно; пусто — без проверки.
&НаКлиенте
Процедура Проверить(Текст, Ожидаемое)

	Если Лев(Ожидаемое, 1) = "!" Тогда
		Если СтрНайти(НРег(Текст), НРег(Сред(Ожидаемое, 2))) > 0 Тогда
			ВызватьИсключение "«" + Текст + "» не должно содержать «" + Сред(Ожидаемое, 2) + "»";
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Ожидаемое) И СтрНайти(НРег(Текст), НРег(Ожидаемое)) = 0 Тогда
		ВызватьИсключение "«" + Текст + "», ожидалось «" + Ожидаемое + "»";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция Форма_()

	ОкноКлиента = ТП.ПолучитьАктивноеОкно();
	Если ОкноКлиента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОкноКлиента.НайтиОбъект(Тип("ТестируемаяФорма"));

КонецФункции

&НаКлиенте
Функция Заголовок_(Объект)

	Если Объект = Неопределено Тогда
		Возврат "<нет>";
	КонецЕсли;
	Попытка
		Возврат Объект.ТекстЗаголовка;
	Исключение
		Возврат "<?>";
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция Элемент_(ТипЭлемента, ИмяИлиЗаголовок)

	Форма = Форма_();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "нет активной формы";
	КонецЕсли;
	Элемент = Форма.НайтиОбъект(ТипЭлемента, , ИмяИлиЗаголовок);
	Если Элемент = Неопределено Тогда
		Элемент = Форма.НайтиОбъект(ТипЭлемента, ИмяИлиЗаголовок);
	КонецЕсли;
	Если Элемент = Неопределено Тогда
		ВызватьИсключение "на форме «" + Заголовок_(Форма) + "» нет элемента «" + ИмяИлиЗаголовок + "» (" + ТипЭлемента + ")";
	КонецЕсли;
	Возврат Элемент;

КонецФункции

&НаКлиенте
Функция Сообщения_()

	Тексты = Новый Массив;
	Для Каждого ОкноКлиента Из ТП.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
		Попытка
			Для Каждого Т Из ОкноКлиента.ПолучитьТекстыСообщенийПользователю() Цикл
				Тексты.Добавить(Т);
			КонецЦикла;
		Исключение
			// панель сообщений есть только у основного окна
		КонецПопытки;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

&НаКлиенте
Функция Состояние_()

	Строки = Новый Массив;
	Попытка
		Для Каждого ОкноКлиента Из ТП.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
			Строки.Добавить("  окно: " + Заголовок_(ОкноКлиента));
		КонецЦикла;
		Форма = Форма_();
		Строки.Добавить("  активная форма: " + Заголовок_(Форма));
		Строки.Добавить("  сообщения: " + Сообщения_());
		Если Форма <> Неопределено Тогда
			Дерево(Форма, Строки, "    ", 0);
		КонецЕсли;
	Исключение
		Строки.Добавить("  состояние недоступно: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура Дерево(Объект, Строки, Отступ, Глубина)

	Если Глубина > 6 Или Строки.Количество() > 300 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Подчиненный Из Объект.ПолучитьПодчиненныеОбъекты() Цикл
		Имя = "";
		Попытка
			Имя = Подчиненный.Имя;
		Исключение
		КонецПопытки;
		Строки.Добавить(Отступ + Строка(ТипЗнч(Подчиненный)) + " " + Имя + " «" + Заголовок_(Подчиненный) + "»");
		Дерево(Подчиненный, Строки, Отступ + "  ", Глубина + 1);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Пауза(Секунд)

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;

КонецПроцедуры

// Файлы — на сервере (файловая база: тот же компьютер); синхронные файловые вызовы клиента
// в типовой могут быть запрещены.
&НаСервереБезКонтекста
Функция ПрочитатьФайл(Путь)

	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

&НаСервереБезКонтекста
Функция ФайлЕсть(Путь)

	Файл = Новый Файл(Путь);   // метод у выражения «Новый …» не вызывается — «Неопознанный оператор»
	Возврат Файл.Существует();

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьФайл(Путь, Содержимое)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(Содержимое);
	Текст.Записать(Путь, КодировкаТекста.UTF8);

КонецПроцедуры
