&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Каталог = "%OUT%";
	СоздатьКаталог(Каталог);
	Журнал = Новый Массив;
	Для Каждого МД Из Метаданные.Справочники Цикл
		Журнал.Добавить(ВыгрузитьСправочник(МД, Каталог));
	КонецЦикла;
	Для Каждого МД Из Метаданные.Документы Цикл
		Журнал.Добавить(ВыгрузитьДокумент(МД, Каталог));
	КонецЦикла;
	Для Каждого МД Из Метаданные.РегистрыСведений Цикл
		Журнал.Добавить(ВыгрузитьРегистр(МД, Каталог));
	КонецЦикла;
	Константы_ = Новый Структура;
	Для Каждого МД Из Метаданные.Константы Цикл
		Константы_.Вставить(МД.Имя, ЗначениеДляJSON(Константы[МД.Имя].Получить()));
	КонецЦикла;
	ЗаписатьФайл(Каталог + "\Константы.json", Константы_);
	Пользователи_ = Новый Массив;
	Для Каждого П Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Роли = Новый Массив;
		Для Каждого Р Из П.Роли Цикл
			Роли.Добавить(Р.Имя);
		КонецЦикла;
		Пользователи_.Добавить(Новый Структура("uuid, name, full_name, roles",
			Строка(П.УникальныйИдентификатор), П.Имя, П.ПолноеИмя, Роли));
	КонецЦикла;
	ЗаписатьФайл(Каталог + "\ПользователиИБ.json", Пользователи_);
	ЗаписатьФайл(Каталог + "\_журнал.json", Журнал);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеДляJSON(Значение)
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Строка") ИЛИ Тип = Тип("Число") ИЛИ Тип = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат ?(Значение = Дата(1, 1, 1), Неопределено, XMLСтрока(Значение));
	ИначеЕсли Тип = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли Тип = Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(Тип) ИЛИ Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Если Значение.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("ref, type", Строка(Значение.УникальныйИдентификатор()), Значение.Метаданные().Имя);
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Если Значение.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

&НаСервереБезКонтекста
Функция Скрыть(Имя)
	Возврат СтрНайти(НРег(Имя), "пароль") > 0;
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьРеквизиты(Запись, Источник, МД)
	Для Каждого Р Из МД.Реквизиты Цикл
		Если НЕ Скрыть(Р.Имя) Тогда
			Запись.Вставить(Р.Имя, ЗначениеДляJSON(Источник[Р.Имя]));
		КонецЕсли;
	КонецЦикла;
	Если МД.ТабличныеЧасти.Количество() > 0 Тогда
		Части = Новый Структура;
		Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
			Строки = Новый Массив;
			Для Каждого Стр Из Источник[ТЧ.Имя] Цикл
				Строка_ = Новый Структура("line", Стр.НомерСтроки);
				Для Каждого Р Из ТЧ.Реквизиты Цикл
					Если НЕ Скрыть(Р.Имя) Тогда
						Строка_.Вставить(Р.Имя, ЗначениеДляJSON(Стр[Р.Имя]));
					КонецЕсли;
				КонецЦикла;
				Строки.Добавить(Строка_);
			КонецЦикла;
			Части.Вставить(ТЧ.Имя, Строки);
		КонецЦикла;
		Запись.Вставить("_tables", Части);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыгрузитьСправочник(МД, Каталог)
	Записи = Новый Массив;
	Выборка = Справочники[МД.Имя].Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.ПолучитьОбъект();
		Запись = Новый Структура("ref, code, name, deleted, predefined",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()), ЗначениеДляJSON(Объект.Код),
			Объект.Наименование, Объект.ПометкаУдаления, Объект.Предопределенный);
		Если МД.Иерархический Тогда
			Запись.Вставить("parent", ЗначениеДляJSON(Объект.Родитель));
			Запись.Вставить("folder", Объект.ЭтоГруппа);
		КонецЕсли;
		Если МД.Владельцы.Количество() > 0 Тогда
			Запись.Вставить("owner", ЗначениеДляJSON(Объект.Владелец));
		КонецЕсли;
		Если НЕ (МД.Иерархический И Объект.ЭтоГруппа) Тогда
			ДобавитьРеквизиты(Запись, Объект, МД);
		КонецЕсли;
		Записи.Добавить(Запись);
	КонецЦикла;
	ЗаписатьФайл(Каталог + "\Справочник." + МД.Имя + ".json", Записи);
	Возврат Новый Структура("object, count", "Справочник." + МД.Имя, Записи.Количество());
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьДокумент(МД, Каталог)
	Записи = Новый Массив;
	Выборка = Документы[МД.Имя].Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.ПолучитьОбъект();
		Запись = Новый Структура("ref, number, date, posted, deleted",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()), Объект.Номер, XMLСтрока(Объект.Дата),
			Объект.Проведен, Объект.ПометкаУдаления);
		ДобавитьРеквизиты(Запись, Объект, МД);
		Записи.Добавить(Запись);
	КонецЦикла;
	ЗаписатьФайл(Каталог + "\Документ." + МД.Имя + ".json", Записи);
	Возврат Новый Структура("object, count", "Документ." + МД.Имя, Записи.Количество());
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьРегистр(МД, Каталог)
	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений." + МД.Имя);
	Таблица = Запрос.Выполнить().Выгрузить();
	Записи = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Запись = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Запись.Вставить(Колонка.Имя, ЗначениеДляJSON(Стр[Колонка.Имя]));
		КонецЦикла;
		Записи.Добавить(Запись);
	КонецЦикла;
	ЗаписатьФайл(Каталог + "\РегистрСведений." + МД.Имя + ".json", Записи);
	Возврат Новый Структура("object, count", "РегистрСведений." + МД.Имя, Записи.Количество());
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьФайл(Путь, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8", Ложь);
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();
КонецПроцедуры
