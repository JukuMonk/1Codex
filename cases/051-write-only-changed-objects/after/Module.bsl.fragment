ТекущиеУзлы = УзлыДляСравнения();   // один запрос: Ссылка → Структура полей
Для Каждого Узел Из Пакет["узлы"] Цикл
	СсылкаУзла = СсылкаПоИд("мвмУзлыКарты", Узел["ид"], Идентификаторы);
	Текущий = ТекущиеУзлы.Получить(СсылкаУзла);
	Если Текущий <> Неопределено И УзелНеИзменился(Текущий, Узел) Тогда
		Продолжить;                                                        // ни объекта, ни записи
	КонецЕсли;
	ЭлементСправочника = ПолучитьДляЗаписи("мвмУзлыКарты", Узел["ид"]);
	…
	ЭлементСправочника.Записать();
КонецЦикла;

Функция ЧислаРавны(А, Б, Знаков)
	Возврат Окр(ЧислоИлиНоль(А), Знаков) = Окр(ЧислоИлиНоль(Б), Знаков);
КонецФункции
