def ф(cn, д):
    '''Дата 1С → «дд.мм чч:мм» без Формат(): XMLString даёт «гггг-мм-ддTчч:мм:сс».'''
    с = cn.XMLString(д)
    return '%s.%s %s' % (с[8:10], с[5:7], с[11:16])


def запрос(cn, текст, **парам):
    з = cn.NewObject('Запрос', текст)
    for к, з2 in парам.items():
        з.УстановитьПараметр(к, з2)
    т = з.Выполнить().Выгрузить()
    поля = [т.Колонки.Получить(и).Имя for и in range(т.Колонки.Количество())]
    return [{п: т.Получить(и).Получить(к) for к, п in enumerate(поля)} for и in range(т.Количество())]


def заказ(cn, номер):
    # НайтиПоНомеру без даты не находит при нумерации в пределах года — запросом, последний по дате
    return запрос(cn, 'ВЫБРАТЬ З.Ссылка КАК З ИЗ Документ.уатЗаказГрузоотправителя КАК З ГДЕ З.Номер = &Н '
                      'УПОРЯДОЧИТЬ ПО З.Дата УБЫВ', Н='%011d' % номер)[0]['З']

