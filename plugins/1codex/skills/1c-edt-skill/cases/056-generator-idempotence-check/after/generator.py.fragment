def заменить(текст, было, стало, метка):
    if стало in текст:                          # применено — этого достаточно
        print('  уже: %s' % метка)
        return текст
    if текст.count(было) != 1:
        sys.exit('ОШИБКА: якорь «%s» найден %d раз' % (метка, текст.count(было)))
    return текст.replace(было, стало, 1)

# в конце шага:
открыто = len(re.findall(r'^(Функция|Процедура)\s', текст, re.M))
закрыто = len(re.findall(r'^(КонецФункции|КонецПроцедуры)', текст, re.M))
if открыто != закрыто:
    sys.exit('ОШИБКА: %d объявлений против %d завершений' % (открыто, закрыто))
