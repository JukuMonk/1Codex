// 1. Зоны пишутся все — сравнения нет.
Для Каждого Зона Из Пакет["геозоны"] Цикл
	ЭлементСправочника = ПолучитьДляЗаписи("уатГеозоны_уэ", Зона["ид"]);
	…
	ЭлементСправочника.Записать();
КонецЦикла;
// 2. Привязка — весь регистр заново.
ПересчитатьПривязкуКГеозонам();
// 3. Первая правка: соответствие по ссылке читается помощником для СТРОКОВЫХ ключей.
Зона.Вставить("Контур", ЗначениеПоКлючу(Контуры, Выборка.Ссылка, Пустой));   // всегда Пустой
