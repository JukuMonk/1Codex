// Независимый регистр сведений: запись набором, чтение ЗАПРОСОМ.
//
// РегистрыСведений.X.Получить(Отбор) возвращает структуру ВСЕГДА — с пустыми
// ресурсами, если записи нет; Неопределено — никогда (case 018). Поэтому
// «есть ли запись» проверяем запросом, а Получить оставляем только там,
// где пустое значение и отсутствие записи означают одно и то же (настройки).

// Одна актуальная запись на объект: набор с отбором по измерению
// перезаписывает прежнюю.
&НаСервере
Процедура ОтметитьНедоступность(Объект, Минут, Причина)

	Набор = РегистрыСведений.ПримерНедоступность.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.НедоступенС = ТекущаяДата();
	Запись.НедоступенПо = ТекущаяДата() + Минут * 60;
	Запись.Причина = Лев(Причина, 100);
	Набор.Записать();

КонецПроцедуры

// Снять запись: пустой набор с тем же отбором.
&НаСервере
Процедура СнятьНедоступность(Объект)

	Набор = РегистрыСведений.ПримерНедоступность.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Записать();

КонецПроцедуры

// Есть ли действующая запись — запросом.
&НаСервере
Функция Недоступность(Объект)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Записи.НедоступенПо КАК НедоступенПо,
		|	Записи.Причина КАК Причина
		|ИЗ
		|	РегистрСведений.ПримерНедоступность КАК Записи
		|ГДЕ
		|	Записи.Объект = &Объект
		|	И Записи.НедоступенПо > &Сейчас");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("По, Причина", Выборка.НедоступенПо, Выборка.Причина);

КонецФункции

// Настройка «ключ → значение»: здесь Получить уместен — пустая строка и
// отсутствие записи значат одно: «не задано».
&НаСервере
Функция Настройка(Раздел, Ключ)

	Отбор = Новый Структура("Раздел, Ключ", Раздел, Ключ);
	Возврат РегистрыСведений.ПримерНастройки.Получить(Отбор).Значение;

КонецФункции

// Запись объекта в режиме загрузки: свойство СТРУКТУРЫ ОбменДанными
// (case 014); нужно, когда типовые проверки заполнения мешают записать
// один свой реквизит в чужой объект.
&НаСервере
Процедура ЗаписатьСсылкуВЧужойОбъект(Ссылка, Значение)

	// Не «Объект = …»: в модуле формы это имя занято (case 010).
	ОбъектЗаписи = Ссылка.ПолучитьОбъект();
	Если ОбъектЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбъектЗаписи.НашРеквизит = Значение;
	ОбъектЗаписи.ОбменДанными.Загрузка = Истина;
	ОбъектЗаписи.Записать();

КонецПроцедуры
