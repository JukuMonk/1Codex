// «Сменные задания» мастера (итерация 13; с 16.10.2026 — нативная форма 1С, от маршрутных листов 1С:ERP).
// Цех, дата, смена; строка обмена с ERP и сменного задания; показатели смены (загрузка, доступность, простои без
// причины, операции, годные); вкладки: станки смены (двойной щелчок — рабочее место оператора), операции задания,
// операции маршрутных листов к постановке (станок из допустимых, количество → «Поставить в смену»), простои без
// причины. Данные — пульс_Производство.ДанныеМастера() (JSON), действия — КомандаМастера(); обновление раз в минуту.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Смена_ = пульс_Производство.ТекущаяСмена(ТекущаяДатаСеанса());
	Дата = Смена_.Дата;
	Смена = Смена_.Смена;
	ТолькоДоступные = Истина;
	Цех = ЦехПоУмолчанию(Дата);
	Элементы.Смена.СписокВыбора.Добавить(1, "1 (08:00–16:30)");
	Элементы.Смена.СписокВыбора.Добавить(2, "2 (16:30–00:30)");
	Оформить();
	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ОбновитьПоТаймеру", 60);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура СтанкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка_ = Станки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка_ <> Неопределено Тогда
		ОткрытьФорму("Обработка.пульс_РабочееМестоОператора.Форма", Новый Структура("Оборудование", Строка_.Оборудование),
			, Строка(Строка_.Оборудование));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОперацииЛистовСтанокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка_ = Элементы.ОперацииЛистов.ТекущиеДанные;
	Если Строка_ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СтанокВыбран", ЭтотОбъект, Строка_.ПолучитьИдентификатор()),
		ДопустимыеСтанки(Строка_.Станки), Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ПричинаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПричинаВыбрана", ЭтотОбъект), СписокПричин(), Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ОбменERP(Команда)

	Показать(Выполнить_(Новый Структура("cmd", "exchange")));

КонецПроцедуры

&НаКлиенте
Процедура ЖурналОбмена(Команда)

	ОткрытьФорму("РегистрСведений.пульс_ЖурналОбменаERP.ФормаСписка");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвтоматически(Команда)

	Если Не ЗначениеЗаполнено(Цех) Тогда
		ПоказатьПредупреждение(, "Выберите цех.");
		Возврат;
	КонецЕсли;
	Показать(Выполнить_(КомандаСмены("auto")));

КонецПроцедуры

&НаКлиенте
Процедура ВыдатьНаУчасток(Команда)

	Если ЗначениеЗаполнено(Задание) Тогда
		Показать(Выполнить_(Новый Структура("cmd, doc", "issue", ИдентификаторСсылки(Задание))));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗадание(Команда)

	Если ЗначениеЗаполнено(Задание) Тогда
		ПоказатьЗначение(, Задание);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьВСмену(Команда)

	Сообщения = Новый Массив;
	Для Каждого Идентификатор Из Элементы.ОперацииЛистов.ВыделенныеСтроки Цикл
		Строка_ = ОперацииЛистов.НайтиПоИдентификатору(Идентификатор);
		Если Строка_ = Неопределено Или Строка_.Доступно <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка_.Станок) Тогда
			Сообщения.Добавить(Строка_.НомерЛиста + ", " + Строка_.Операция + ": выберите станок.");
			Продолжить;
		КонецЕсли;
		Параметры_ = КомандаСмены("plan");
		Параметры_.Вставить("rs", Строка_.Лист);
		Параметры_.Вставить("op", Строка_.ИдОперации);
		Параметры_.Вставить("eq", ИдентификаторСсылки(Строка_.Станок));
		Параметры_.Вставить("qty", ?(Строка_.Количество > 0, Строка_.Количество, Строка_.Доступно));
		Сообщения.Добавить(ВыполнитьБезОбновления(Параметры_));
	КонецЦикла;
	ЗаполнитьДанные();
	Если Сообщения.Количество() Тогда
		ПоказатьОповещениеПользователя("Сменное задание", , СтрСоединить(Сообщения, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УбратьИзСмены(Команда)

	Для Каждого Идентификатор Из Элементы.ОперацииЗадания.ВыделенныеСтроки Цикл
		Строка_ = ОперацииЗадания.НайтиПоИдентификатору(Идентификатор);
		Если Строка_ <> Неопределено Тогда
			ВыполнитьБезОбновления(Новый Структура("cmd, doc, row", "unplan", Строка_.Документ, Строка_.Строка));
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЛист(Команда)

	Строка_ = Элементы.ОперацииЛистов.ТекущиеДанные;
	Если Строка_ <> Неопределено Тогда
		ПоказатьЗначение(, СсылкаЛиста(Строка_.Лист));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УказатьПричину(Команда)

	Если Не ЗначениеЗаполнено(Причина) Тогда
		ПоказатьПредупреждение(, "Выберите причину простоя.");
		Возврат;
	КонецЕсли;
	Отмеченные = Новый Массив;
	Для Каждого Строка_ Из Простои Цикл
		Если Строка_.Пометка Тогда
			Отмеченные.Добавить(Новый Структура("eq, s", ИдентификаторСсылки(Строка_.Оборудование), Строка_.НачалоUTC));
		КонецЕсли;
	КонецЦикла;
	Если Отмеченные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте простои в списке.");
		Возврат;
	КонецЕсли;
	Если ТребуетКомментарий(Причина) И ПустаяСтрока(КомментарийПричины) Тогда
		ПоказатьПредупреждение(, "Для этой причины нужен комментарий.");
		Возврат;
	КонецЕсли;
	Показать(Выполнить_(Новый Структура("cmd, items, reason, note", "reason", Отмеченные, ИдентификаторСсылки(Причина),
		КомментарийПричины)));
	КомментарийПричины = "";

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого Строка_ Из Простои Цикл
		Строка_.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьПоТаймеру()

	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура СтанокВыбран(Результат, Идентификатор) Экспорт

	Строка_ = ОперацииЛистов.НайтиПоИдентификатору(Идентификатор);
	Если Результат <> Неопределено И Строка_ <> Неопределено Тогда
		Строка_.Станок = Результат.Значение;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПричинаВыбрана(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> Неопределено Тогда
		Причина = Результат.Значение;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Показать(Сообщение)

	Если Не ПустаяСтрока(Сообщение) Тогда
		ПоказатьОповещениеПользователя("Сменные задания", , Сообщение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция КомандаСмены(Имя)

	// XMLСтрока на клиенте веб-клиента нет (Ж-153) — дата строкой через Формат
	Возврат Новый Структура("cmd, shop, date, n", Имя, ИдентификаторСсылки(Цех), Формат(Дата, "ДФ=yyyy-MM-dd") + "T00:00:00", Смена);

КонецФункции

&НаСервере
Функция Выполнить_(Параметры_)

	Сообщение = пульс_Производство.КомандаМастера(ВJSON(Параметры_));
	ЗаполнитьДанные();
	Возврат Сообщение;

КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьБезОбновления(Параметры_)

	Возврат пульс_Производство.КомандаМастера(ВJSON(Параметры_));

КонецФункции

// Таблицы и показатели формы из данных мастера (JSON пульс_Производство.ДанныеМастера).
&НаСервере
Процедура ЗаполнитьДанные()

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(пульс_Производство.ДанныеМастера(Цех, Дата, Смена));
	Д = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Сейчас = Д.Получить("now");

	// обмен с ERP — одной строкой
	Обмен = Д.Получить("erp");
	Элементы.ОбменСостояние.Заголовок = "1С:ERP · маршрутные листы приходят обменом "
		+ ?(Обмен.Получить("enabled"), "по расписанию", "(обмен выключен)")
		+ ?(Обмен.Получить("t") > 0, " · последний " + Формат(ДатаМс(Обмен.Получить("t")), "ДФ=HH:mm") + " "
		+ ?(Обмен.Получить("ok"), "✓", "✗"), "");

	// сменное задание
	Задание = Документы.пульс_СменноеЗадание.ПустаяСсылка();
	Задания = Д.Получить("docs");
	Если Задания.Количество() Тогда
		Описание = Задания[0];
		Задание = Документы.пульс_СменноеЗадание.ПолучитьСсылку(Новый УникальныйИдентификатор(Описание.Получить("id")));
		Элементы.ЗаданиеСостояние.Заголовок = СтрШаблон("Сменное задание № %1 · %2 · операций %3 · мастер %4",
			Формат(Число(Описание.Получить("no")), "ЧГ=0"), Описание.Получить("status"), Описание.Получить("rows"), Описание.Получить("master"));
	Иначе
		Элементы.ЗаданиеСостояние.Заголовок = ?(ЗначениеЗаполнено(Цех),
			"Сменное задание на эту смену не сформировано — поставьте операции маршрутных листов или заполните автоматически",
			"Выберите цех");
	КонецЕсли;
	Элементы.ВыдатьНаУчасток.Доступность = Задания.Количество() > 0
		И Задания[0].Получить("status") = Строка(Перечисления.пульс_СтатусыСменныхЗаданий.Сформировано);
	Элементы.ОткрытьЗадание.Доступность = Задания.Количество() > 0;
	Элементы.ЗаполнитьАвтоматически.Доступность = ЗначениеЗаполнено(Цех);

	// станки и операции задания
	Станки.Очистить();
	ОперацииЗадания.Очистить();
	ВсегоОпераций = 0;
	Выполнено = 0;
	План = 0;
	Годных = 0;
	Брак = 0;
	НормоСекунд = 0;
	БезПричиныПоСтанку = Новый Соответствие;
	Для Каждого Простой Из Д.Получить("open") Цикл
		БезПричиныПоСтанку.Вставить(Простой.Получить("eq"), ЗначениеИлиНоль(БезПричиныПоСтанку, Простой.Получить("eq"))
			+ Простой.Получить("dur"));
	КонецЦикла;
	Для Каждого Машина Из Д.Получить("machines") Цикл
		Строка_ = Станки.Добавить();
		Строка_.Оборудование = Справочники.пульс_Оборудование.ПолучитьСсылку(Новый УникальныйИдентификатор(Машина.Получить("id")));
		Код = Машина.Получить("st");
		Если Код = "I" И Машина.Получить("since") > 0 И Сейчас - Машина.Получить("since") >= 15 * 60000 Тогда
			Код = "L";
		КонецЕсли;
		Строка_.КодСостояния = Код;
		Строка_.Состояние = ИмяСостояния(Код) + ?(Машина.Получить("since") > 0, " · "
			+ Длительность((Сейчас - Машина.Получить("since")) / 1000), "");
		Регистрация = Машина.Получить("reg");
		Строка_.Оператор = ?(Регистрация = Неопределено, "не зарегистрирован", Регистрация.Получить("name"));
		Текущая = Неопределено;
		Готово = 0;
		Для Каждого Операция Из Машина.Получить("ops") Цикл
			Если Текущая = Неопределено И (Операция.Получить("st") = "W" Или Операция.Получить("st") = "P") Тогда
				Текущая = Операция;
			КонецЕсли;
			Если Операция.Получить("st") = "D" Тогда
				Готово = Готово + 1;
			КонецЕсли;
			СтрокаОперации = ОперацииЗадания.Добавить();
			СтрокаОперации.Оборудование = Строка_.Оборудование;
			СтрокаОперации.МаршрутныйЛист = Операция.Получить("route");
			СтрокаОперации.Операция = Операция.Получить("op");
			СтрокаОперации.ДСЕ = Операция.Получить("dse");
			СтрокаОперации.План = Операция.Получить("plan");
			СтрокаОперации.Годных = Операция.Получить("good");
			СтрокаОперации.Брак = Операция.Получить("scrap");
			Брак = Брак + Операция.Получить("scrap");
			НормоСекунд = НормоСекунд + (Операция.Получить("good") + Операция.Получить("scrap")) * Операция.Получить("norm") * 60;
			СтрокаОперации.КодСтатуса = Операция.Получить("st");
			СтрокаОперации.Статус = ИмяСтатуса(Операция.Получить("st"));
			СтрокаОперации.Оператор = Операция.Получить("oper");
			СтрокаОперации.Документ = Операция.Получить("doc");
			СтрокаОперации.Строка = Операция.Получить("row");
		КонецЦикла;
		Если Текущая = Неопределено Тогда
			Для Каждого Операция Из Машина.Получить("ops") Цикл
				Если Текущая = Неопределено И Операция.Получить("st") = "A" Тогда
					Текущая = Операция;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Строка_.ТекущаяОперация = ?(Текущая = Неопределено, "все выполнены", Текущая.Получить("dse") + " · "
			+ Текущая.Получить("op") + ?(Текущая.Получить("st") = "A", " (ожидает)", ""));
		Строка_.Выполнение = Формат(Машина.Получить("good"), "ЧН=0; ЧГ=0") + " / " + Формат(Машина.Получить("plan"), "ЧН=0; ЧГ=0");
		Строка_.Операций = Формат(Готово, "ЧН=0") + " из " + Машина.Получить("ops").Количество();
		ФондСтанка = Машина.Получить("fund");
		СуммаСтанка = СуммаФонда(ФондСтанка);
		Строка_.Работа = ?(СуммаСтанка > 0, 100 * ФондСтанка.Получить("W") / СуммаСтанка, 0);
		Секунд = ЗначениеИлиНоль(БезПричиныПоСтанку, Машина.Получить("id"));
		Строка_.БезПричины = ?(Секунд > 0, Длительность(Секунд), "");
		ВсегоОпераций = ВсегоОпераций + Машина.Получить("ops").Количество();
		Выполнено = Выполнено + Готово;
		План = План + Машина.Получить("plan");
		Годных = Годных + Машина.Получить("good");
	КонецЦикла;

	// показатели смены
	Фонд = Д.Получить("fund");
	Всего = СуммаФонда(Фонд);
	// Кз, Кг, OEE — те же формулы, что в отчёте «Эффективность оборудования» (пульс_Производство)
	К = пульс_Производство.КоэффициентыЭффективности(Всего, Фонд.Получить("W"), Фонд.Получить("V"),
		Фонд.Получить("R") + Фонд.Получить("S"), Годных, Брак, НормоСекунд);
	УстановитьПоказатель("Загрузка", Процент(К.Кз), "работа к фонду смены");
	УстановитьПоказатель("Доступность", Процент(К.Кг), "фонд без внеплановых остановов");
	УстановитьПоказатель("OEE", Процент(К.OEE), "Д " + Процент(К.Доступность, Ложь) + " × П "
		+ Процент(К.Производительность, Ложь) + " × К " + Процент(К.Качество, Ложь));
	УстановитьПоказатель("Простои", Длительность(Фонд.Получить("N")), ?(Всего > 0,
		Формат(100 * Фонд.Получить("N") / Всего, "ЧДЦ=1; ЧН=0") + " % фонда смены", ""));
	УстановитьПоказатель("Операции", Формат(Выполнено, "ЧН=0") + " из " + Формат(ВсегоОпераций, "ЧН=0"), "выполнено");
	УстановитьПоказатель("Годных", Формат(Годных, "ЧН=0; ЧГ=0") + " из " + Формат(План, "ЧН=0; ЧГ=0"), "план смены, шт");

	// операции маршрутных листов
	ОперацииЛистов.Очистить();
	КПостановке = 0;
	Для Каждого Лист Из Д.Получить("rs") Цикл
		Для Каждого Операция Из Лист.Получить("ops") Цикл
			Если Операция.Получить("avail") > 0 Тогда
				КПостановке = КПостановке + 1;
			ИначеЕсли ТолькоДоступные Тогда
				Продолжить;
			КонецЕсли;
			Строка_ = ОперацииЛистов.Добавить();
			Строка_.Лист = Лист.Получить("id");
			Строка_.НомерЛиста = Лист.Получить("no");
			Строка_.Срочный = Лист.Получить("prio") = 1;
			Строка_.ДСЕ = Лист.Получить("dse");
			Строка_.Срок = НачалоДня(ДатаМс(Лист.Получить("end")));
			Строка_.ИдОперации = Операция.Получить("id");
			Строка_.Операция = Операция.Получить("no") + " " + Операция.Получить("n");
			Строка_.ВидРЦ = Операция.Получить("wc");
			Строка_.Партия = Операция.Получить("qty");
			Строка_.ВСменах = Операция.Получить("plan");
			Строка_.Годных = Операция.Получить("good");
			Строка_.Доступно = Операция.Получить("avail");
			Строка_.Количество = Операция.Получить("avail");
			Идентификаторы = Новый Массив;
			Для Каждого Станок Из Операция.Получить("eqs") Цикл
				Идентификаторы.Добавить(Станок.Получить("id"));
			КонецЦикла;
			Строка_.Станки = СтрСоединить(Идентификаторы, ";");
			Если Идентификаторы.Количество() = 1 Тогда
				Строка_.Станок = Справочники.пульс_Оборудование.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификаторы[0]));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Элементы.СтраницаЛисты.Заголовок = "Маршрутные листы из 1С:ERP (" + Формат(КПостановке, "ЧН=0") + ")";
	Элементы.СтраницаОперации.Заголовок = "Операции задания (" + Формат(ВсегоОпераций, "ЧН=0") + ")";
	Элементы.СтраницаСтанки.Заголовок = "Станки смены (" + Формат(Станки.Количество(), "ЧН=0") + ")";

	// простои без причины — отметки переживают обновление
	Отмеченные = Новый Соответствие;
	Для Каждого Строка_ Из Простои Цикл
		Если Строка_.Пометка Тогда
			Отмеченные.Вставить(Строка(Строка_.Оборудование.УникальныйИдентификатор()) + "|" + Строка_.НачалоUTC, Истина);
		КонецЕсли;
	КонецЦикла;
	Простои.Очистить();
	Для Каждого Простой Из Д.Получить("open") Цикл
		Строка_ = Простои.Добавить();
		Строка_.Оборудование = Справочники.пульс_Оборудование.ПолучитьСсылку(Новый УникальныйИдентификатор(Простой.Получить("eq")));
		Строка_.Период = Формат(ДатаМс(Простой.Получить("from")), "ДФ=HH:mm") + "–"
			+ ?(Простой.Получить("open"), "сейчас", Формат(ДатаМс(Простой.Получить("to")), "ДФ=HH:mm"));
		Строка_.Длительность = Длительность(Простой.Получить("dur"));
		Строка_.КодСостояния = Простой.Получить("st");
		Строка_.Состояние = ?(Простой.Получить("st") = "F", "станок выключен", "включён, не работает");
		Строка_.НачалоUTC = Простой.Получить("s");
		Строка_.Пометка = Отмеченные.Получить(Простой.Получить("eq") + "|" + Строка_.НачалоUTC) = Истина;
	КонецЦикла;
	Элементы.СтраницаПростои.Заголовок = "Простои без причины (" + Формат(Простои.Количество(), "ЧН=0") + ")";

КонецПроцедуры

&НаСервере
Процедура УстановитьПоказатель(Имя, Значение, Пояснение)

	Элементы["Значение" + Имя].Заголовок = Значение;
	Элементы["Пояснение" + Имя].Заголовок = Пояснение;

КонецПроцедуры

// Шрифты и цвета: показатели, строка обмена, состояния и статусы в таблицах (условное оформление).
&НаСервере
Процедура Оформить()

	Серый = Новый Цвет(102, 113, 126);
	Для Каждого Имя Из СтрРазделить("Загрузка,Доступность,OEE,Простои,Операции,Годных", ",") Цикл
		Элементы["Значение" + Имя].Шрифт = Новый Шрифт(, 15, Истина);
		Элементы["Заголовок" + Имя].ЦветТекста = Серый;
		Элементы["Пояснение" + Имя].ЦветТекста = Серый;
	КонецЦикла;
	Элементы.ЗначениеПростои.ЦветТекста = Новый Цвет(239, 108, 0);
	Элементы.ЗначениеЗагрузка.ЦветТекста = Новый Цвет(46, 125, 50);
	Элементы.ЗначениеOEE.ЦветТекста = Новый Цвет(27, 79, 156);
	Элементы.СтрокаОбмена.ЦветФона = Новый Цвет(255, 249, 227);
	Элементы.ЗаданиеСостояние.Шрифт = Новый Шрифт(, 11, Истина);
	Цвета = Новый Соответствие;
	Цвета.Вставить("W", Новый Цвет(46, 125, 50));
	Цвета.Вставить("O", Новый Цвет(198, 40, 40));
	Цвета.Вставить("I", Новый Цвет(184, 134, 11));
	Цвета.Вставить("L", Новый Цвет(239, 108, 0));
	Цвета.Вставить("F", Новый Цвет(84, 110, 122));
	Цвета.Вставить("X", Новый Цвет(150, 157, 166));
	Для Каждого Элемент Из Цвета Цикл
		ОформитьПоле("Станки.КодСостояния", Элемент.Ключ, "СтанкиСостояние", Элемент.Значение, Истина);
		ОформитьПоле("Простои.КодСостояния", Элемент.Ключ, "ПростоиСостояние", Элемент.Значение, Ложь);
	КонецЦикла;
	ОформитьПоле("ОперацииЗадания.КодСтатуса", "W", "ОперацииЗаданияСтатус", Новый Цвет(46, 125, 50), Истина);
	ОформитьПоле("ОперацииЗадания.КодСтатуса", "P", "ОперацииЗаданияСтатус", Новый Цвет(184, 134, 11), Истина);
	ОформитьПоле("ОперацииЗадания.КодСтатуса", "D", "ОперацииЗаданияСтатус", Серый, Ложь);
	ОформитьПоле("ОперацииЛистов.Срочный", Истина, "ОперацииЛистовНомерЛиста", Новый Цвет(196, 84, 0), Истина);
	ОформитьПоле("ОперацииЛистов.Доступно", 0, "ОперацииЛистов", Новый Цвет(150, 157, 166), Ложь);
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОперацииЛистов.Доступно");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Отбор.ПравоеЗначение = 0;
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОперацииЛистовДоступно");

КонецПроцедуры

&НаСервере
Процедура ОформитьПоле(Путь, Значение, ИмяЭлемента, Цвет, Жирный)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Путь);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Цвет);
	Если Жирный Тогда
		Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));
	КонецЕсли;
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦехПоУмолчанию(Дата_)

	// цех с наибольшим числом операций в заданиях дня, иначе — с наибольшим числом листов к выполнению
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операции.Ссылка.Цех КАК Цех,
	|	КОЛИЧЕСТВО(*) КАК Строк
	|ИЗ
	|	Документ.пульс_СменноеЗадание.Операции КАК Операции
	|ГДЕ
	|	Операции.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|
	|СГРУППИРОВАТЬ ПО
	|	Операции.Ссылка.Цех
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строк УБЫВ");
	Запрос.УстановитьПараметр("Начало", Дата_);
	Запрос.УстановитьПараметр("Конец", КонецДня(Дата_));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цех;
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Листы.Цех КАК Цех,
	|	КОЛИЧЕСТВО(*) КАК Строк
	|ИЗ
	|	Документ.пульс_МаршрутныйЛист КАК Листы
	|ГДЕ
	|	Листы.Статус В (ЗНАЧЕНИЕ(Перечисление.пульс_СтатусыМаршрутныхЛистов.КВыполнению),
	|			ЗНАЧЕНИЕ(Перечисление.пульс_СтатусыМаршрутныхЛистов.ВРаботе))
	|	И НЕ Листы.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Листы.Цех
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строк УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Цех, Справочники.пульс_Цехи.ПустаяСсылка());

КонецФункции

&НаСервереБезКонтекста
Функция ДопустимыеСтанки(Идентификаторы)

	Список = Новый СписокЗначений;
	Для Каждого Идентификатор Из СтрРазделить(Идентификаторы, ";", Ложь) Цикл
		Станок = Справочники.пульс_Оборудование.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Список.Добавить(Станок, Строка(Станок));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Причины простоя по группам потерь: «Группа · Причина», в порядке справочника.
&НаСервереБезКонтекста
Функция СписокПричин()

	Список = Новый СписокЗначений;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Причины.Ссылка КАК Ссылка,
	|	Причины.Наименование КАК Наименование,
	|	ПРЕДСТАВЛЕНИЕ(Причины.Группа) КАК Группа
	|ИЗ
	|	Справочник.пульс_ПричиныПростоя КАК Причины
	|ГДЕ
	|	НЕ Причины.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Причины.Порядок");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Ссылка, Выборка.Группа + " · " + Выборка.Наименование);
	КонецЦикла;
	Возврат Список;

КонецФункции

&НаСервереБезКонтекста
Функция ТребуетКомментарий(Причина_)

	Возврат Причина_.ТребуетКомментарий;

КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторСсылки(Ссылка)

	Возврат ?(ЗначениеЗаполнено(Ссылка), Строка(Ссылка.УникальныйИдентификатор()), "");

КонецФункции

&НаСервереБезКонтекста
Функция СсылкаЛиста(Идентификатор)

	Возврат Документы.пульс_МаршрутныйЛист.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

&НаСервереБезКонтекста
Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаСервереБезКонтекста
Функция ДатаМс(Мс)

	Возврат '19700101' + Цел(Мс / 1000);

КонецФункции

&НаСервереБезКонтекста
Функция СуммаФонда(Фонд_)

	Сумма = 0;
	Для Каждого КлючИЗначение Из Фонд_ Цикл
		Сумма = Сумма + КлючИЗначение.Значение;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеИлиНоль(Соответствие, Ключ)

	Значение = Соответствие.Получить(Ключ);
	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

&НаСервереБезКонтекста
Функция Длительность(Секунд)

	Всего = Макс(0, Окр(Секунд));
	Минут = Цел(Всего / 60);
	Часов = Цел(Минут / 60);
	Возврат ?(Часов > 0, Формат(Часов, "ЧН=0") + " ч " + Формат(Минут % 60, "ЧЦ=2; ЧВН=") + " мин",
		Формат(Минут, "ЧН=0") + " мин");

КонецФункции

&НаСервереБезКонтекста
Функция Процент(Значение, СоЗнаком = Истина)

	Возврат ?(Значение = Неопределено, "—", Формат(Значение, "ЧДЦ=" + ?(СоЗнаком, "1", "0") + "; ЧН=0") + ?(СоЗнаком, " %", ""));

КонецФункции

&НаСервереБезКонтекста
Функция ИмяСостояния(Код)

	Имена = Новый Структура("W, O, I, L, F, X, U", "Работа", "Перегрузка", "Ожидание", "Длительный простой", "Выключен",
		"Нет связи", "Не настроено");
	Возврат ?(Имена.Свойство(Код), Имена[Код], "");

КонецФункции

&НаСервереБезКонтекста
Функция ИмяСтатуса(Код)

	Имена = Новый Структура("A, W, P, D", "Ожидает", "В работе", "Пауза", "Выполнена");
	Возврат ?(Имена.Свойство(Код), Имена[Код], "");

КонецФункции

#КонецОбласти
