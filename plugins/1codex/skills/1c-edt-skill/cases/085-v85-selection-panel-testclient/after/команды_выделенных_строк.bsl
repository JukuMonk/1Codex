// УП, Catalogs/ВерсииСтруктурыОбъектов/Forms/ФормаЭлемента — ДиЗ-03 п.1, 8.5.1.
// Команда формы попадает на панель множественного выделения таблицы, только если у неё
// «Использование выделенных строк» = Использует И задана «Используемая таблица» (AssociatedTable)
// (Руководство разработчика 8.5.1, гл. 7.7.6.8.2 «Командные панели таблицы»). В XML команды тег неизвестен —
// свойство задаётся кодом; CheckModules проверяет имя.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого ИмяКоманды Из СтрРазделить("ЗаполнитьВыделенные,ОчиститьВыделенные", ",") Цикл
		Команды[ИмяКоманды].ИспользуемаяТаблица = Элементы.Реквизиты;
		Команды[ИмяКоманды].ИспользованиеВыделенныхСтрок = ИспользованиеВыделенныхСтрок.Использует;
	КонецЦикла;

КонецПроцедуры

// Строки для обработки — методом таблицы (рекомендация 8.5 вместо ВыделенныеСтроки): выделенные, а без выделения —
// текущая.
&НаКлиенте
Процедура ПрименитьКВыделенным(Колонка, Значение)

	Для Каждого Идентификатор Из Элементы.Реквизиты.ПолучитьСтрокиДляОбработки() Цикл
		СтрокаТЧ = Объект.Реквизиты.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТЧ <> Неопределено Тогда
			СтрокаТЧ[Колонка] = Значение;
		КонецЕсли;
	КонецЦикла;
	Модифицированность = Истина;

КонецПроцедуры

// Подбор «флажками» в 8.5 — родное выделение строк таблицы, без своей колонки «Пометка» (иначе два флажка в строке);
// «Выделить изменяемые» — программно.
&НаКлиенте
Процедура ОтметитьИзменяемые(Команда)

	Элементы.Строки.ВыделенныеСтроки.Очистить();
	Для Каждого СтрокаСписка Из Строки Цикл
		Если СтрокаСписка.Изменяемый Тогда
			Элементы.Строки.ВыделенныеСтроки.Добавить(СтрокаСписка.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
