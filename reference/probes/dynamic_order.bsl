// Фрагмент: вызывающая форма передаёт свой динамический список и имя поля.
// Основные и пользовательские отборы не загружаются заново.
&НаСервере
Процедура ПорядокДинамическогоСписка(Список, ИмяПоля)
	Компоновщик = Список.КомпоновщикНастроек;
	Порядки = Новый Массив;
	Порядки.Добавить(Список.Порядок);
	Порядки.Добавить(Компоновщик.Настройки.Порядок);
	Для Каждого ЭлементНастройки Из Компоновщик.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастройки) = Тип("ПорядокКомпоновкиДанных") Тогда
			Порядки.Добавить(ЭлементНастройки);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Порядок Из Порядки Цикл
		Порядок.Элементы.Очистить();
		ПолеПорядка = Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		ПолеПорядка.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ПолеПорядка.Использование = Истина;
	КонецЦикла;
КонецПроцедуры
