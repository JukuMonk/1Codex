Для Каждого Узел Из Пакет["узлы"] Цикл
	ЭлементСправочника = ПолучитьДляЗаписи("мвмУзлыКарты", Узел["ид"]);   // ПолучитьОбъект() на каждый
	ЭлементСправочника.Наименование = Узел["имя"];
	ЭлементСправочника.X = ЧислоИлиНоль(Узел["x"]);
	ЭлементСправочника.Y = ЧислоИлиНоль(Узел["y"]);
	ЭлементСправочника.Записать();                                          // 924 записи ради одной
КонецЦикла;
