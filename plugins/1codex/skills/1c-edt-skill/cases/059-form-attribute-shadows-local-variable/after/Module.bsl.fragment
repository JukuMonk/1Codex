# В генераторе формы (Python): реквизит формы против присваиваний в контекстных процедурах.
for имя in РЕКВИЗИТЫ_ФОРМЫ:
    if re.search(r'^\s*%s\s*=[^=]' % имя, контекстные_процедуры, re.M):
        sys.exit('ОШИБКА: реквизит формы «%s» присваивается как локальная переменная' % имя)
