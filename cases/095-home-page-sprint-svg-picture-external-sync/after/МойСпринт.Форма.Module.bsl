
// «Мой спринт» — начальная страница исполнителя: задачи спринта тремя колонками, неделя по дням, работа вне плана,
// запись часов и завершение стадии (формой ЗаписьЧасов). Данные — Спринт.ПланЗадач и Учет времени за период спринта.

&НаКлиенте
Перем ТекущаяТаблица;

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Исполнитель = ТекущийИсполнитель();
	Спринт = СпринтНаДату(ТекущаяДатаСеанса());
	Элементы.КартинкаСпринта.РазмерКартинки = РазмерКартинки.Пропорционально;
	Элементы.ВнеПлана.Видимость = Ложь;
	НастроитьОформление();
	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ТекущаяТаблица = "ВРаботе";
	ПодключитьОбработчикОжидания("ОбновитьПоТаймеру", 600);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// оповещение формы элемента «Учет времени» при закрытии — часы записаны не со страницы
	Если ИмяСобытия = "УчетВремени" Тогда
		ЗаполнитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВсяКомандаПриИзменении(Элемент)

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СсылкаВнеПланаНажатие(Элемент)

	Элементы.ВнеПлана.Видимость = Не Элементы.ВнеПлана.Видимость;

КонецПроцедуры

#КонецОбласти

#Область СобытияТаблиц

&НаКлиенте
Процедура НеНачатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьЗадачуСтроки(НеНачаты.НайтиПоИдентификатору(ВыбраннаяСтрока));

КонецПроцедуры

&НаКлиенте
Процедура ВРаботеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьЗадачуСтроки(ВРаботе.НайтиПоИдентификатору(ВыбраннаяСтрока));

КонецПроцедуры

&НаКлиенте
Процедура ЗавершеныВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьЗадачуСтроки(Завершены.НайтиПоИдентификатору(ВыбраннаяСтрока));

КонецПроцедуры

&НаКлиенте
Процедура ВнеПланаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьЗадачуСтроки(ВнеПлана.НайтиПоИдентификатору(ВыбраннаяСтрока));

КонецПроцедуры

&НаКлиенте
Процедура НеНачатыПриАктивизацииСтроки(Элемент)

	ТекущаяТаблица = "НеНачаты";

КонецПроцедуры

&НаКлиенте
Процедура ВРаботеПриАктивизацииСтроки(Элемент)

	ТекущаяТаблица = "ВРаботе";

КонецПроцедуры

&НаКлиенте
Процедура ЗавершеныПриАктивизацииСтроки(Элемент)

	ТекущаяТаблица = "Завершены";

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ЗаписатьЧасы(Команда)

	ОткрытьЗапись(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)

	ОткрытьЗапись(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗадачу(Команда)

	ОткрытьЗадачуСтроки(ТекущаяСтрока());

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВБ24(Команда)

	Строка = ТекущаяСтрока();
	Если Строка = Неопределено Или Не ЗначениеЗаполнено(Строка.Задача) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите задачу в одной из колонок.'"));
		Возврат;
	КонецЕсли;
	ПерейтиПоНавигационнойСсылке(АдресВБ24(Строка.Задача));

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПредыдущийСпринт(Команда)

	ПерейтиКСпринту(-1);

КонецПроцедуры

&НаКлиенте
Процедура СледующийСпринт(Команда)

	ПерейтиКСпринту(1);

КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаКлиенте
Процедура ОбновитьПоТаймеру()

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Функция ТекущаяСтрока()

	Если ТекущаяТаблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Идентификатор = Элементы[ТекущаяТаблица].ТекущаяСтрока;
	Если Идентификатор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЭтаФорма[ТекущаяТаблица].НайтиПоИдентификатору(Идентификатор);

КонецФункции

&НаКлиенте
Процедура ОткрытьЗадачуСтроки(Строка)

	Если Строка = Неопределено Или Не ЗначениеЗаполнено(Строка.Задача) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите задачу в одной из колонок.'"));
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, Строка.Задача);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗапись(СтадияЗавершена)

	Строка = ТекущаяСтрока();
	Если Строка = Неопределено Или Не ЗначениеЗаполнено(Строка.Задача) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите задачу в одной из колонок.'"));
		Возврат;
	КонецЕсли;
	ПараметрыЗаписи = Новый Структура("Задача, Стадия, Исполнитель, Завершить",
		Строка.Задача, Строка.Стадия, Строка.Исполнитель, СтадияЗавершена);
	ОткрытьФорму("Обработка.МойСпринт.Форма.ЗаписьЧасов", ПараметрыЗаписи, ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ПослеЗаписиЧасов", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиЧасов(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Истина Тогда
		ЗаполнитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПерейтиКСпринту(Шаг)

	Соседний = СоседнийСпринт(Спринт, Шаг);
	Если ЗначениеЗаполнено(Соседний) Тогда
		Спринт = Соседний;
		ЗаполнитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийИсполнитель()

	// как в форме элемента «Учет времени»: сотрудник Битрикс24 по полному имени пользователя базы
	ПолноеИмя = ПользователиИнформационнойБазы.ТекущийПользователь().ПолноеИмя;
	Возврат Справочники.ПользователиБитрикс.НайтиПоРеквизиту("ИмяПользователяБД", ПолноеИмя);

КонецФункции

&НаСервереБезКонтекста
Функция СпринтНаДату(Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Спринты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Спринт КАК Спринты
		|ГДЕ
		|	НЕ Спринты.ПометкаУдаления
		|	И Спринты.ДатаНачала <= &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	Спринты.ДатаНачала УБЫВ";
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Спринт.ПустаяСсылка());

КонецФункции

&НаСервереБезКонтекста
Функция СоседнийСпринт(Спринт, Шаг)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Спринты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Спринт КАК Спринты
		|ГДЕ
		|	НЕ Спринты.ПометкаУдаления
		|	И Спринты.ДатаНачала > &ДатаНачала
		|
		|УПОРЯДОЧИТЬ ПО
		|	Спринты.ДатаНачала";
	Если Шаг < 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Спринты.ДатаНачала > &ДатаНачала", "Спринты.ДатаНачала < &ДатаНачала");
		Запрос.Текст = Запрос.Текст + " УБЫВ";
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаНачала", Спринт.ДатаНачала);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

&НаСервереБезКонтекста
Функция АдресВБ24(Задача)

	// задача в группе проекта: код проекта = ID группы Битрикс24, код задачи = ID задачи (ОбменБ24)
	Возврат "https://fregat-vc.bitrix24.ru/workgroups/group/" + Формат(Задача.Проект.Код, "ЧГ=0")
		+ "/tasks/task/view/" + Формат(Задача.Код, "ЧГ=0") + "/";

КонецФункции

&НаСервере
Процедура НастроитьОформление()

	ЦветПросрочки = Новый Цвет(163, 45, 45);
	ЦветПревышения = Новый Цвет(133, 79, 11);
	Для Каждого Имя Из СтрРазделить("НеНачаты,ВРаботе,Завершены", ",") Цикл
		ДобавитьОформление(Имя + ".СверхПлана", Имя + "Отметка", ЦветПревышения);
		ДобавитьОформление(Имя + ".Просрочена", Имя + "Отметка", ЦветПросрочки);
		ДобавитьОформление(Имя + ".Просрочена", Имя + "Задача", ЦветПросрочки);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформление(ПутьФлага, ИмяПоля, Цвет)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Цвет);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьФлага);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);

КонецПроцедуры

#КонецОбласти

#Область Заполнение

&НаСервере
Процедура ЗаполнитьНаСервере()

	Для Каждого Имя Из СтрРазделить("НеНачаты,ВРаботе,Завершены,ВнеПлана", ",") Цикл
		ЭтаФорма[Имя].Очистить();
		Элементы[Имя + "Исполнитель"].Видимость = ВсяКоманда;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Спринт) Тогда
		Элементы.Заголовок.Заголовок = НСтр("ru = 'Мой спринт — спринтов пока нет'");
		Элементы.Итог.Заголовок = "";
		Возврат;
	КонецЕсли;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Начало = НачалоДня(Спринт.ДатаНачала);
	Окончание = КонецДня(Спринт.ДатаОкончания);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Задача КАК Задача,
		|	П.Исполнитель КАК Исполнитель,
		|	П.Стадия КАК Стадия,
		|	МАКСИМУМ(П.Проект) КАК Проект,
		|	СУММА(П.ЧасыПлан) КАК ЧасыПлан,
		|	МИНИМУМ(П.Приоритет) КАК Приоритет,
		|	МАКСИМУМ(П.СдачаЗаказчику) КАК СдачаЗаказчику
		|ПОМЕСТИТЬ План
		|ИЗ
		|	Справочник.Спринт.ПланЗадач КАК П
		|ГДЕ
		|	П.Ссылка = &Спринт
		|	И (&ВсяКоманда
		|			ИЛИ П.Исполнитель = &Исполнитель)
		|
		|СГРУППИРОВАТЬ ПО
		|	П.Задача,
		|	П.Исполнитель,
		|	П.Стадия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	У.Задача КАК Задача,
		|	У.Исполнитель КАК Исполнитель,
		|	У.Часов КАК Часов,
		|	НАЧАЛОПЕРИОДА(У.ДатаСоздания, ДЕНЬ) КАК ДатаДня
		|ПОМЕСТИТЬ Записи
		|ИЗ
		|	Справочник.УчетВремени КАК У
		|ГДЕ
		|	У.ДатаСоздания МЕЖДУ &Начало И &Окончание
		|	И НЕ У.ПометкаУдаления
		|	И (&ВсяКоманда
		|			ИЛИ У.Исполнитель = &Исполнитель)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	План.Задача КАК Задача,
		|	План.Исполнитель КАК Исполнитель,
		|	План.Стадия КАК Стадия,
		|	План.Проект КАК Проект,
		|	План.ЧасыПлан КАК ЧасыПлан,
		|	План.Приоритет КАК Приоритет,
		|	План.СдачаЗаказчику КАК СдачаЗаказчику,
		|	ЕСТЬNULL(Факт.Часов, 0) КАК ЧасыФакт,
		|	План.Задача.ДатаЗавершенияПлан КАК Срок,
		|	План.Задача.ДатаЗавершенияФакт КАК ДатаЗакрытия,
		|	ВЫБОР
		|		КОГДА Отметки.Задача ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК СтадияЗавершена
		|ИЗ
		|	План КАК План
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Записи.Задача КАК Задача,
		|			Записи.Исполнитель КАК Исполнитель,
		|			СУММА(Записи.Часов) КАК Часов
		|		ИЗ
		|			Записи КАК Записи
		|		СГРУППИРОВАТЬ ПО
		|			Записи.Задача,
		|			Записи.Исполнитель) КАК Факт
		|		ПО (Факт.Задача = План.Задача)
		|			И (Факт.Исполнитель = План.Исполнитель)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			О.Задача КАК Задача,
		|			О.Стадия КАК Стадия
		|		ИЗ
		|			Справочник.УчетВремени КАК О
		|		ГДЕ
		|			О.Завершено
		|			И НЕ О.ПометкаУдаления
		|			И О.Задача В
		|				(ВЫБРАТЬ
		|					ПланЗадачи.Задача
		|				ИЗ
		|					План КАК ПланЗадачи)) КАК Отметки
		|		ПО (Отметки.Задача = План.Задача)
		|			И (Отметки.Стадия = План.Стадия)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет,
		|	Срок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Записи.ДатаДня КАК ДатаДня,
		|	СУММА(Записи.Часов) КАК Часов
		|ИЗ
		|	Записи КАК Записи
		|
		|СГРУППИРОВАТЬ ПО
		|	Записи.ДатаДня
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Записи.Задача КАК Задача,
		|	Записи.Исполнитель КАК Исполнитель,
		|	СУММА(Записи.Часов) КАК Часов
		|ИЗ
		|	Записи КАК Записи
		|		ЛЕВОЕ СОЕДИНЕНИЕ План КАК План
		|		ПО (План.Задача = Записи.Задача)
		|			И (План.Исполнитель = Записи.Исполнитель)
		|ГДЕ
		|	План.Задача ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	Записи.Задача,
		|	Записи.Исполнитель
		|
		|УПОРЯДОЧИТЬ ПО
		|	Часов УБЫВ";
	Запрос.УстановитьПараметр("Спринт", Спринт);
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("ВсяКоманда", ВсяКоманда);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Результаты = Запрос.ВыполнитьПакет();

	ПланВсего = 0;
	ФактПоПлану = 0;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Закрыта = ЗначениеЗаполнено(Выборка.ДатаЗакрытия);
		Если Выборка.СтадияЗавершена Или Закрыта Тогда
			Строка = Завершены.Добавить();
		ИначеЕсли Выборка.ЧасыФакт > 0 Тогда
			Строка = ВРаботе.Добавить();
		Иначе
			Строка = НеНачаты.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Закрыта = Закрыта;
		Строка.Часы = ЧислоЧасов(Выборка.ЧасыФакт) + " из " + ЧислоЧасов(Выборка.ЧасыПлан) + " ч";
		Строка.Просрочена = ЗначениеЗаполнено(Выборка.Срок) И Выборка.Срок < Сегодня
			И Не (Закрыта Или Выборка.СтадияЗавершена);
		Строка.СверхПлана = Выборка.ЧасыПлан > 0 И Выборка.ЧасыФакт > Выборка.ЧасыПлан;
		Строка.Отметка = ОтметкаСтроки(Строка, Выборка);
		ПланВсего = ПланВсего + Выборка.ЧасыПлан;
		ФактПоПлану = ФактПоПлану + Выборка.ЧасыФакт;
	КонецЦикла;

	ЧасыПоДням = Новый Соответствие;
	ФактВсего = 0;
	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЧасыПоДням.Вставить(Выборка.ДатаДня, Выборка.Часов);
		ФактВсего = ФактВсего + Выборка.Часов;
	КонецЦикла;

	ВнеПланаЧасов = 0;
	Выборка = Результаты[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ВнеПлана.Добавить(), Выборка);
		ВнеПланаЧасов = ВнеПланаЧасов + Выборка.Часов;
	КонецЦикла;

	// рабочие дни спринта (пн–пт): «по графику» — доля плана к концу сегодняшнего дня
	Дни = Новый Массив;
	РабочихВсего = 0;
	РабочихПрошло = 0;
	НомерСегодня = 0;
	День = Начало;
	Пока День <= Окончание Цикл
		Рабочий = ДеньНедели(День) <= 5;
		Если Рабочий Тогда
			РабочихВсего = РабочихВсего + 1;
			Если День <= Сегодня Тогда
				РабочихПрошло = РабочихПрошло + 1;
			КонецЕсли;
			Если День = Сегодня Тогда
				НомерСегодня = РабочихВсего;
			КонецЕсли;
		КонецЕсли;
		Часов = ЧасыПоДням.Получить(День);
		Дни.Добавить(Новый Структура("Дата, Часов, Рабочий", День, ?(Часов = Неопределено, 0, Часов), Рабочий));
		День = День + 86400;
	КонецЦикла;
	ПоГрафику = ?(РабочихВсего = 0, 0, ПланВсего * РабочихПрошло / РабочихВсего);
	Норма = ?(РабочихВсего = 0 Или ПланВсего = 0, 8, ПланВсего / РабочихВсего);

	ЗаполнитьНадписи(Начало, Окончание, Сегодня, НомерСегодня, РабочихВсего, ПланВсего, ФактВсего, ФактПоПлану,
		ПоГрафику, ВнеПланаЧасов);
	СВГ = КартинкаСВГ(Дни, Сегодня, ПланВсего, ФактПоПлану, ПоГрафику, Норма);
	КартинкаСпринта = ПоместитьВоВременноеХранилище(Новый Картинка(ПолучитьДвоичныеДанныеИзСтроки(СВГ)),
		УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНадписи(Начало, Окончание, Сегодня, НомерСегодня, РабочихВсего, ПланВсего, ФактВсего, ФактПоПлану,
	ПоГрафику, ВнеПланаЧасов)

	Если Месяц(Начало) = Месяц(Окончание) Тогда
		Период = Формат(Начало, "ДФ=d") + "–" + Формат(Окончание, "ДФ='d MMMM'");
	Иначе
		Период = Формат(Начало, "ДФ='d MMMM'") + " – " + Формат(Окончание, "ДФ='d MMMM'");
	КонецЕсли;
	Если НомерСегодня > 0 Тогда
		Когда = Формат(Сегодня, "ДФ=dddd") + ", рабочий день " + НомерСегодня + " из " + РабочихВсего;
	ИначеЕсли Сегодня > Окончание Тогда
		Когда = НСтр("ru = 'спринт завершён'");
	ИначеЕсли Сегодня < Начало Тогда
		Когда = НСтр("ru = 'спринт ещё не начался'");
	Иначе
		Когда = НСтр("ru = 'выходной'");
	КонецЕсли;
	Элементы.Заголовок.Заголовок = ?(ВсяКоманда, НСтр("ru = 'Спринт команды'"), НСтр("ru = 'Мой спринт'"))
		+ " · " + Период + " · " + Когда;

	Если Не ВсяКоманда И Не ЗначениеЗаполнено(Исполнитель) Тогда
		Итог = НСтр("ru = 'Ваш пользователь не связан с сотрудником Битрикс24: заполните «Имя пользователя БД» в справочнике «Пользователи Битрикс».'");
	Иначе
		Итог = "Записано " + ЧислоЧасов(ФактВсего) + " ч, по задачам спринта " + ЧислоЧасов(ФактПоПлану) + " из "
			+ ЧислоЧасов(ПланВсего) + " ч по плану";
		Если Сегодня >= Начало И Сегодня <= Окончание И ПланВсего > 0 Тогда
			Разница = ФактПоПлану - ПоГрафику;
			Итог = Итог + " · по графику к концу дня " + ЧислоЧасов(ПоГрафику) + " ч · "
				+ ?(Разница < -0.5, "отставание " + ЧислоЧасов(-Разница) + " ч",
				?(Разница > 0.5, "опережение " + ЧислоЧасов(Разница) + " ч", "идёте по графику"));
		КонецЕсли;
	КонецЕсли;
	Элементы.Итог.Заголовок = Итог;

	Элементы.ЗаголовокНеНачаты.Заголовок = "Не начаты · " + НеНачаты.Количество();
	Элементы.ЗаголовокВРаботе.Заголовок = "В работе · " + ВРаботе.Количество();
	Элементы.ЗаголовокЗавершены.Заголовок = "Завершены · " + Завершены.Количество();
	Если ВнеПлана.Количество() = 0 Тогда
		Элементы.СсылкаВнеПлана.Заголовок = "";
		Элементы.ВнеПлана.Видимость = Ложь;
	Иначе
		Элементы.СсылкаВнеПлана.Заголовок = "Вне плана спринта: " + ЧислоЧасов(ВнеПланаЧасов) + " ч на "
			+ ВнеПлана.Количество() + " " + ?(ВнеПлана.Количество() = 1, "задачу", "задач(и)") + " — показать / скрыть";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтметкаСтроки(Строка, Выборка)

	Если Не ЗначениеЗаполнено(Выборка.Задача) Тогда
		Возврат НСтр("ru = 'без задачи'");
	ИначеЕсли Строка.Закрыта Тогда
		Возврат НСтр("ru = 'закрыта в Б24'");
	ИначеЕсли Выборка.СтадияЗавершена Тогда
		Возврат НСтр("ru = 'стадия завершена'");
	ИначеЕсли Строка.Просрочена Тогда
		Возврат "срок " + Формат(Выборка.Срок, "ДФ=dd.MM");
	ИначеЕсли Строка.СверхПлана Тогда
		Возврат НСтр("ru = 'сверх плана'");
	ИначеЕсли Выборка.СдачаЗаказчику Тогда
		Возврат НСтр("ru = 'сдача заказчику'");
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоЧасов(Часов)

	Возврат Формат(Часов, "ЧДЦ=1; ЧН=0; ЧГ=0");

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоSVG(Значение)

	// координаты SVG — с точкой: «12,5» картинку ломает
	Возврат Формат(Окр(Значение, 1), "ЧРД=.; ЧН=0; ЧГ=0");

КонецФункции

// Полоса прогресса (записано по задачам спринта / план, отметка «по графику») и дни спринта столбиками.
&НаСервереБезКонтекста
Функция КартинкаСВГ(Дни, Сегодня, ПланВсего, ФактПоПлану, ПоГрафику, Норма)

	Ширина = 1000;
	Части = Новый Массив;
	Части.Добавить("<svg xmlns=""http://www.w3.org/2000/svg"" width=""1000"" height=""124"" viewBox=""0 0 1000 124"">");
	Части.Добавить("<rect x=""0"" y=""4"" width=""1000"" height=""14"" rx=""7"" fill=""#E6F1FB""/>");
	Если ПланВсего > 0 Тогда
		Доля = Мин(1, ФактПоПлану / ПланВсего);
		Части.Добавить("<rect x=""0"" y=""4"" width=""" + ЧислоSVG(Ширина * Доля) + """ height=""14"" rx=""7"" fill=""#378ADD""/>");
		Если ПоГрафику > 0 Тогда
			Х = ЧислоSVG(Ширина * Мин(1, ПоГрафику / ПланВсего));
			Части.Добавить("<line x1=""" + Х + """ y1=""0"" x2=""" + Х + """ y2=""22"" stroke=""#854F0B"" stroke-width=""3""/>");
		КонецЕсли;
	КонецЕсли;
	ШиринаДня = Ширина / Макс(1, Дни.Количество());
	Для Индекс = 0 По Дни.ВГраница() Цикл
		День = Дни[Индекс];
		Х = ШиринаДня * Индекс;
		Центр = ЧислоSVG(Х + ШиринаДня / 2);
		Если День.Дата = Сегодня Тогда
			Части.Добавить("<rect x=""" + ЧислоSVG(Х + 4) + """ y=""30"" width=""" + ЧислоSVG(ШиринаДня - 8)
				+ """ height=""90"" rx=""8"" fill=""#E6F1FB""/>");
		КонецЕсли;
		ЦветПодписи = ?(День.Рабочий, "#5F5E5A", "#B4B2A9");
		Части.Добавить("<text x=""" + Центр + """ y=""54"" text-anchor=""middle"" font-family=""Arial"" font-size=""15"" fill="""
			+ ЦветПодписи + """>" + Формат(День.Дата, "ДФ='ddd dd.MM'") + "</text>");
		Части.Добавить("<text x=""" + Центр + """ y=""82"" text-anchor=""middle"" font-family=""Arial"" font-size=""20"" font-weight=""bold"" fill="""
			+ ?(День.Часов > 0, "#2C2C2A", "#B4B2A9") + """>" + ?(День.Часов > 0, ЧислоЧасов(День.Часов), "—") + "</text>");
		ШиринаПолосы = ШиринаДня - 32;
		Части.Добавить("<rect x=""" + ЧислоSVG(Х + 16) + """ y=""96"" width=""" + ЧислоSVG(ШиринаПолосы)
			+ """ height=""8"" rx=""4"" fill=""#F1EFE8""/>");
		Если День.Часов > 0 Тогда
			Если День.Дата = Сегодня Тогда
				Цвет = "#378ADD";
			ИначеЕсли Не День.Рабочий Тогда
				Цвет = "#888780";
			ИначеЕсли День.Часов >= Норма * 0.9 Тогда
				Цвет = "#1D9E75";
			Иначе
				Цвет = "#EF9F27";
			КонецЕсли;
			Части.Добавить("<rect x=""" + ЧислоSVG(Х + 16) + """ y=""96"" width="""
				+ ЧислоSVG(ШиринаПолосы * Мин(1, День.Часов / Норма)) + """ height=""8"" rx=""4"" fill=""" + Цвет + """/>");
		КонецЕсли;
	КонецЦикла;
	Части.Добавить("</svg>");
	Возврат СтрСоединить(Части, "");

КонецФункции

#КонецОбласти
