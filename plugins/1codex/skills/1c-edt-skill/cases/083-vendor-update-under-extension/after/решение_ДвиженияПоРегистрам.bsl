// поставщик переписал движения; вызов истории дат Деснол — после типовых движений
Процедура ДвиженияПоРегистрам(РежимПроведения, Отказ)
	
	СтруктураДанныхДляПроведения = ПодготовитьДанныеДляПроведения();
	
	ДвиженияПоРегистру_торо_ЗаявкиПоРемонтам(РежимПроведения, Отказ);
	ДвиженияПоРегистру_торо_ПлановыеМатериальныеЗатратыРемонтныхРабот(СтруктураДанныхДляПроведения.ВыборкаМатериальныеЗатраты, РежимПроведения, Отказ);
	ДвиженияПоРегистру_торо_ПлановыеТрудовыеЗатратыРемонтныхРабот(СтруктураДанныхДляПроведения.ВыборкаТрудовыеЗатраты, РежимПроведения, Отказ);
	ДвиженияПоРегистру_торо_ПлановыеЗатратыЗапчастей(СтруктураДанныхДляПроведения.ВыборкаЗапчасти, РежимПроведения, Отказ);
	ДвиженияПоРегистру_торо_ПроцентВыполненныхРабот(СтруктураДанныхДляПроведения.ВыборкаПроцентВыполненныхРабот, РежимПроведения, Отказ);
	ДвиженияПоРегистру_торо_ИсполнителиВЗаявкахПоРемонтам(СтруктураДанныхДляПроведения.ВыборкаИсполнители, РежимПроведения, Отказ);
	ДвиженияПоРегистру_торо_ВнешниеОснованияДляРабот(СтруктураДанныхДляПроведения.ВыборкаВнешниеОснования, РежимПроведения, Отказ);
	ДвиженияПоРегистру_торо_ГарантийностьРемонтов();
	ДвиженияПоРегистру_торо_ВсеДокументыПоРемонтам();
	// >> [Деснол] [Фоченков Е.В.] [19.09.2025] (перенесено на 3.0.25.3)
	ДвиженияПоРегистру_дс_ИсторияИзмененияДатРемонта(РежимПроведения, Отказ);
	// << [Деснол] [Фоченков Е.В.] [19.09.2025]
	
	торо_МТОСервер.ПоместитьРемонтыВРегистрДляПроверкиАктуальности(Ссылка);
	
	Если Не ДополнительныеСвойства.Свойство("НеОбновлятьСтатус") Тогда
		торо_МТОСервер.ОбработатьЗаявкуВРегистре_торо_СтатусыЗаказовПоРемонтам(РежимЗаписиДокумента.Проведение, Ссылка, РемонтыОборудования.ВыгрузитьКолонку("ID"));
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из РемонтыОборудования Цикл
		торо_МТОСервер.АктуализироватьФлагиЗапретаОбновленияСкладаИТЦМ(СтрокаТЧ.ID, РежимЗаписиДокумента.Проведение, Ссылка);
	КонецЦикла;
	
КонецПроцедуры
