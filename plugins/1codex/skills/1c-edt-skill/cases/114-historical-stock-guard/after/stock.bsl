// Проверка выполняется в транзакции записи движений под общей блокировкой регистра.
// Виртуальная таблица рассчитывает остаток после каждого регистратора, включая
// документы одной секунды. Верхняя граница не задана: будущие движения тоже учитываются.
Процедура ЗаблокироватьОстатки() Экспорт

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.учОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ЛокальныеМинусы() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| История.Период КАК Период,
	| История.Регистратор КАК Регистратор,
	| История.Склад КАК Склад,
	| История.Товар КАК Товар,
	| История.КоличествоНачальныйОстаток КАК НачальныйОстаток,
	| История.КоличествоКонечныйОстаток КАК КонечныйОстаток
	|ИЗ РегистрНакопления.учОстаткиТоваров.ОстаткиИОбороты(, , Регистратор, , ) КАК История
	|ГДЕ История.КоличествоКонечныйОстаток < 0
	|УПОРЯДОЧИТЬ ПО Период, Регистратор";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ПроверитьОстатки(Отказ) Экспорт

	Нарушения = ЛокальныеМинусы();
	Если Нарушения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Для Каждого Нарушение Из Нарушения Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			"Операция отменена: локальный минус. Товар: %1; склад: %2; после документа %3 от %4 остаток %5. Исправьте последовательность движений.",
			Нарушение.Товар, Нарушение.Склад, Нарушение.Регистратор,
			Формат(Нарушение.Период, "ДФ=dd.MM.yyyy HH:mm:ss"), Нарушение.КонечныйОстаток);
		Сообщение.Сообщить();
		// Первого нарушения достаточно для отказа; не перегружать интерфейс длинной историей.
		Прервать;
	КонецЦикла;

КонецПроцедуры
