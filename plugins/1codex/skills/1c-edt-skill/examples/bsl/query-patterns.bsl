// Запросы: формат типовой конфигурации и ловушки, которые компилятор не
// видит (текст запроса — строка, компилируется при ВЫПОЛНЕНИИ).
//
//   case 015  кавычка в тексте запроса только удвоенная; лучше не сравнивать со строкой
//   case 016  псевдоним/имя поля не должен быть ключевым словом (По, В, Из, Где…)
//   case 017  иерархический справочник — И НЕ X.ЭтоГруппа; у плоского поля ЭтоГруппа НЕТ
//   case 031  агрегат по строке неограниченной длины — только через ВЫРАЗИТЬ(... КАК СТРОКА(N))
//   case 042  индексы Результаты[N] держать поимённо
//   case 046  выбрасывая запрос из пакета, считать разделители «;»

&НаСервере
Функция ЭлементыСОстатками(Владелец, Сейчас)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.Наименование КАК Наименование,
		|	Элементы.Радиус КАК Радиус,
		|	ВЫРАЗИТЬ(Элементы.Комментарий КАК СТРОКА(150)) КАК Комментарий
		|ПОМЕСТИТЬ Элементы
		|ИЗ
		|	Справочник.ПримерСправочник КАК Элементы
		|ГДЕ
		|	НЕ Элементы.ПометкаУдаления
		|	И Элементы.Владелец = &Владелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.Наименование КАК Наименование,
		|	Элементы.Радиус КАК Радиус,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток,
		|	МАКСИМУМ(ВЫРАЗИТЬ(Элементы.Комментарий КАК СТРОКА(150))) КАК Комментарий
		|ИЗ
		|	Элементы КАК Элементы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПримерОстатки.Остатки(&Сейчас, ) КАК Остатки
		|		ПО Элементы.Ссылка = Остатки.Объект
		|
		|СГРУППИРОВАТЬ ПО
		|	Элементы.Ссылка,
		|	Элементы.Наименование,
		|	Элементы.Радиус,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование");
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Сейчас", Сейчас);

	// Индексы результатов пакета — поимённо (case 042).
	ВременнаяТаблица = 0;
	ИтогЗапрос = 1;
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Результаты[ИтогЗапрос].Выгрузить();

КонецФункции

// Иерархический справочник: реквизиты у ГРУППЫ — NULL, и Число(NULL)
// падает в бою. Отсекаем группы и подстраховываем преобразование.
&НаСервере
Функция ТипыСГрузоподъемностью()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Типы.Ссылка КАК Ссылка,
		|	Типы.Грузоподъемность КАК Грузоподъемность
		|ИЗ
		|	Справочник.ПримерИерархическийСправочник КАК Типы
		|ГДЕ
		|	НЕ Типы.ПометкаУдаления
		|	И НЕ Типы.ЭтоГруппа");
	Список = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Новый Структура("Ссылка, Грузоподъемность",
			Выборка.Ссылка, ЧислоИлиНоль(Выборка.Грузоподъемность)));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Табличную часть через ссылку не прочитать (Ссылка.Строки не работает) —
// только запросом к Документ.X.ИмяТЧ или через ПолучитьОбъект().
&НаСервере
Функция СтрокиДокумента(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Строки.НомерСтроки КАК НомерСтроки,
		|	Строки.Объект КАК Объект,
		|	Строки.Количество КАК Количество
		|ИЗ
		|	Документ.ПримерДокумент.Строки КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &Документ
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки");
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Пустые строки отсеиваем в коде, а не условием «<> """"» в запросе (case 015).
&НаСервере
Функция НепустыеКомментарии(Таблица)

	Итог = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если ПустаяСтрока(Строка.Комментарий) Тогда
			Продолжить;
		КонецЕсли;
		Итог.Добавить(Строка.Комментарий);
	КонецЦикла;
	Возврат Итог;

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИлиНоль(Значение)

	Если Значение = Неопределено ИЛИ Значение = NULL ИЛИ Значение = "" Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции
